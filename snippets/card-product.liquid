{%- liquid
  assign ratio = 1.2
  if settings.card_image_ratio
    assign ratio = settings.card_image_ratio
  endif
-%}

<div class="card-wrapper product-card-wrapper">
  <div class="card card--{{ settings.card_style }} color-background-1">
    <div class="card__inner">
      <div class="card__media" style="padding-top: {{ 1 | divided_by: ratio | times: 100 }}%;">
        {%- if card_product.featured_media -%}
          <a href="{{ card_product.url }}" tabindex="-1" aria-label="{{ card_product.title | escape }}">
            <img
              src="{{ card_product.featured_media | image_url: width: 600 }}"
              alt="{{ card_product.featured_media.alt | escape }}"
              class="card__image motion-reduce"
              width="600"
              height="{{ 600 | divided_by: card_product.featured_media.aspect_ratio | ceil }}"
              loading="lazy"
            >
          </a>
          {%- if card_product.media[1] != blank -%}
            <img
              src="{{ card_product.media[1] | image_url: width: 600 }}"
              alt="{{ card_product.media[1].alt | escape }}"
              class="card__image card__image--secondary motion-reduce"
              width="600"
              height="{{ 600 | divided_by: card_product.media[1].aspect_ratio | ceil }}"
              loading="lazy"
            >
          {%- endif -%}
        {%- else -%}
          <a href="{% unless card_product == blank %}{{ card_product.url }}{% endunless %}" tabindex="-1">
            {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
          </a>
        {%- endif -%}

        <!-- Quick action overlay -->
        <div class="card__overlay">
          {%- if card_product != blank -%}
            <a href="{{ card_product.url }}" class="card__overlay-link button button--primary">
              Voir le produit
            </a>
          {%- endif -%}
        </div>

        <!-- Badges -->
        <div class="card__badges">
          {%- if card_product.available == false -%}
            <span class="badge badge--sold-out">Épuisé</span>
          {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
            <span class="badge badge--sale">Promo</span>
          {%- endif -%}
          {%- if card_product.tags contains 'nouveau' or card_product.tags contains 'new' -%}
            <span class="badge badge--new">Nouveau</span>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="card__content">
      <div class="card__information">
        {%- if card_product.vendor != blank -%}
          <p class="card__vendor visually-hidden">{{ card_product.vendor }}</p>
        {%- endif -%}

        <h3 class="card__heading">
          <a href="{% unless card_product == blank %}{{ card_product.url }}{% endunless %}" class="full-unstyled-link">
            {{ card_product.title | default: 'Titre du produit' | escape }}
          </a>
        </h3>

        <div class="card__price">
          {%- render 'price', product: card_product -%}
        </div>
      </div>
    </div>
  </div>
</div>
