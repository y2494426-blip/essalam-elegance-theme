{% comment %} ESSALEM — Floating Back Button {% endcomment %}
<button
  class="lux-back-btn"
  id="lux-back-btn"
  aria-label="Retour"
  onclick="history.length > 1 ? history.back() : (window.location.href = '{{ routes.root_url }}')"
>
  <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M13 7H1M1 7L6 2M1 7L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span>Back</span>
</button>
