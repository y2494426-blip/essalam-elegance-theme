<button
  class="lux-back-btn"
  id="lux-back-btn"
  aria-label="Retour"
  onclick="history.length > 1 ? history.back() : (window.location.href = '{{ routes.root_url }}')"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8 2L3 7l5 5"/>
  </svg>
  <span>Retour</span>
</button>