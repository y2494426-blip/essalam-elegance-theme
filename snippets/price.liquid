{%- liquid
  assign target = product
  if variant
    assign target = variant
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign available = target.available | default: false
  assign money_price = price | money
  assign money_compare_at_price = compare_at_price | money
-%}

<div class="price{% if compare_at_price > price %} price--on-sale{% endif %}{% unless available %} price--sold-out{% endunless %}">
  <div class="price__container">
    <span class="price-item price-item--regular">
      {%- if compare_at_price > price -%}
        <span class="visually-hidden">Prix soldé</span>
        {{ money_price }}
      {%- else -%}
        {{ money_price }}
      {%- endif -%}
    </span>

    {%- if compare_at_price > price -%}
      <span class="price-item price-item--regular price-item--compare">
        <span class="visually-hidden">Prix original</span>
        <s>{{ money_compare_at_price }}</s>
      </span>
    {%- endif -%}
  </div>
</div>
