<!-- SOCIAL PROOF TOAST -->
<div class="nl-toast" id="nl-toast">
  <span class="nl-toast-icon">🛒</span>
  <div class="nl-toast-text">
    <span class="nl-toast-name" id="nl-toast-name"></span>
    <span id="nl-toast-msg"></span>
  </div>
</div>

<script>
  var nlVariants = {{ product.variants | json }};
  var nlOpts = {{ product.options | json }};
  var nlSelected = {};

  // init selected from current variant
  {%- for i in (1..3) -%}
    nlSelected[{{ i }}] = "{{ current_variant['option' | append: i] }}";
  {%- endfor -%}

  function nlSelectOpt(btn) {
    var opt = parseInt(btn.getAttribute('data-opt'));
    var val = btn.getAttribute('data-val');
    nlSelected[opt] = val;

    // update button styles
    btn.closest('.nl-variant-opts').querySelectorAll('.nl-opt-btn').forEach(function(b){
      b.classList.toggle('selected', b === btn);
    });

    nlMatchVariant();
  }

  function nlMatchVariant() {
    var match = nlVariants.find(function(v) {
      return nlOpts.every(function(_, i) {
        return v['option' + (i+1)] === nlSelected[i+1];
      });
    });
    if (!match) return;

    document.getElementById('nl-variant-id').value = match.id;

    var price = Math.round(match.price / 100);
    var priceStr = price + ' ر.س';
    var el = document.getElementById('nl-price-now');
    if (el) el.textContent = priceStr;
    var el2 = document.getElementById('nl-order-price');
    if (el2) el2.textContent = priceStr;
    var el3 = document.getElementById('nl-spec-price');
    if (el3) el3.textContent = priceStr;
    var el4 = document.getElementById('nl-sticky-price');
    if (el4) el4.textContent = priceStr;

    // update main image if variant has image
    if (match.featured_image) {
      var img = document.getElementById('nl-main-img');
      if (img) img.src = match.featured_image.src;
    }
  }

  // Thumbnail gallery
  function nlSetImg(thumb) {
    document.querySelectorAll('.nl-thumb').forEach(function(t){ t.classList.remove('active'); });
    thumb.classList.add('active');
    var img = document.getElementById('nl-main-img');
    if (img) img.src = thumb.getAttribute('data-src');
  }

  // Sticky footer
  var nlSticky = document.getElementById('nl-sticky');
  var nlOrderSection = document.getElementById('nl-order');
  if (nlSticky && nlOrderSection && 'IntersectionObserver' in window) {
    var nlObs = new IntersectionObserver(function(entries) {
      nlSticky.style.display = entries[0].isIntersecting ? 'none' : 'flex';
    }, { threshold: 0.1 });
    nlObs.observe(nlOrderSection);
    nlSticky.style.display = 'flex';
  }

  // Social proof toasts
  var nlToasts = [
    ['ر.العتيبي', 'طلبت للتو من الرياض ✨'],
    ['أ.الشمري', 'طلب للتو من جدة 🎨'],
    ['ف.السهلي', 'طلبت للتو من الدمام 💫'],
    ['خ.المطيري', 'طلب للتو من مكة المكرمة'],
    ['س.الغامدي', 'طلبت للتو من المدينة المنورة'],
    ['ع.الدوسري', 'طلب للتو من الطائف 🌟'],
    ['ن.الزهراني', 'طلبت للتو من أبها ✨'],
    ['م.القحطاني', 'طلب للتو من تبوك'],
  ];
  var nlToastEl = document.getElementById('nl-toast');
  var nlToastName = document.getElementById('nl-toast-name');
  var nlToastMsg = document.getElementById('nl-toast-msg');
  var nlToastIdx = 0;

  function nlShowToast() {
    var entry = nlToasts[nlToastIdx % nlToasts.length];
    nlToastIdx++;
    if (nlToastName) nlToastName.textContent = entry[0] + ' ';
    if (nlToastMsg) nlToastMsg.textContent = entry[1];
    if (nlToastEl) {
      nlToastEl.classList.add('show');
      setTimeout(function(){ nlToastEl.classList.remove('show'); }, 3500);
    }
    setTimeout(nlShowToast, Math.random() * 8000 + 6000);
  }
  setTimeout(nlShowToast, 4000);
</script>

