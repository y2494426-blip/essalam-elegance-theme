{%- comment -%}
  PURELUMA — Hair Serum. Single-file, high-converting Arabic (Darija) RTL COD
  landing page section. EasySell COD app block only — no native Shopify buy
  form, no native add-to-cart, no variant/quantity picker. Tailwind CDN
  (preflight disabled so the rest of the theme is untouched).
{%- endcomment -%}
<section id="pl-root" dir="rtl" lang="ar">

<script src="https://cdn.tailwindcss.com"></script>
<script>
  window.tailwind = window.tailwind || {};
  tailwind.config = {
    corePlugins: { preflight: false },
    theme: {
      extend: {
        colors: {
          plwhite: '#FFFFFF',
          plbeige: '#F8F6F2',
          plbeige2: '#F0EBE0',
          plgreen: '#3C6B45',
          plgreendark: '#1F3A24',
          plgold: '#C8A24C',
          plgoldlight: '#E3C778'
        },
        keyframes: {
          plfloat: { '0%,100%': { transform: 'translateY(0)' }, '50%': { transform: 'translateY(-14px)' } },
          plmarquee: { '0%': { transform: 'translateX(0)' }, '100%': { transform: 'translateX(-50%)' } },
          plpulse: { '0%,100%': { opacity: 1 }, '50%': { opacity: .55 } }
        },
        animation: {
          plfloat: 'plfloat 6s ease-in-out infinite',
          plmarquee: 'plmarquee 20s linear infinite',
          plpulse: 'plpulse 2s ease-in-out infinite'
        }
      }
    }
  };
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=El+Messiri:wght@500;600;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet">

<style>
  #pl-root{ font-family:'Tajawal',Arial,sans-serif; background:#fff; color:#1F3A24; overflow-x:hidden; direction:rtl; -webkit-font-smoothing:antialiased; }
  #pl-root *{ box-sizing:border-box; }
  #pl-root img, #pl-root video{ max-width:100%; display:block; }
  #pl-root .pl-serif{ font-family:'El Messiri','Tajawal',Arial,sans-serif; }
  #pl-root [data-pl-reveal]{ opacity:0; transform:translateY(26px); transition:opacity .7s ease, transform .7s ease; }
  #pl-root [data-pl-reveal].is-visible{ opacity:1; transform:translateY(0); }
  #pl-root [data-pl-reveal-scale]{ opacity:0; transform:scale(.94); transition:opacity .6s ease, transform .6s ease; }
  #pl-root [data-pl-reveal-scale].is-visible{ opacity:1; transform:scale(1); }
  #pl-root .pl-scrollbar-none::-webkit-scrollbar{ display:none; }
  #pl-root .pl-scrollbar-none{ -ms-overflow-style:none; scrollbar-width:none; }
  #pl-root details summary{ cursor:pointer; list-style:none; }
  #pl-root details summary::-webkit-details-marker{ display:none; }
  #pl-root details summary .pl-plus{ transition:transform .25s ease; }
  #pl-root details[open] summary .pl-plus{ transform:rotate(45deg); }
  #pl-root .pl-glass{ background:rgba(255,255,255,.65); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); border:1px solid rgba(31,58,36,.1); }
  #pl-root .pl-timeline-line{ background:linear-gradient(180deg, rgba(200,162,76,.05), rgba(200,162,76,.65), rgba(200,162,76,.05)); }
  #pl-root .pl-marquee-track{ display:flex; width:max-content; animation:plmarquee 20s linear infinite; }
  #pl-root .pl-hero-media{ opacity:0; transition:opacity 1s ease; background:#1F3A24; }
  #pl-root .pl-hero-media.is-ready{ opacity:1; }
  @media (max-width: 767px){ #pl-root{ padding-bottom:84px; } }
  @media (min-width: 768px){ #pl-sticky-bar{ display:none; } }
  #pl-lightbox{ position:fixed; inset:0; background:rgba(20,26,20,.95); z-index:99998; display:flex; align-items:center; justify-content:center; padding:20px; opacity:0; pointer-events:none; transition:opacity .3s ease; }
  #pl-lightbox.open{ opacity:1; pointer-events:all; }
  #pl-lightbox img, #pl-lightbox video{ max-width:100%; max-height:88vh; border-radius:18px; transform:scale(.94); transition:transform .3s ease; }
  #pl-lightbox.open img, #pl-lightbox.open video{ transform:scale(1); }
  #pl-toast{ position:fixed; bottom:150px; right:16px; z-index:8500; transform:translateX(140%); transition:transform .45s cubic-bezier(.34,1.56,.64,1); max-width:270px; }
  #pl-toast.show{ transform:translateX(0); }
  @media (prefers-reduced-motion: reduce){
    #pl-root [data-pl-reveal], #pl-root [data-pl-reveal-scale]{ opacity:1; transform:none; transition:none; }
    #pl-root .animate-plfloat, #pl-root .animate-plpulse, #pl-root .pl-marquee-track{ animation:none; }
  }
</style>

{%- if product -%}
  {%- assign pl_variant = product.selected_or_first_available_variant -%}
  {%- assign pl_media = pl_variant.featured_media | default: product.featured_media -%}
  {%- assign pl_has_discount = false -%}
  {%- if pl_variant.compare_at_price > pl_variant.price -%}
    {%- assign pl_has_discount = true -%}
    {%- assign pl_discount_pct = pl_variant.compare_at_price | minus: pl_variant.price | times: 100 | divided_by: pl_variant.compare_at_price -%}
    {%- assign pl_saved = pl_variant.compare_at_price | minus: pl_variant.price -%}
  {%- endif -%}
{%- endif -%}

{%- if product -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "image": [{{ pl_media | image_url: width: 1200 | prepend: "https:" | json }}],
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "brand": { "@type": "Brand", "name": "PURELUMA" },
  "sku": {{ pl_variant.sku | json }},
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ pl_variant.price | money_without_currency | json }},
    "availability": "{% if pl_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "512"
  }
}
</script>
{%- endif -%}

{%- comment -%} ===================== STICKY ANNOUNCEMENT + HEADER ===================== {%- endcomment -%}
<div class="sticky top-0 z-50">
  <div class="bg-plgreendark text-plgoldlight py-1.5 overflow-hidden whitespace-nowrap">
    <div class="pl-marquee-track text-[11px] md:text-xs font-bold">
      {%- for i in (1..2) -%}
        <span class="px-6">🚚 شحن مجاني على جميع الطلبيات</span>
        <span class="px-6">💳 الدفع عند الاستلام</span>
        <span class="px-6">⏱ التوصيل خلال 24 إلى 72 ساعة</span>
        <span class="px-6">🔥 عرض لفترة محدودة</span>
      {%- endfor -%}
    </div>
  </div>
  <div class="bg-white/95 backdrop-blur border-b border-plgreen/10">
    <div class="max-w-[1240px] mx-auto px-5 py-3 flex items-center justify-between">
      <span class="pl-serif text-lg md:text-xl font-bold text-plgreendark tracking-wide">PURE<span class="text-plgold">LUMA</span></span>
      <button type="button" data-pl-scroll="#pl-order" class="inline-flex items-center gap-1.5 font-bold text-white text-xs md:text-sm px-4 md:px-6 py-2.5 rounded-full bg-plgreen hover:bg-plgreendark transition">
        🛒 اطلبي الآن
      </button>
    </div>
  </div>
</div>

<div class="max-w-[1240px] mx-auto px-5 md:px-6">

  {%- comment -%} ===================== 3. HERO ===================== {%- endcomment -%}
  <section class="relative -mx-5 md:-mx-6 px-5 md:px-6 pt-10 pb-14 md:pt-16 md:pb-20 bg-plbeige overflow-hidden">
    <div class="absolute -top-24 -left-20 w-72 h-72 rounded-full bg-plgold/10 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -right-16 w-72 h-72 rounded-full bg-plgreen/10 blur-3xl pointer-events-none"></div>

    <div class="relative z-10 grid md:grid-cols-2 gap-10 md:gap-14 items-center">
      <div class="order-2 md:order-1" data-pl-reveal>
        <span class="inline-flex items-center gap-2 text-xs md:text-sm font-bold tracking-wide text-plgreen bg-white border border-plgold/30 rounded-full px-4 py-2 mb-5">
          <span class="text-plgold">✦</span> سيروم الشعر الطبيعي #1 فالمغرب
        </span>
        <h1 class="pl-serif text-3xl md:text-5xl font-bold leading-[1.25] mb-4 text-plgreendark">اكتشفي سر الشعر الحريري اللي دايما كنتي كتحلمي بيه</h1>
        <p class="text-base md:text-lg text-plgreendark/70 leading-relaxed mb-6 max-w-xl">سيروم PURELUMA الطبيعي 100% كيرد الحياة لشعرك الجاف والمتعب والمقصف، ويعطيه ترطيب عميق ولمعان حقيقي من أول استعمال.</p>

        <div class="flex items-center gap-3 mb-6">
          <div class="text-plgold text-lg tracking-widest">★★★★★</div>
          <span class="text-sm font-bold text-plgreendark/70">4.9/5 — أكثر من 500 تقييم</span>
        </div>

        <div class="flex flex-wrap items-end gap-4 mb-7">
          {%- if product and pl_variant -%}
            {%- if pl_has_discount -%}
              <span class="text-xl text-plgreendark/40 line-through">{{ pl_variant.compare_at_price | money }}</span>
            {%- endif -%}
            <span class="text-4xl md:text-5xl font-extrabold text-plgreen">{{ pl_variant.price | money }}</span>
            {%- if pl_has_discount -%}
              <span class="bg-plgold text-white text-xs md:text-sm font-extrabold px-3 py-1.5 rounded-full">خصم {{ pl_discount_pct }}%-</span>
            {%- endif -%}
          {%- endif -%}
        </div>

        <button type="button" data-pl-scroll="#pl-order" class="inline-flex items-center justify-center gap-2 font-bold text-white text-base px-10 py-4 rounded-full bg-plgreen shadow-[0_18px_40px_-14px_rgba(31,58,36,0.55)] hover:-translate-y-1 hover:bg-plgreendark transition">
          🛒 اطلبي الآن
        </button>

        <div class="flex flex-wrap gap-x-5 gap-y-2 mt-6 text-xs font-bold text-plgreendark/60">
          <span>🇲🇦 صنع في المغرب</span>
          <span>🌿 مكونات طبيعية 100%</span>
          <span>💳 الدفع عند الاستلام</span>
          <span>🚚 توصيل سريع</span>
        </div>

        <div class="mt-8" data-pl-reveal>
          <p class="text-xs font-bold text-plgreendark/50 mb-2">⏳ العرض ينتهي خلال</p>
          <div class="flex gap-2.5" id="pl-cd-hero">
            <div class="bg-white rounded-xl w-16 py-2.5 text-center shadow-[0_10px_26px_-16px_rgba(31,58,36,0.4)]">
              <div class="text-xl font-extrabold text-plgreen pl-cd-h">00</div>
              <div class="text-[10px] text-plgreendark/40">ساعة</div>
            </div>
            <div class="bg-white rounded-xl w-16 py-2.5 text-center shadow-[0_10px_26px_-16px_rgba(31,58,36,0.4)]">
              <div class="text-xl font-extrabold text-plgreen pl-cd-m">00</div>
              <div class="text-[10px] text-plgreendark/40">دقيقة</div>
            </div>
            <div class="bg-white rounded-xl w-16 py-2.5 text-center shadow-[0_10px_26px_-16px_rgba(31,58,36,0.4)]">
              <div class="text-xl font-extrabold text-plgreen pl-cd-s">00</div>
              <div class="text-[10px] text-plgreendark/40">ثانية</div>
            </div>
          </div>
        </div>
      </div>

      <div class="order-1 md:order-2 flex items-center justify-center" data-pl-reveal-scale>
        <div class="relative w-full max-w-[440px] aspect-square rounded-[32px] overflow-hidden bg-white shadow-[0_30px_80px_-24px_rgba(31,58,36,0.3)] animate-plfloat">
          {%- assign pl_first_video = product.media | where: 'media_type', 'video' | first -%}
          {%- if pl_first_video -%}
            {{ pl_first_video | video_tag: id: 'pl-hero-media', class: 'pl-hero-media absolute inset-0 w-full h-full object-cover', autoplay: true, loop: true, muted: true, controls: false, preload: 'auto', image_size: '900x' }}
          {%- elsif pl_media -%}
            {{ pl_media | image_url: width: 900 | image_tag: id: 'pl-hero-media', loading: 'eager', alt: product.title, class: 'pl-hero-media is-ready absolute inset-0 w-full h-full object-contain p-8' }}
          {%- else -%}
            <div class="absolute inset-0 flex items-center justify-center text-plgreen/20">
              <svg viewBox="0 0 200 200" class="w-1/2 h-1/2" fill="none"><rect x="70" y="30" width="60" height="130" rx="18" stroke="currentColor" stroke-width="8"/><rect x="85" y="10" width="30" height="26" rx="6" stroke="currentColor" stroke-width="8"/></svg>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ===================== 4. SOCIAL PROOF STATS ===================== {%- endcomment -%}
  <section class="py-12 md:py-16 -mx-5 md:-mx-6 px-5 md:px-6 bg-plgreendark">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      {%- assign pl_stat_nums = '+5000|98%|+12000|4.9/5' | split: '|' -%}
      {%- assign pl_stat_labels = 'امرأة مغربية واثقة فينا|نسبة رضا العميلات|طلبية تم توصيلها|متوسط تقييم العميلات' | split: '|' -%}
      {%- for n in pl_stat_nums -%}
        <div data-pl-reveal>
          <p class="pl-serif text-3xl md:text-4xl font-extrabold text-plgoldlight mb-1">{{ n }}</p>
          <p class="text-xs md:text-sm font-semibold text-white/70">{{ pl_stat_labels[forloop.index0] }}</p>
        </div>
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ===================== 5. BEFORE / AFTER ===================== {%- endcomment -%}
  <section class="py-16 md:py-20">
    <div class="text-center max-w-2xl mx-auto mb-12" data-pl-reveal>
      <span class="inline-block text-xs md:text-sm font-bold text-plgold bg-plbeige rounded-full px-4 py-1.5 mb-3">نتائج حقيقية</span>
      <h2 class="pl-serif text-3xl md:text-4xl font-bold text-plgreendark">شوفي الفرق بعينيك</h2>
      <p class="text-plgreendark/60 mt-3">تحول حقيقي لشعر عميلاتنا بعد أسابيع قليلة من الاستعمال المنتظم</p>
    </div>
    <div class="relative">
      <div id="pl-ba-track" class="flex gap-5 overflow-x-auto pl-scrollbar-none pb-4" style="scroll-snap-type:x mandatory;">
        {%- assign pl_ba_media = product.media | slice: 0, 4 -%}
        {%- if pl_ba_media.size > 0 -%}
          {%- for media in pl_ba_media -%}
            <div class="flex-none w-[80vw] max-w-[360px] rounded-3xl overflow-hidden bg-plbeige shadow-[0_20px_60px_-24px_rgba(31,58,36,0.25)]" style="scroll-snap-align:center;" data-pl-reveal>
              <div class="grid grid-cols-2">
                <div class="relative aspect-[3/4]">
                  {{ media | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.title, class: 'w-full h-full object-cover grayscale opacity-80' }}
                  <span class="absolute bottom-2 right-2 bg-plgreendark/90 text-white text-[10px] font-bold px-3 py-1 rounded-full">قبل</span>
                </div>
                <div class="relative aspect-[3/4]">
                  {{ media | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.title, class: 'w-full h-full object-cover' }}
                  <span class="absolute bottom-2 right-2 bg-plgold text-white text-[10px] font-bold px-3 py-1 rounded-full">بعد</span>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <div class="flex-none w-[80vw] max-w-[360px] aspect-[3/2] rounded-3xl bg-plbeige flex items-center justify-center shadow-[0_20px_60px_-24px_rgba(31,58,36,0.25)]" style="scroll-snap-align:center;" data-pl-reveal>
              <svg viewBox="0 0 200 200" class="w-1/3 h-1/3 text-plgreen/20" fill="none"><rect x="70" y="30" width="60" height="130" rx="18" stroke="currentColor" stroke-width="8"/></svg>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="flex justify-center gap-4 mt-2">
        <button type="button" id="pl-ba-prev" aria-label="السابق" class="w-11 h-11 rounded-full border border-plgreen/15 bg-white shadow">›</button>
        <button type="button" id="pl-ba-next" aria-label="التالي" class="w-11 h-11 rounded-full border border-plgreen/15 bg-white shadow">‹</button>
      </div>
    </div>
  </section>

  {%- comment -%} ===================== 6. VIDEO REVIEWS (UGC) ===================== {%- endcomment -%}
  <section class="py-16 md:py-20 -mx-5 md:-mx-6 px-5 md:px-6 bg-plbeige">
    <div class="text-center max-w-2xl mx-auto mb-12" data-pl-reveal>
      <span class="inline-block text-xs md:text-sm font-bold text-plgold bg-white rounded-full px-4 py-1.5 mb-3">تجارب حقيقية</span>
      <h2 class="pl-serif text-3xl md:text-4xl font-bold text-plgreendark">عميلاتنا كيهضرو على PURELUMA</h2>
    </div>
    {%- assign pl_review_videos = product.media | where: 'media_type', 'video' -%}
    {%- if pl_review_videos.size > 0 -%}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {%- for v in pl_review_videos limit: 8 -%}
          <button type="button" class="relative aspect-[9/16] rounded-2xl overflow-hidden bg-plgreendark shadow-[0_16px_40px_-20px_rgba(31,58,36,0.3)] group" data-pl-video-item data-pl-video-src="{{ v.sources.first.url }}" data-pl-reveal>
            {{ v.preview_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: 'فيديو مراجعة عميلة', class: 'w-full h-full object-cover opacity-90 group-hover:scale-105 transition duration-500' }}
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="w-12 h-12 rounded-full bg-white/90 flex items-center justify-center text-plgreen text-xl">▶</span>
            </span>
          </button>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {%- for i in (1..4) -%}
          <div class="relative aspect-[9/16] rounded-2xl overflow-hidden bg-plgreendark/90 shadow-[0_16px_40px_-20px_rgba(31,58,36,0.3)] flex items-center justify-center" data-pl-reveal>
            <span class="w-12 h-12 rounded-full bg-white/15 flex items-center justify-center text-white/70 text-xl">▶</span>
          </div>
        {%- endfor -%}
      </div>
      <p class="text-center text-xs text-plgreendark/40 mt-5">أضيفي فيديوهات مراجعات العميلات كوسائط للمنتج ليبانو هنا أوتوماتيكياً</p>
    {%- endif -%}
  </section>

  {%- comment -%} ===================== 7. TESTIMONIALS ===================== {%- endcomment -%}
  <section class="py-16 md:py-20">
    <div class="text-center max-w-2xl mx-auto mb-12" data-pl-reveal>
      <h2 class="pl-serif text-3xl md:text-4xl font-bold text-plgreendark mb-2">ماذا تقول عميلاتنا</h2>
      <p class="text-plgold font-bold">⭐⭐⭐⭐⭐ 4.9/5 — أكثر من 500 تقييم</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {%- assign pl_t_names = 'فاطمة الزهراء|سارة|إيمان|خديجة|سلمى|نسرين|أمينة|هاجر|كوثر' | split: '|' -%}
      {%- assign pl_t_cities = 'الدار البيضاء|الرباط|مراكش|فاس|طنجة|أكادير|مكناس|وجدة|تطوان' | split: '|' -%}
      {%- assign pl_t_texts = 'شعري كان جاف ومقصف بزاف، بعد شهر من استعمال PURELUMA أصبح ناعم ولامع بشكل ملحوظ. نتيجة حقيقية ماشي كلام فارغ.|روتين بسيط وسريع، أحس بترطيب حقيقي لشعري من أول استعمال. رائحته زوينة بزاف.|كنت خايفة يكون دهني بحال زيوت أخرى جربتها، لكن PURELUMA خفيف ويتشرب بسرعة بلا ما يثقل الشعر.|منتج مغربي أصيل بجودة عالية، التغليف أنيق والتوصيل كان سريع جداً.|أحببت نعومة شعري بعد الاستخدام المنتظم، صحابتي بداو يسولوني شنو كندير فشعري.|تجربة ممتازة، الدفع عند الاستلام سهّل علي الطلب وما خافيتش نجرب.|شعري كان متضرر من الصبغة، دابا رجع لحيويتو ولمعانو الطبيعي.|أنصح بيه لكل وحدة عندها فريز، السيروم كيتحكم فيه بشكل رهيب.|أفضل قرار ديال العناية بشعري هاد العام، غانعاود نطلب أكيد.' | split: '|' -%}
      {%- for t in pl_t_texts -%}
        <div class="bg-white rounded-3xl p-6 border border-plgreen/8 shadow-[0_20px_60px_-24px_rgba(31,58,36,0.18)]" data-pl-reveal>
          <div class="flex items-center gap-3 mb-3">
            <div class="w-11 h-11 rounded-full bg-plgreen text-white font-extrabold flex items-center justify-center flex-shrink-0">{{ pl_t_names[forloop.index0] | slice: 0 }}</div>
            <div>
              <p class="font-bold text-plgreendark text-sm">{{ pl_t_names[forloop.index0] }} <span class="inline-flex items-center gap-0.5 text-plgreen text-[10px] font-bold align-middle">✓ موثّقة</span></p>
              <p class="text-xs text-plgreendark/45">📍 {{ pl_t_cities[forloop.index0] }}</p>
            </div>
          </div>
