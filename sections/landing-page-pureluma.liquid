<script>
  (function () {
    var root = document.getElementById('pl-root');
    if (!root) return;

    /* Scroll reveal */
    var reveals = root.querySelectorAll('[data-pl-reveal], [data-pl-reveal-scale]');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { entry.target.classList.add('is-visible'); io.unobserve(entry.target); }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
      reveals.forEach(function (el) { io.observe(el); });
    } else {
      reveals.forEach(function (el) { el.classList.add('is-visible'); });
    }

    /* Hero media (video fades in once playable; image is already visible) */
    var heroMedia = document.getElementById('pl-hero-media');
    if (heroMedia && heroMedia.tagName === 'VIDEO') {
      var revealMedia = function () { heroMedia.classList.add('is-ready'); };
      heroMedia.addEventListener('loadeddata', revealMedia, { once: true });
      heroMedia.addEventListener('playing', revealMedia, { once: true });
      var playPromise = heroMedia.play();
      if (playPromise && playPromise.catch) playPromise.catch(function () {});
    }

    /* Smooth scroll */
    document.querySelectorAll('[data-pl-scroll]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = document.querySelector(btn.getAttribute('data-pl-scroll'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    /* Generic horizontal slider helper (before/after) */
    function wireSlider(trackId, prevId, nextId) {
      var track = root.querySelector(trackId);
      if (!track) return;
      var step = function () {
        var item = track.children[0];
        return item ? item.getBoundingClientRect().width + 20 : 300;
      };
      var prev = root.querySelector(prevId);
      var next = root.querySelector(nextId);
      if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      if (next) next.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    }
    wireSlider('#pl-ba-track', '#pl-ba-prev', '#pl-ba-next');

    /* Lightbox for UGC review videos */
    var lightbox = document.getElementById('pl-lightbox');
    var lightboxContent = document.getElementById('pl-lightbox-content');
    root.querySelectorAll('[data-pl-video-item]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!lightbox || !lightboxContent) return;
        var src = btn.getAttribute('data-pl-video-src');
        lightboxContent.innerHTML = src
          ? '<video src="' + src + '" controls autoplay playsinline style="max-height:88vh;border-radius:18px;"></video>'
          : '';
        lightbox.classList.add('open');
      });
    });
    if (lightbox) {
      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) {
          lightbox.classList.remove('open');
          if (lightboxContent) lightboxContent.innerHTML = '';
        }
      });
    }

    /* Countdown — shared deadline, updates both the hero mini-timer and the urgency section timer */
    var cdKey = 'purelumaDeadline';
    var deadline = parseInt(localStorage.getItem(cdKey), 10);
    if (!deadline || deadline < Date.now()) {
      deadline = Date.now() + 8 * 60 * 60 * 1000;
      localStorage.setItem(cdKey, deadline);
    }
    function pad(n) { return String(n).padStart(2, '0'); }
    function tickCountdown() {
      var diff = Math.max(0, deadline - Date.now());
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      root.querySelectorAll('.pl-cd-h').forEach(function (el) { el.textContent = pad(h); });
      root.querySelectorAll('.pl-cd-m').forEach(function (el) { el.textContent = pad(m); });
      root.querySelectorAll('.pl-cd-s').forEach(function (el) { el.textContent = pad(s); });
    }
    tickCountdown();
    setInterval(tickCountdown, 1000);

    /* Sticky buy bar visibility (hidden once the order form is in view) */
    var sticky = document.getElementById('pl-sticky-bar');
    var order = document.getElementById('pl-order');
    if (sticky && order) {
      window.addEventListener('scroll', function () {
        var r = order.getBoundingClientRect();
        sticky.style.display = (r.top > window.innerHeight || r.bottom < 0) ? 'flex' : 'none';
      }, { passive: true });
    }

    /* Floating badge: alternates between live-visitor count and rating/reviews */
    var badgeText = document.getElementById('pl-float-badge-text');
    var visitorsCount = document.getElementById('pl-visitors-count');
    var badgeMode = 0;
    if (visitorsCount) {
      setInterval(function () {
        var c = parseInt(visitorsCount.textContent, 10) || 24;
        var next = Math.max(12, Math.min(48, c + (Math.random() > 0.5 ? 1 : -1)));
        visitorsCount.textContent = next;
      }, 4500);
    }
    if (badgeText) {
      setInterval(function () {
        badgeMode = badgeMode === 0 ? 1 : 0;
        if (badgeMode === 0) {
          badgeText.innerHTML = '<span id="pl-visitors-count">' + (visitorsCount ? visitorsCount.textContent : 24) + '</span> شخص كيتصفح المنتج الآن';
          visitorsCount = document.getElementById('pl-visitors-count');
        } else {
          badgeText.innerHTML = '⭐ 4.9/5 — أكثر من 500 تقييم';
        }
      }, 6000);
    }

    /* Recent purchase toast */
    var toastNames = ['فاطمة من الدار البيضاء', 'سارة من الرباط', 'إيمان من مراكش', 'خديجة من فاس', 'سلمى من طنجة', 'نسرين من أكادير', 'أمينة من مكناس', 'هاجر من وجدة'];
    var toastEl = document.getElementById('pl-toast');
    var toastText = document.getElementById('pl-toast-text');
    var toastIndex = 0;
    function showToast() {
      if (!toastEl || !toastText) return;
      var mins = 1 + Math.floor(Math.random() * 14);
      toastText.innerHTML = '<strong>' + toastNames[toastIndex % toastNames.length] + '</strong><br>طلبت سيروم PURELUMA منذ ' + mins + ' دقيقة';
      toastIndex++;
      toastEl.classList.add('show');
      setTimeout(function () { toastEl.classList.remove('show'); }, 4500);
      setTimeout(showToast, 12000 + Math.random() * 6000);
    }
    setTimeout(showToast, 5000);
  })();
</script>

</section>

