<script>
  (function () {
    var root = document.getElementById('pl-root');
    if (!root) return;

    var reveals = root.querySelectorAll('[data-pl-reveal]');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { entry.target.classList.add('is-visible'); io.unobserve(entry.target); }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
      reveals.forEach(function (el) { io.observe(el); });
    } else {
      reveals.forEach(function (el) { el.classList.add('is-visible'); });
    }

    document.querySelectorAll('[data-pl-scroll]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = document.querySelector(btn.getAttribute('data-pl-scroll'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    var track = root.querySelector('#pl-gallery-track');
    if (track) {
      var step = function () {
        var item = track.children[0];
        return item ? item.getBoundingClientRect().width + 20 : 300;
      };
      var prev = root.querySelector('#pl-gallery-prev');
      var next = root.querySelector('#pl-gallery-next');
      if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      if (next) next.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    }

    var qtyEl = root.querySelector('#pl-qty');
    var qtyMinus = root.querySelector('#pl-qty-minus');
    var qtyPlus = root.querySelector('#pl-qty-plus');
    if (qtyEl && qtyMinus) qtyMinus.addEventListener('click', function () {
      qtyEl.textContent = Math.max(1, (parseInt(qtyEl.textContent, 10) || 1) - 1);
    });
    if (qtyEl && qtyPlus) qtyPlus.addEventListener('click', function () {
      qtyEl.textContent = Math.max(1, (parseInt(qtyEl.textContent, 10) || 1) + 1);
    });

    var form = root.querySelector('#pl-order-form');
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var submitBtn = root.querySelector('#pl-submit');
        var submitLabel = root.querySelector('#pl-submit-label');
        var msg = root.querySelector('#pl-form-msg');
        var name = root.querySelector('#pl-name').value.trim();
        var phone = root.querySelector('#pl-phone').value.trim();
        var city = root.querySelector('#pl-city').value.trim();
        var address = root.querySelector('#pl-address').value.trim();

        if (!name || !phone || !city || !address) return;

        submitBtn.disabled = true;
        submitLabel.textContent = 'جارٍ التأكيد...';

        {%- if product -%}
          var variantId = {{ pl_variant.id | json }};
          var qty = parseInt((qtyEl && qtyEl.textContent) || '1', 10) || 1;

          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ id: variantId, quantity: qty })
          })
            .then(function (res) { if (!res.ok) throw new Error('add failed'); return res.json(); })
            .then(function () {
              return fetch('/cart/update.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({
                  attributes: { 'الاسم': name, 'الهاتف': phone, 'المدينة': city, 'العنوان': address }
                })
              });
            })
            .then(function () { window.location.href = '/checkout'; })
            .catch(function () {
              submitBtn.disabled = false;
              submitLabel.textContent = 'أكدي طلبي الآن';
              if (msg) { msg.textContent = 'حدث خطأ، حاولي مجدداً.'; msg.classList.remove('hidden'); }
            });
        {%- else -%}
          setTimeout(function () {
            submitBtn.disabled = false;
            submitLabel.textContent = 'أكدي طلبي الآن';
            if (msg) { msg.textContent = 'أضيفي هذا القسم لصفحة منتج لتفعيل الطلب.'; msg.classList.remove('hidden'); }
          }, 600);
        {%- endif -%}
      });
    }
  })();
</script>

</section>

