    { "type": "text", "id": "hero_heading", "label": "Titre", "default": "خلّ حمامك مرتب وأنيق دائمًا" },
    { "type": "textarea", "id": "hero_subheading", "label": "Sous-titre", "default": "حامل فرشاة الأسنان الذكي يساعدك تتخلصين من فوضى مستلزمات الحمام، ويوفر لك مساحة على المغسلة، ويخلي كل غرض في مكانه المناسب." },
    { "type": "header", "content": "Offre" },
    { "type": "checkbox", "id": "show_free_shipping", "label": "Afficher le shipping gratuit", "default": false },
    { "type": "text", "id": "free_shipping_text", "label": "Texte du shipping gratuit", "default": "شحن مجاني داخل الكويت" },
    { "type": "text", "id": "countdown_end", "label": "Fin de l'offre (ex: 2026-08-20T23:59) — vide = pas de compte à rebours" },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_delivery_answer", "label": "Réponse — durée de livraison réelle" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis (placeholder)",
      "settings": [
        { "type": "text", "id": "name", "label": "اسم العميل (تجريبي)", "default": "اسم العميل" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "التقييم", "default": 5 },
        { "type": "textarea", "id": "text", "label": "نص التجربة (تجريبي)", "default": "اكتب هنا نص تجربة العميل — هذا نص تجريبي قابل للتعديل." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kuwait Landing (COD)",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
