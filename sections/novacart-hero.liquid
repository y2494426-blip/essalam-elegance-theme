{% comment %} NOVACART Hero — World-Class Luxury Brand Hero — Saudi Market {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">

<style>
/* ══════════════════════════════════════════════
   NOVACART HERO — LUXURY BRAND LEVEL
   Prefix: nch-   Scope: #nch-{{ section.id }}
══════════════════════════════════════════════ */
#nch-{{ section.id }},
#nch-{{ section.id }} *,
#nch-{{ section.id }} *::before,
#nch-{{ section.id }} *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ── TOKENS ── */
#nch-{{ section.id }} {
  --c-bg:       #F7F4EE;
  --c-bg2:      #FFFFFF;
  --c-black:    #0A0A0A;
  --c-dark:     #1A1A1A;
  --c-muted:    #7A7572;
  --c-gold:     #B8963E;
  --c-gold-lt:  #D4B96A;
  --c-green:    #15803D;
  --c-green-dk: #0E5F2C;
  --c-border:   rgba(0,0,0,.08);
  --c-card-bg:  rgba(255,255,255,0.72);
  --c-glass-bg: rgba(255,255,255,0.55);
  --font:       'Tajawal', sans-serif;
  font-family:  var(--font);
  direction:    rtl;
}

/* ── SECTION ── */
#nch-{{ section.id }} {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--c-bg);
}

/* ── TEXTURE OVERLAY ── */
#nch-{{ section.id }}::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle at 8% 20%, rgba(184,150,62,.09) 0%, transparent 40%),
    radial-gradient(circle at 92% 80%, rgba(21,128,61,.06) 0%, transparent 40%),
    radial-gradient(circle at 50% 50%, rgba(0,0,0,.015) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* Dot grid texture */
#nch-{{ section.id }}::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(0,0,0,.055) 1px, transparent 1px);
  background-size: 28px 28px;
  pointer-events: none;
  z-index: 0;
  opacity: .5;
}

/* ── CONTAINER ── */
.nch-wrap {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  width: 100%;
  position: relative;
  z-index: 1;
}

/* ── TOPBAR ── */
.nch-topbar {
  width: 100%;
  background: var(--c-black);
  color: rgba(255,255,255,.85);
  font-family: var(--font);
  font-size: .82rem;
  font-weight: 500;
  letter-spacing: .5px;
  text-align: center;
  padding: 10px 16px;
  position: relative;
  z-index: 2;
  direction: rtl;
}
.nch-topbar span { color: var(--c-gold-lt); font-weight: 700; }

/* ── MAIN AREA ── */
.nch-main {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  align-items: center;
  padding: 70px 0 60px;
  position: relative;
  z-index: 1;
}

/* ════════════════════════
   LEFT — TEXT COLUMN
════════════════════════ */
.nch-left {
  padding: 0 20px 0 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
}

/* Brand flag */
.nch-flag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 28px;
  opacity: 0;
  animation: nch-up .7s .05s ease forwards;
}
.nch-flag-line {
  width: 32px;
  height: 2px;
  background: var(--c-gold);
  border-radius: 2px;
}
.nch-flag-text {
  font-size: .75rem;
  font-weight: 700;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--c-gold);
}

/* Headline */
.nch-headline {
  font-size: clamp(2.4rem, 4.2vw, 4rem);
  font-weight: 900;
  line-height: 1.15;
  color: var(--c-black);
  margin-bottom: 24px;
  white-space: pre-line;
  opacity: 0;
  animation: nch-up .8s .15s ease forwards;
}
.nch-headline .nch-hl-accent {
  position: relative;
  display: inline-block;
  color: var(--c-black);
}
.nch-headline .nch-hl-accent::after {
  content: '';
  position: absolute;
  bottom: 4px;
  right: 0;
  left: 0;
  height: 6px;
  background: linear-gradient(90deg, var(--c-gold), var(--c-gold-lt));
  opacity: .28;
  border-radius: 3px;
  z-index: -1;
}

/* Subtitle */
.nch-sub {
  font-size: 1.05rem;
  font-weight: 400;
  line-height: 1.75;
  color: var(--c-muted);
  max-width: 420px;
  margin-bottom: 38px;
  opacity: 0;
  animation: nch-up .8s .25s ease forwards;
}

/* CTA group */
.nch-cta-group {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 36px;
  opacity: 0;
  animation: nch-up .8s .35s ease forwards;
}

/* Primary button */
.nch-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: var(--c-black);
  color: #fff;
  font-family: var(--font);
  font-size: 1rem;
  font-weight: 700;
  padding: 16px 36px;
  border: 2px solid var(--c-black);
  border-radius: 50px;
  text-decoration: none;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: background .25s, color .25s, transform .2s, box-shadow .25s;
  box-shadow: 0 8px 28px rgba(0,0,0,.18);
  letter-spacing: .3px;
}
.nch-btn-primary::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,.12) 0%, transparent 60%);
  pointer-events: none;
}
.nch-btn-primary:hover {
  background: var(--c-dark);
  transform: translateY(-3px);
  box-shadow: 0 16px 44px rgba(0,0,0,.28);
}
.nch-btn-primary .nch-arrow {
  font-size: .9rem;
  transition: transform .25s;
}
.nch-btn-primary:hover .nch-arrow { transform: translateX(-6px); }

/* Secondary button */
.nch-btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  color: var(--c-black);
  font-family: var(--font);
  font-size: 1rem;
  font-weight: 600;
  padding: 16px 28px;
  border: 1.5px solid rgba(0,0,0,.2);
  border-radius: 50px;
  text-decoration: none;
  cursor: pointer;
  transition: border-color .25s, background .25s, transform .2s;
  letter-spacing: .3px;
}
.nch-btn-secondary:hover {
  border-color: var(--c-black);
  background: rgba(0,0,0,.04);
  transform: translateY(-2px);
}

/* Trust pills */
.nch-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 20px;
  opacity: 0;
  animation: nch-up .8s .45s ease forwards;
}
.nch-trust-item {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: .82rem;
  font-weight: 600;
  color: var(--c-muted);
}
.nch-trust-item .nch-ti { font-size: 1rem; }
.nch-trust-divider {
  width: 1px;
  height: 14px;
  background: rgba(0,0,0,.15);
  align-self: center;
}

/* ════════════════════════
   RIGHT — PRODUCT SHOWCASE
════════════════════════ */
.nch-right {
  position: relative;
  height: 580px;
  opacity: 0;
  animation: nch-fade .9s .2s ease forwards;
}

/* Card base */
.nch-card {
  position: absolute;
  background: var(--c-card-bg);
  backdrop-filter: blur(20px) saturate(1.4);
  -webkit-backdrop-filter: blur(20px) saturate(1.4);
  border: 1px solid rgba(255,255,255,.85);
  border-radius: 24px;
  box-shadow:
    0 4px 6px rgba(0,0,0,.04),
    0 12px 40px rgba(0,0,0,.09),
    0 32px 64px rgba(0,0,0,.06),
    inset 0 1px 0 rgba(255,255,255,.9);
  overflow: hidden;
  transition: transform .4s ease, box-shadow .4s ease;
  cursor: pointer;
}
.nch-card:hover {
  box-shadow:
    0 8px 12px rgba(0,0,0,.06),
    0 24px 60px rgba(0,0,0,.14),
    0 48px 80px rgba(0,0,0,.08),
    inset 0 1px 0 rgba(255,255,255,.9);
}

/* Card inner layout */
.nch-card-img {
  width: 100%;
  display: block;
  object-fit: cover;
  transition: transform .5s ease;
}
.nch-card:hover .nch-card-img { transform: scale(1.04); }

.nch-card-body {
  padding: 14px 16px 16px;
  background: #fff;
}
.nch-card-label {
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--c-gold);
  margin-bottom: 4px;
}
.nch-card-name {
  font-size: .95rem;
  font-weight: 700;
  color: var(--c-black);
  margin-bottom: 8px;
  line-height: 1.3;
}
.nch-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nch-card-price {
  font-size: 1.05rem;
  font-weight: 900;
  color: var(--c-black);
}
.nch-card-price small {
  font-size: .75rem;
  font-weight: 400;
  color: var(--c-muted);
}
.nch-card-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--c-black);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .85rem;
  text-decoration: none;
  transition: background .2s, transform .2s;
  flex-shrink: 0;
}
.nch-card-btn:hover { background: var(--c-green); transform: scale(1.12); }

/* CARD 1 — Main large card */
.nch-card-1 {
  width: 240px;
  top: 40px;
  right: 30px;
  animation: nch-float-1 5s ease-in-out infinite;
  z-index: 3;
}
.nch-card-1 .nch-card-img { height: 180px; }

/* CARD 2 — Top left */
.nch-card-2 {
  width: 195px;
  top: 0;
  left: 60px;
  animation: nch-float-2 5.8s .8s ease-in-out infinite;
  z-index: 2;
}
.nch-card-2 .nch-card-img { height: 150px; }

/* CARD 3 — Bottom center */
.nch-card-3 {
  width: 210px;
  bottom: 30px;
  right: 100px;
  animation: nch-float-3 6.2s 1.4s ease-in-out infinite;
  z-index: 2;
}
.nch-card-3 .nch-card-img { height: 160px; }

/* Float animations */
@keyframes nch-float-1 {
  0%,100% { transform: translateY(0) rotate(-.5deg); }
  50%      { transform: translateY(-14px) rotate(.5deg); }
}
@keyframes nch-float-2 {
  0%,100% { transform: translateY(0) rotate(.8deg); }
  50%      { transform: translateY(-10px) rotate(-.5deg); }
}
@keyframes nch-float-3 {
  0%,100% { transform: translateY(0) rotate(-.3deg); }
  50%      { transform: translateY(-12px) rotate(.8deg); }
}

/* ── Glass chip cards ── */
.nch-chip {
  position: absolute;
  background: var(--c-glass-bg);
  backdrop-filter: blur(16px) saturate(1.5);
  -webkit-backdrop-filter: blur(16px) saturate(1.5);
  border: 1px solid rgba(255,255,255,.9);
  border-radius: 50px;
  padding: 10px 18px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font);
  font-size: .82rem;
  font-weight: 700;
  color: var(--c-dark);
  box-shadow: 0 8px 28px rgba(0,0,0,.10);
  white-space: nowrap;
  z-index: 4;
}

/* Stars chip */
.nch-chip-stars {
  top: 160px;
  left: 10px;
  animation: nch-float-2 4.5s 2s ease-in-out infinite;
}
.nch-chip-stars .nch-chip-star { color: #F59E0B; font-size: .9rem; letter-spacing: 1px; }

/* Sold chip */
.nch-chip-sold {
  bottom: 160px;
  left: 40px;
  animation: nch-float-3 5.5s .5s ease-in-out infinite;
}
.nch-chip-sold .nch-chip-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--c-green);
  box-shadow: 0 0 0 3px rgba(21,128,61,.2);
  animation: nch-pulse 1.6s infinite;
  flex-shrink: 0;
}

/* New badge chip */
.nch-chip-new {
  top: -16px;
  left: 30%;
  animation: nch-float-1 4s 1s ease-in-out infinite;
}
.nch-chip-new .nch-chip-dot-gold {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--c-gold);
  flex-shrink: 0;
}

@keyframes nch-pulse {
  0%,100% { box-shadow: 0 0 0 3px rgba(21,128,61,.2); }
  50%      { box-shadow: 0 0 0 6px rgba(21,128,61,0); }
}

/* ── BACKGROUND GLOW behind cards ── */
.nch-right-glow {
  position: absolute;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(184,150,62,.12) 0%, transparent 65%);
  top: 50%;
  right: 50%;
  transform: translate(50%,-50%);
  pointer-events: none;
  z-index: 0;
}

/* ── SCROLL CARET ── */
.nch-scroll {
  position: absolute;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  color: var(--c-muted);
  font-family: var(--font);
  font-size: .7rem;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  z-index: 2;
  opacity: 0;
  animation: nch-up .8s 1s ease forwards;
}
.nch-scroll-line {
  width: 1px;
  height: 40px;
  background: linear-gradient(to bottom, var(--c-gold), transparent);
  animation: nch-scroll-ani 1.8s ease-in-out infinite;
}
@keyframes nch-scroll-ani {
  0%,100% { transform: scaleY(1); opacity: .8; }
  50%      { transform: scaleY(.5); opacity: .3; }
}

/* ── ENTRY ANIMATIONS ── */
@keyframes nch-up {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes nch-fade {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ═══════════════════════════════════
   STICKY MOBILE BUY
═══════════════════════════════════ */
#nch-sticky-{{ section.id }} {
  display: none;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  border-top: 1.5px solid rgba(0,0,0,.08);
  padding: 12px 16px;
  z-index: 999;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-shadow: 0 -4px 24px rgba(0,0,0,.10);
  font-family: var(--font);
  direction: rtl;
}
#nch-sticky-{{ section.id }} .nch-st-label {
  font-size: .8rem;
  color: var(--c-muted);
  margin-bottom: 2px;
}
#nch-sticky-{{ section.id }} .nch-st-name {
  font-size: 1rem;
  font-weight: 800;
  color: var(--c-black);
}
#nch-sticky-{{ section.id }} .nch-btn-primary {
  font-size: .9rem;
  padding: 12px 26px;
  white-space: nowrap;
}

/* ═══════════════════════════════════
   RESPONSIVE
═══════════════════════════════════ */
@media (max-width: 980px) {
  .nch-main {
    grid-template-columns: 1fr;
    padding: 40px 0 100px;
    gap: 50px;
  }
  .nch-left { align-items: center; text-align: center; }
  .nch-sub { text-align: center; }
  .nch-flag { justify-content: center; }
  .nch-right { height: 420px; width: 100%; }
  .nch-card-1 { width: 195px; right: 50%; transform: translateX(60%); top: 20px; }
  .nch-card-2 { width: 160px; left: 8%; top: 10px; }
  .nch-card-3 { width: 170px; right: 8%; bottom: 20px; }
  .nch-trust { justify-content: center; }
  .nch-cta-group { justify-content: center; }
  #nch-sticky-{{ section.id }} { display: flex; }
}

@media (max-width: 600px) {
  #nch-{{ section.id }} { min-height: auto; }
  .nch-headline { font-size: 2rem; }
  .nch-sub { font-size: .95rem; }
  .nch-right { height: 360px; }
  .nch-card-1 { width: 170px; }
  .nch-card-2 { width: 140px; }
  .nch-card-3 { width: 150px; }
  .nch-chip-sold { display: none; }
  .nch-scroll { display: none; }
  .nch-trust-divider { display: none; }
  .nch-wrap { padding: 0 18px; }
}
</style>

<!-- STICKY MOBILE -->
<div id="nch-sticky-{{ section.id }}">
  <div>
    <div class="nch-st-label">اكتشف المجموعة الكاملة</div>
    <div class="nch-st-name">NOVACART</div>
  </div>
  <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="nch-btn-primary">
    ابدأ التسوق <span class="nch-arrow">←</span>
  </a>
</div>

<div id="nch-{{ section.id }}">

  <!-- TOP BAR -->
  <div class="nch-topbar">
    ✦ &nbsp;شحن مجاني لجميع مناطق المملكة &nbsp;|&nbsp; الدفع عند الاستلام &nbsp;|&nbsp; <span>عروض حصرية هذا الأسبوع</span>&nbsp; ✦
  </div>

  <!-- MAIN GRID -->
  <div class="nch-main nch-wrap">

    <!-- ══ LEFT ══ -->
    <div class="nch-left">

      <!-- Flag -->
      <div class="nch-flag">
        <div class="nch-flag-line"></div>
        <span class="nch-flag-text">
          {%- if section.settings.badge != blank -%}{{ section.settings.badge }}{%- else -%}منتجات مختارة بعناية{%- endif -%}
        </span>
      </div>

      <!-- Headline -->
      <h1 class="nch-headline">
        {%- if section.settings.title != blank -%}
          {{ section.settings.title }}
        {%- else -%}
          اكتشف ما يستحق<br><span class="nch-hl-accent">اهتمامك حقاً</span>
        {%- endif -%}
      </h1>

      <!-- Subtitle -->
      <p class="nch-sub">
        {%- if section.settings.subtitle != blank -%}
          {{ section.settings.subtitle }}
        {%- else -%}
          منتجات استثنائية بجودة عالمية، تُوصَّل إلى باب منزلك في المملكة العربية السعودية. الدفع عند الاستلام، الشحن مجاناً.
        {%- endif -%}
      </p>

      <!-- CTAs -->
      <div class="nch-cta-group">
        <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="nch-btn-primary" id="nch-primary-btn-{{ section.id }}">
          {%- if section.settings.btn1_label != blank -%}{{ section.settings.btn1_label }}{%- else -%}ابدأ التسوق{%- endif -%}
          <span class="nch-arrow">←</span>
        </a>
        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_url | default: '/collections/all' }}" class="nch-btn-secondary">
            {{ section.settings.btn2_label }}
          </a>
        {%- else -%}
          <a href="/collections/all" class="nch-btn-secondary">اكتشف المنتجات</a>
        {%- endif -%}
      </div>

      <!-- Trust -->
      <div class="nch-trust">
        <span class="nch-trust-item"><span class="nch-ti">🚚</span> شحن سريع</span>
        <span class="nch-trust-divider"></span>
        <span class="nch-trust-item"><span class="nch-ti">💳</span> الدفع عند الاستلام</span>
        <span class="nch-trust-divider"></span>
        <span class="nch-trust-item"><span class="nch-ti">🔒</span> دفع آمن</span>
        <span class="nch-trust-divider"></span>
        <span class="nch-trust-item"><span class="nch-ti">⭐</span> آلاف العملاء</span>
        <span class="nch-trust-divider"></span>
        <span class="nch-trust-item"><span class="nch-ti">🛡</span> ضمان الجودة</span>
      </div>

    </div><!-- /left -->

    <!-- ══ RIGHT — PRODUCT COMPOSITION ══ -->
    <div class="nch-right">

      <!-- Background glow -->
      <div class="nch-right-glow"></div>

      <!-- Glass chip: Stars -->
      <div class="nch-chip nch-chip-stars">
        <span class="nch-chip-star">★★★★★</span>
        <span>4.9 / 5</span>
      </div>

      <!-- Glass chip: Live orders -->
      <div class="nch-chip nch-chip-sold">
        <span class="nch-chip-dot"></span>
        <span id="nch-live-{{ section.id }}">47</span> طلب الآن
      </div>

      <!-- Glass chip: New -->
      <div class="nch-chip nch-chip-new">
        <span class="nch-chip-dot-gold"></span>
        <span>وصل حديثاً ✦</span>
      </div>

      <!-- CARD 1 — Main -->
      <a href="{{ section.settings.product_url_1 | default: '/collections/all' }}" class="nch-card nch-card-1" aria-label="{{ section.settings.product_title_1 }}">
        {%- if section.settings.product_image_1 != blank -%}
          {{ section.settings.product_image_1 | image_url: width: 480 | image_tag: loading: 'eager', class: 'nch-card-img', alt: section.settings.product_title_1 }}
        {%- else -%}
