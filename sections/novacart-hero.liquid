{% comment %} NOVACART Hero — Cinematic Fullscreen Video — prefix: ncv- {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">

<style>
/* ══════════════════════════════════════════
   NOVACART — CINEMATIC VIDEO HERO
   Prefix: ncv-   Scope: #ncv-{{ section.id }}
══════════════════════════════════════════ */
#ncv-{{ section.id }},
#ncv-{{ section.id }} *,
#ncv-{{ section.id }} *::before,
#ncv-{{ section.id }} *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ── SECTION ── */
#ncv-{{ section.id }} {
  --font:    'Tajawal', sans-serif;
  --gold:    #C9A227;
  --gold-lt: #E0C060;
  --white:   #FFFFFF;
  --green:   #15803D;
  --green-dk:#0E5F2C;
  --black:   #0A0A0A;
  position: relative;
  width: 100%;
  height: 100svh;
  min-height: 560px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font);
  direction: rtl;
}

/* ── VIDEO ── */
.ncv-video-wrap {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: var(--black); /* shown while video loads */
}
.ncv-video-wrap video,
.ncv-video-wrap img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
}
/* Fallback placeholder (when no video/image set) */
.ncv-video-placeholder {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #0A0A0A 0%, #1C1C1C 40%, #121212 100%);
}

/* ── OVERLAY ── */
.ncv-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,.10)  0%,
    rgba(0,0,0,.32) 30%,
    rgba(0,0,0,.55) 60%,
    rgba(0,0,0,.72) 100%
  );
}
/* Optional stronger overlay for readability */
.ncv-overlay-2 {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: radial-gradient(ellipse at center, transparent 0%, rgba(0,0,0,.30) 100%);
}

/* ── CONTENT (centered) ── */
.ncv-content {
  position: relative;
  z-index: 2;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  padding: 0 24px;
  max-width: 820px;
  width: 100%;
}

/* Badge */
.ncv-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 28px;
  opacity: 0;
  animation: ncv-up .8s .1s ease forwards;
}
.ncv-badge-line {
  width: 28px;
  height: 1.5px;
  background: var(--gold);
  border-radius: 2px;
}
.ncv-badge-text {
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--gold);
}

/* Headline */
.ncv-headline {
  font-size: clamp(2.4rem, 6vw, 5rem);
  font-weight: 900;
  line-height: 1.15;
  color: var(--white);
  margin-bottom: 20px;
  text-shadow: 0 2px 24px rgba(0,0,0,.45);
  white-space: pre-line;
  opacity: 0;
  animation: ncv-up .9s .2s ease forwards;
}
.ncv-headline-accent {
  color: var(--gold-lt);
  position: relative;
  display: inline-block;
}
.ncv-headline-accent::after {
  content: '';
  position: absolute;
  bottom: 2px;
  right: 0; left: 0;
  height: 3px;
  background: var(--gold);
  opacity: .5;
  border-radius: 2px;
}

/* Subtitle */
.ncv-sub {
  font-size: clamp(.95rem, 2vw, 1.15rem);
  font-weight: 400;
  line-height: 1.75;
  color: rgba(255,255,255,.82);
  max-width: 560px;
  margin-bottom: 40px;
  text-shadow: 0 1px 8px rgba(0,0,0,.5);
  opacity: 0;
  animation: ncv-up .9s .32s ease forwards;
}

/* ── CTA GROUP ── */
.ncv-ctas {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 32px;
  opacity: 0;
  animation: ncv-up .9s .44s ease forwards;
}

/* Primary */
.ncv-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: var(--white);
  color: var(--black);
  font-family: var(--font);
  font-size: 1.05rem;
  font-weight: 800;
  padding: 17px 42px;
  border: 2px solid var(--white);
  border-radius: 50px;
  text-decoration: none;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: background .25s, color .25s, transform .22s, box-shadow .25s;
  box-shadow: 0 8px 32px rgba(0,0,0,.35);
  letter-spacing: .3px;
  white-space: nowrap;
}
.ncv-btn-primary::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,.18) 0%, transparent 60%);
  pointer-events: none;
}
.ncv-btn-primary:hover {
  background: var(--gold);
  border-color: var(--gold);
  color: #fff;
  transform: translateY(-3px);
  box-shadow: 0 14px 44px rgba(0,0,0,.45);
}
.ncv-btn-primary .ncv-arrow {
  font-size: .85rem;
  transition: transform .25s;
}
.ncv-btn-primary:hover .ncv-arrow { transform: translateX(-5px); }

/* Secondary */
.ncv-btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  color: var(--white);
  font-family: var(--font);
  font-size: 1.05rem;
  font-weight: 600;
  padding: 17px 32px;
  border: 1.5px solid rgba(255,255,255,.55);
  border-radius: 50px;
  text-decoration: none;
  cursor: pointer;
  transition: border-color .25s, background .25s, transform .22s;
  letter-spacing: .3px;
  white-space: nowrap;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}
.ncv-btn-secondary:hover {
  border-color: rgba(255,255,255,.9);
  background: rgba(255,255,255,.12);
  transform: translateY(-2px);
}

/* ── TRUST ROW ── */
.ncv-trust {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px 18px;
  justify-content: center;
  opacity: 0;
  animation: ncv-up .9s .56s ease forwards;
}
.ncv-trust-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: .82rem;
  font-weight: 600;
  color: rgba(255,255,255,.78);
  text-shadow: 0 1px 4px rgba(0,0,0,.5);
}
.ncv-trust-dot {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: rgba(255,255,255,.35);
  flex-shrink: 0;
}

/* ── SCROLL INDICATOR ── */
.ncv-scroll {
  position: absolute;
  bottom: 36px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  opacity: 0;
  animation: ncv-up .9s 1s ease forwards;
  text-decoration: none;
}
.ncv-scroll-label {
  font-family: var(--font);
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: rgba(255,255,255,.7);
  text-shadow: 0 1px 4px rgba(0,0,0,.5);
}
.ncv-scroll-icon {
  width: 44px;
  height: 44px;
  border: 1.5px solid rgba(255,255,255,.35);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,.8);
  font-size: 1.1rem;
  animation: ncv-bounce 2s ease-in-out infinite;
  transition: border-color .25s, background .25s;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  background: rgba(255,255,255,.06);
}
.ncv-scroll:hover .ncv-scroll-icon {
  border-color: var(--gold);
  background: rgba(201,162,39,.15);
  color: var(--gold);
}
@keyframes ncv-bounce {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(7px); }
}

/* ── LOADING SHIMMER (before video plays) ── */
.ncv-shimmer {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: linear-gradient(110deg, #0a0a0a 0%, #1a1a1a 40%, #0f0f0f 100%);
  animation: ncv-shimmer-ani 2s ease-in-out infinite;
}
@keyframes ncv-shimmer-ani {
  0%,100% { opacity: 1; }
  50%      { opacity: .7; }
}

/* ── KEYFRAMES ── */
@keyframes ncv-up {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes ncv-fade {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ── VIDEO GRAIN TEXTURE ── */
.ncv-grain {
  position: absolute;
  inset: 0;
  z-index: 1;
  opacity: .025;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  background-size: 200px 200px;
  pointer-events: none;
}

/* ═══════════════════════════════
   STICKY MOBILE BUY
═══════════════════════════════ */
#ncv-sticky-{{ section.id }} {
  display: none;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(10,10,10,.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-top: 1px solid rgba(255,255,255,.08);
  padding: 12px 16px;
  z-index: 999;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-shadow: 0 -4px 24px rgba(0,0,0,.4);
  font-family: var(--font);
  direction: rtl;
}
#ncv-sticky-{{ section.id }} .ncv-st-brand {
  font-size: 1rem;
  font-weight: 900;
  color: #fff;
  letter-spacing: .5px;
}
#ncv-sticky-{{ section.id }} .ncv-st-sub {
  font-size: .75rem;
  color: rgba(255,255,255,.5);
  margin-top: 1px;
}
#ncv-sticky-{{ section.id }} .ncv-btn-sm {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--white);
  color: var(--black);
  font-family: var(--font);
  font-size: .92rem;
  font-weight: 800;
  padding: 11px 24px;
  border-radius: 50px;
  text-decoration: none;
  white-space: nowrap;
  transition: background .2s, transform .2s;
}
#ncv-sticky-{{ section.id }} .ncv-btn-sm:hover {
  background: var(--gold);
  color: #fff;
}

/* ═══════════════════════════════
   RESPONSIVE
═══════════════════════════════ */
@media (max-width: 768px) {
  #ncv-{{ section.id }} { min-height: 100svh; }
  .ncv-headline { font-size: clamp(2rem, 8vw, 3rem); }
  .ncv-sub { font-size: .95rem; margin-bottom: 32px; }
  .ncv-ctas { gap: 10px; }
  .ncv-btn-primary, .ncv-btn-secondary { font-size: .95rem; padding: 15px 28px; }
  .ncv-trust-dot { display: none; }
  .ncv-scroll { bottom: 24px; }
  #ncv-sticky-{{ section.id }} { display: flex; }
}
@media (max-width: 420px) {
  .ncv-ctas { flex-direction: column; width: 100%; }
  .ncv-btn-primary, .ncv-btn-secondary { width: 100%; justify-content: center; }
  .ncv-trust { gap: 8px 14px; }
}
@media (prefers-reduced-motion: reduce) {
  #ncv-{{ section.id }} * { animation-duration: .01ms !important; }
}
</style>

<!-- STICKY MOBILE BAR -->
<div id="ncv-sticky-{{ section.id }}">
  <div>
    <div class="ncv-st-brand">NOVACART</div>
    <div class="ncv-st-sub">منتجات مميزة بجودة عالمية</div>
  </div>
  <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="ncv-btn-sm">
    ابدأ التسوق ←
  </a>
</div>

<!-- ══════════════ HERO ══════════════ -->
<section id="ncv-{{ section.id }}">

  <!-- VIDEO / FALLBACK -->
  <div class="ncv-video-wrap">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'auto',
          class: 'ncv-video-el'
      }}
    {%- elsif section.settings.video_url != blank -%}
      <video
        class="ncv-video-el"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
        {%- if section.settings.video_url_webm != blank -%}
          <source src="{{ section.settings.video_url_webm }}" type="video/webm">
        {%- endif -%}
      </video>
    {%- elsif section.settings.fallback_image != blank -%}
      {{ section.settings.fallback_image | image_url: width: 1920 | image_tag: loading: 'eager', alt: '', class: '' }}
    {%- else -%}
      <div class="ncv-video-placeholder"></div>
      <div class="ncv-shimmer"></div>
    {%- endif -%}
  </div>

  <!-- OVERLAYS -->
  <div class="ncv-overlay"></div>
  <div class="ncv-overlay-2"></div>
  <div class="ncv-grain"></div>

  <!-- CENTERED CONTENT -->
  <div class="ncv-content">

    <!-- Brand flag -->
    {%- if section.settings.badge != blank -%}
      <div class="ncv-badge">
        <div class="ncv-badge-line"></div>
        <span class="ncv-badge-text">{{ section.settings.badge }}</span>
        <div class="ncv-badge-line"></div>
      </div>
    {%- endif -%}

    <!-- Headline -->
    {%- if section.settings.title != blank -%}
      <h1 class="ncv-headline">{{ section.settings.title }}</h1>
    {%- else -%}
      <h1 class="ncv-headline">منتجات استثنائية<br><span class="ncv-headline-accent">بجودة عالمية</span></h1>
    {%- endif -%}

    <!-- Subtitle -->
    {%- if section.settings.subtitle != blank -%}
      <p class="ncv-sub">{{ section.settings.subtitle }}</p>
    {%- else -%}
      <p class="ncv-sub">اكتشف مجموعتنا المختارة بعناية. الدفع عند الاستلام، شحن مجاني لجميع مناطق المملكة.</p>
    {%- endif -%}

    <!-- CTAs -->
    <div class="ncv-ctas">
      <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="ncv-btn-primary" id="ncv-primary-{{ section.id }}">
        {%- if section.settings.btn1_label != blank -%}{{ section.settings.btn1_label }}{%- else -%}ابدأ التسوق{%- endif -%}
        <span class="ncv-arrow">←</span>
      </a>
      <a href="{{ section.settings.btn2_url | default: '/collections/all' }}" class="ncv-btn-secondary">
        {%- if section.settings.btn2_label != blank -%}{{ section.settings.btn2_label }}{%- else -%}اكتشف المنتجات{%- endif -%}
      </a>
    </div>

    <!-- Trust -->
    <div class="ncv-trust">
      <span class="ncv-trust-item">🚚 شحن مجاني</span>
      <span class="ncv-trust-dot"></span>
      <span class="ncv-trust-item">💳 الدفع عند الاستلام</span>
      <span class="ncv-trust-dot"></span>
      <span class="ncv-trust-item">⭐ آلاف العملاء السعداء</span>
      <span class="ncv-trust-dot"></span>
      <span class="ncv-trust-item">🔒 شراء آمن</span>
    </div>

  </div><!-- /content -->

  <!-- SCROLL INDICATOR -->
  <a
    class="ncv-scroll"
    href="#ncv-products-anchor"
    onclick="ncvScroll(event)"
    aria-label="اكتشف المنتجات"
  >
    <span class="ncv-scroll-label">اكتشف منتجاتنا</span>
    <div class="ncv-scroll-icon">↓</div>
  </a>

</section>

<!-- Products anchor — place this ID on the first section below the hero -->
<span id="ncv-products-anchor" style="display:block;position:relative;top:-60px;pointer-events:none;"></span>

<script>
(function(){
  var sid = '{{ section.id }}';

  /* ── Force autoplay on video (Safari fallback) ── */
  document.querySelectorAll('#ncv-' + sid + ' .ncv-video-el').forEach(function(v){
    v.muted = true;
    var p = v.play();
    if(p && p.catch) p.catch(function(){ v.muted = true; v.play(); });
  });

  /* ── Sticky bar: show after hero scrolls away ── */
  var hero   = document.getElementById('ncv-' + sid);
  var sticky = document.getElementById('ncv-sticky-' + sid);
  if(hero && sticky){
    var io = new IntersectionObserver(function(e){
      sticky.style.display = e[0].isIntersecting ? 'none' : '';
    }, { threshold: .08 });
    io.observe(hero);
  }

  /* ── Ripple on primary CTA ── */
  var btn = document.getElementById('ncv-primary-' + sid);
  if(btn){
    btn.addEventListener('click', function(e){
      var r = document.createElement('span');
      var rect = btn.getBoundingClientRect(), sz = Math.max(rect.width, rect.height);
      r.style.cssText = 'position:absolute;border-radius:50%;pointer-events:none;width:'+sz+'px;height:'+sz+'px;top:'+(e.clientY-rect.top-sz/2)+'px;right:'+(rect.right-e.clientX-sz/2)+'px;background:rgba(0,0,0,.12);transform:scale(0);animation:ncv_rip .6s ease forwards';
      btn.appendChild(r);
      setTimeout(function(){ r.remove(); }, 620);
    });
  }
  if(!document.getElementById('ncv-rip-ks')){
    var ks = document.createElement('style');
    ks.id = 'ncv-rip-ks';
    ks.textContent = '@keyframes ncv_rip{to{transform:scale(4);opacity:0}}';
    document.head.appendChild(ks);
  }
})();

/* ── Scroll to products ── */
function ncvScroll(e){
  e.preventDefault();
  var anchor = document.getElementById('ncv-products-anchor');
  if(!anchor) return;
  var target = anchor.nextElementSibling || anchor;
  window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - 20, behavior: 'smooth' });
}
</script>

{% schema %}
{
  "name": "NOVACART Hero",
  "tag": "section",
  "class": "novacart-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "الفيديو"
    },
    {
      "type": "video",
      "id": "video",
      "label": "فيديو (رفع من Shopify)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "رابط الفيديو MP4 (CDN خارجي)",
      "info": "مثال: https://cdn.example.com/hero.mp4 — يُستخدم إذا لم يُرفع فيديو من Shopify"
    },
    {
      "type": "text",
      "id": "video_url_webm",
      "label": "رابط الفيديو WebM (اختياري — أسرع تحميلاً)"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "صورة احتياطية (تظهر إذا لم يوجد فيديو)"
    },
    {
      "type": "header",
      "content": "النصوص"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge (النص الصغير)",
      "default": "منتجات مختارة بعناية"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "العنوان الرئيسي",
      "default": "منتجات استثنائية\nبجودة عالمية"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "النص التوضيحي",
      "default": "اكتشف مجموعتنا المختارة بعناية. الدفع عند الاستلام، شحن مجاني لجميع مناطق المملكة."
    },
    {
      "type": "header",
      "content": "الأزرار"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "الزر الرئيسي — نص",
      "default": "ابدأ التسوق"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "الزر الرئيسي — رابط"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "الزر الثانوي — نص",
      "default": "اكتشف المنتجات"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "الزر الثانوي — رابط"
    }
  ],
  "presets": [{ "name": "NOVACART Hero" }]
}
{% endschema %}
