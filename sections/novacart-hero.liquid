{% comment %} NOVACART Hero — World-Class Luxury Brand Hero — Saudi Market {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">

<style>
/* ══════════════════════════════════════════════
   NOVACART HERO — LUXURY BRAND LEVEL
   Prefix: nch-   Scope: #nch-{{ section.id }}
══════════════════════════════════════════════ */
#nch-{{ section.id }},
#nch-{{ section.id }} *,
#nch-{{ section.id }} *::before,
#nch-{{ section.id }} *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ── TOKENS ── */
#nch-{{ section.id }} {
  --c-bg:       #F7F4EE;
  --c-bg2:      #FFFFFF;
  --c-black:    #0A0A0A;
  --c-dark:     #1A1A1A;
  --c-muted:    #7A7572;
  --c-gold:     #B8963E;
  --c-gold-lt:  #D4B96A;
  --c-green:    #15803D;
  --c-green-dk: #0E5F2C;
  --c-border:   rgba(0,0,0,.08);
  --c-card-bg:  rgba(255,255,255,0.72);
  --c-glass-bg: rgba(255,255,255,0.55);
  --font:       'Tajawal', sans-serif;
  font-family:  var(--font);
  direction:    rtl;
}

/* ── SECTION ── */
#nch-{{ section.id }} {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--c-bg);
}

/* ── TEXTURE OVERLAY ── */
#nch-{{ section.id }}::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle at 8% 20%, rgba(184,150,62,.09) 0%, transparent 40%),
    radial-gradient(circle at 92% 80%, rgba(21,128,61,.06) 0%, transparent 40%),
    radial-gradient(circle at 50% 50%, rgba(0,0,0,.015) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* Dot grid texture */
#nch-{{ section.id }}::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(0,0,0,.055) 1px, transparent 1px);
  background-size: 28px 28px;
  pointer-events: none;
  z-index: 0;
  opacity: .5;
}

/* ── CONTAINER ── */
.nch-wrap {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  width: 100%;
  position: relative;
  z-index: 1;
}

/* ── TOPBAR ── */
.nch-topbar {
  width: 100%;
  background: var(--c-black);
  color: rgba(255,255,255,.85);
  font-family: var(--font);
  font-size: .82rem;
  font-weight: 500;
  letter-spacing: .5px;
  text-align: center;
  padding: 10px 16px;
  position: relative;
  z-index: 2;
  direction: rtl;
}
.nch-topbar span { color: var(--c-gold-lt); font-weight: 700; }

/* ── MAIN AREA ── */
.nch-main {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  align-items: center;
  padding: 70px 0 60px;
  position: relative;
  z-index: 1;
}

/* ════════════════════════
   LEFT — TEXT COLUMN
════════════════════════ */
.nch-left {
  padding: 0 20px 0 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
}

/* Brand flag */
.nch-flag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 28px;
  opacity: 0;
  animation: nch-up .7s .05s ease forwards;
}
.nch-flag-line {
  width: 32px;
  height: 2px;
  background: var(--c-gold);
  border-radius: 2px;
}
.nch-flag-text {
  font-size: .75rem;
  font-weight: 700;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--c-gold);
}

/* Headline */
.nch-headline {
  font-size: clamp(2.4rem, 4.2vw, 4rem);
  font-weight: 900;
  line-height: 1.15;
  color: var(--c-black);
  margin-bottom: 24px;
  white-space: pre-line;
  opacity: 0;
  animation: nch-up .8s .15s ease forwards;
}
.nch-headline .nch-hl-accent {
  position: relative;
  display: inline-block;
  color: var(--c-black);
}
.nch-headline .nch-hl-accent::after {
  content: '';
  position: absolute;
  bottom: 4px;
  right: 0;
  left: 0;
  height: 6px;
  background: linear-gradient(90deg, var(--c-gold), var(--c-gold-lt));
  opacity: .28;
  border-radius: 3px;
  z-index: -1;
}

/* Subtitle */
.nch-sub {
  font-size: 1.05rem;
  font-weight: 400;
  line-height: 1.75;
  color: var(--c-muted);
  max-width: 420px;
  margin-bottom: 38px;
  opacity: 0;
  animation: nch-up .8s .25s ease forwards;
}

/* CTA group */
.nch-cta-group {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 36px;
  opacity: 0;
  animation: nch-up .8s .35s ease forwards;
}

/* Primary button */
.nch-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: var(--c-black);
  color: #fff;
  font-family: var(--font);
  font-size: 1rem;
  font-weight: 700;
  padding: 16px 36px;
  border: 2px solid var(--c-black);
  border-radius: 50px;
  text-decoration: none;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: background .25s, color .25s, transform .2s, box-shadow .25s;
  box-shadow: 0 8px 28px rgba(0,0,0,.18);
  letter-spacing: .3px;
}
.nch-btn-primary::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,.12) 0%, transparent 60%);
  pointer-events: none;
}
.nch-btn-primary:hover {
  background: var(--c-dark);
  transform: translateY(-3px);
  box-shadow: 0 16px 44px rgba(0,0,0,.28);
}
.nch-btn-primary .nch-arrow {
  font-size: .9rem;
  transition: transform .25s;
}
.nch-btn-primary:hover .nch-arrow { transform: translateX(-6px); }

/* Secondary button */
.nch-btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  color: var(--c-black);
  font-family: var(--font);
  font-size: 1rem;
  font-weight: 600;
  padding: 16px 28px;
  border: 1.5px solid rgba(0,0,0,.2);
  border-radius: 50px;
  text-decoration: none;
  cursor: pointer;
  transition: border-color .25s, background .25s, transform .2s;
  letter-spacing: .3px;
}
.nch-btn-secondary:hover {
  border-color: var(--c-black);
  background: rgba(0,0,0,.04);
  transform: translateY(-2px);
}

/* Trust pills */
.nch-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 20px;
  opacity: 0;
  animation: nch-up .8s .45s ease forwards;
}
.nch-trust-item {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: .82rem;
  font-weight: 600;
  color: var(--c-muted);
}
.nch-trust-item .nch-ti { font-size: 1rem; }
.nch-trust-divider {
  width: 1px;
  height: 14px;
  background: rgba(0,0,0,.15);
  align-self: center;
}

/* ════════════════════════
   RIGHT — 7-PRODUCT CAROUSEL
════════════════════════ */
.nch-right {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16px;
  padding: 52px 0 16px;
  opacity: 0;
  animation: nch-fade .9s .2s ease forwards;
}

/* Float keyframes (kept for chips) */
@keyframes nch-float-1 {
  0%,100% { transform: translateY(0) rotate(-.5deg); }
  50%      { transform: translateY(-10px) rotate(.5deg); }
}
@keyframes nch-float-2 {
  0%,100% { transform: translateY(0) rotate(.6deg); }
  50%      { transform: translateY(-8px) rotate(-.4deg); }
}
@keyframes nch-float-3 {
  0%,100% { transform: translateY(0) rotate(-.3deg); }
  50%      { transform: translateY(-9px) rotate(.6deg); }
}

/* ── CAROUSEL WRAPPER ── */
.nch-carousel {
  overflow: hidden;
  padding: 12px 4px 16px;   /* room for shadow + scale overflow */
  position: relative;
  cursor: grab;
  user-select: none;
  -webkit-user-select: none;
}
.nch-carousel:active { cursor: grabbing; }

.nch-cr-track {
  display: flex;
  gap: 14px;
  transition: transform .52s cubic-bezier(.4,0,.2,1);
  will-change: transform;
}

/* ── CAROUSEL CARD ── */
.nch-cr-card {
  flex: 0 0 162px;
  background: rgba(255,255,255,.82);
  backdrop-filter: blur(16px) saturate(1.4);
  -webkit-backdrop-filter: blur(16px) saturate(1.4);
  border: 1px solid rgba(255,255,255,.88);
  border-radius: 20px;
  box-shadow:
    0 2px 8px rgba(0,0,0,.05),
    0 8px 28px rgba(0,0,0,.08),
    inset 0 1px 0 rgba(255,255,255,.9);
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: transform .32s ease, box-shadow .32s ease;
  cursor: pointer;
  display: block;
  position: relative;
}
.nch-cr-card:hover {
  transform: translateY(-7px) !important;
  box-shadow:
    0 6px 16px rgba(0,0,0,.08),
    0 20px 50px rgba(0,0,0,.13),
    inset 0 1px 0 rgba(255,255,255,.9);
}

/* Center / featured card */
.nch-cr-card.nch-cr-center {
  transform: scale(1.07);
  box-shadow:
    0 6px 20px rgba(0,0,0,.10),
    0 20px 50px rgba(0,0,0,.12),
    0 0 0 1.5px rgba(184,150,62,.38),
    inset 0 1px 0 rgba(255,255,255,.9);
  z-index: 2;
}
.nch-cr-card.nch-cr-center:hover {
  transform: scale(1.07) translateY(-7px) !important;
}

/* Card image */
.nch-cr-img-wrap {
  position: relative;
  overflow: hidden;
  height: 148px;
}
.nch-cr-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .45s ease;
}
.nch-cr-card:hover .nch-cr-img-wrap img { transform: scale(1.06); }
.nch-cr-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.8rem;
  background: linear-gradient(135deg, #F0EBE1, #E4DDD0);
}

/* Badge on image */
.nch-cr-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  background: #C0392B;
  color: #fff;
  font-family: var(--font);
  font-size: .68rem;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 50px;
  letter-spacing: .3px;
  line-height: 1.4;
  z-index: 2;
}
.nch-cr-badge.gold {
  background: var(--c-gold);
  color: #fff;
}

/* Card body */
.nch-cr-body {
  padding: 11px 13px 13px;
  background: #fff;
}
.nch-cr-cat {
  font-size: .62rem;
  font-weight: 700;
  letter-spacing: 1.4px;
  text-transform: uppercase;
  color: var(--c-gold);
  margin-bottom: 4px;
}
.nch-cr-name {
  font-size: .85rem;
  font-weight: 700;
  color: var(--c-black);
  line-height: 1.3;
  margin-bottom: 9px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.nch-cr-prices {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}
.nch-cr-price-wrap { display: flex; flex-direction: column; gap: 1px; }
.nch-cr-old {
  font-size: .72rem;
  color: var(--c-muted);
  text-decoration: line-through;
  line-height: 1;
}
.nch-cr-now {
  font-size: .98rem;
  font-weight: 900;
  color: var(--c-black);
  line-height: 1;
}
.nch-cr-now small {
  font-size: .68rem;
  font-weight: 400;
  color: var(--c-muted);
}
.nch-cr-arrow {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--c-black);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .78rem;
  flex-shrink: 0;
  transition: background .2s, transform .2s;
}
.nch-cr-card:hover .nch-cr-arrow {
  background: var(--c-green);
  transform: scale(1.1);
}

/* ── DOTS ── */
.nch-cr-dots {
  display: flex;
  justify-content: center;
  gap: 7px;
  padding: 4px 0 0;
}
.nch-cr-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(0,0,0,.18);
  cursor: pointer;
  transition: all .3s ease;
  border: none;
  padding: 0;
}
.nch-cr-dot.active {
  width: 22px;
  border-radius: 4px;
  background: var(--c-gold);
}

/* ── Glass chip cards ── */
.nch-chip {
  position: absolute;
  background: var(--c-glass-bg);
  backdrop-filter: blur(16px) saturate(1.5);
  -webkit-backdrop-filter: blur(16px) saturate(1.5);
  border: 1px solid rgba(255,255,255,.9);
  border-radius: 50px;
  padding: 10px 18px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font);
  font-size: .82rem;
  font-weight: 700;
  color: var(--c-dark);
  box-shadow: 0 8px 28px rgba(0,0,0,.10);
  white-space: nowrap;
  z-index: 4;
}

/* Stars chip */
.nch-chip-stars {
  top: 160px;
  left: 10px;
  animation: nch-float-2 4.5s 2s ease-in-out infinite;
}
.nch-chip-stars .nch-chip-star { color: #F59E0B; font-size: .9rem; letter-spacing: 1px; }

/* Sold chip */
.nch-chip-sold {
  bottom: 160px;
  left: 40px;
  animation: nch-float-3 5.5s .5s ease-in-out infinite;
}
.nch-chip-sold .nch-chip-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--c-green);
  box-shadow: 0 0 0 3px rgba(21,128,61,.2);
  animation: nch-pulse 1.6s infinite;
  flex-shrink: 0;
}

/* New badge chip */
.nch-chip-new {
  top: -16px;
  left: 30%;
  animation: nch-float-1 4s 1s ease-in-out infinite;
}
.nch-chip-new .nch-chip-dot-gold {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--c-gold);
  flex-shrink: 0;
}

@keyframes nch-pulse {
  0%,100% { box-shadow: 0 0 0 3px rgba(21,128,61,.2); }
  50%      { box-shadow: 0 0 0 6px rgba(21,128,61,0); }
}

/* ── BACKGROUND GLOW behind cards ── */
.nch-right-glow {
  position: absolute;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(184,150,62,.12) 0%, transparent 65%);
  top: 50%;
  right: 50%;
  transform: translate(50%,-50%);
  pointer-events: none;
  z-index: 0;
}

/* ── SCROLL CARET ── */
.nch-scroll {
  position: absolute;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  color: var(--c-muted);
  font-family: var(--font);
  font-size: .7rem;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  z-index: 2;
  opacity: 0;
  animation: nch-up .8s 1s ease forwards;
}
.nch-scroll-line {
  width: 1px;
  height: 40px;
  background: linear-gradient(to bottom, var(--c-gold), transparent);
  animation: nch-scroll-ani 1.8s ease-in-out infinite;
}
@keyframes nch-scroll-ani {
  0%,100% { transform: scaleY(1); opacity: .8; }
  50%      { transform: scaleY(.5); opacity: .3; }
}

/* ── ENTRY ANIMATIONS ── */
@keyframes nch-up {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes nch-fade {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ═══════════════════════════════════
   STICKY MOBILE BUY
═══════════════════════════════════ */
#nch-sticky-{{ section.id }} {
  display: none;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  border-top: 1.5px solid rgba(0,0,0,.08);
  padding: 12px 16px;
  z-index: 999;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-shadow: 0 -4px 24px rgba(0,0,0,.10);
  font-family: var(--font);
  direction: rtl;
}
#nch-sticky-{{ section.id }} .nch-st-label {
  font-size: .8rem;
  color: var(--c-muted);
  margin-bottom: 2px;
}
#nch-sticky-{{ section.id }} .nch-st-name {
  font-size: 1rem;
  font-weight: 800;
  color: var(--c-black);
}
#nch-sticky-{{ section.id }} .nch-btn-primary {
  font-size: .9rem;
  padding: 12px 26px;
  white-space: nowrap;
}

/* ═══════════════════════════════════
   RESPONSIVE
═══════════════════════════════════ */
@media (max-width: 980px) {
  .nch-main {
    grid-template-columns: 1fr;
    padding: 40px 0 100px;
    gap: 40px;
  }
  .nch-left { align-items: center; text-align: center; }
  .nch-sub { text-align: center; }
  .nch-flag { justify-content: center; }
  .nch-right { padding-top: 44px; }
  .nch-cr-card { flex: 0 0 148px; }
  .nch-cr-img-wrap { height: 130px; }
  .nch-trust { justify-content: center; }
  .nch-cta-group { justify-content: center; }
  #nch-sticky-{{ section.id }} { display: flex; }
}

@media (max-width: 600px) {
  #nch-{{ section.id }} { min-height: auto; }
  .nch-headline { font-size: 2rem; }
  .nch-sub { font-size: .95rem; }
  /* Mobile carousel: 2.3 cards visible for swipe discovery */
  .nch-cr-card { flex: 0 0 calc(45vw - 14px); }
  .nch-cr-img-wrap { height: 120px; }
  .nch-cr-card.nch-cr-center { transform: scale(1.04); }
  .nch-cr-card.nch-cr-center:hover { transform: scale(1.04) translateY(-5px) !important; }
  .nch-chip-sold { display: none; }
  .nch-scroll { display: none; }
  .nch-trust-divider { display: none; }
  .nch-wrap { padding: 0 18px; }
}
</style>

<!-- STICKY MOBILE -->
<div id="nch-sticky-{{ section.id }}">
  <div>
    <div class="nch-st-label">اكتشف المجموعة الكاملة</div>
    <div class="nch-st-name">NOVACART</div>
  </div>
  <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="nch-btn-primary">
    ابدأ التسوق <span class="nch-arrow">←</span>
  </a>
</div>

<div id="nch-{{ section.id }}">

  <!-- TOP BAR -->
  <div class="nch-topbar">
    ✦ &nbsp;شحن مجاني لجميع مناطق المملكة &nbsp;|&nbsp; الدفع عند الاستلام &nbsp;|&nbsp; <span>عروض حصرية هذا الأسبوع</span>&nbsp; ✦
  </div>

  <!-- MAIN GRID -->
  <div class="nch-main nch-wrap">

    <!-- ══ LEFT ══ -->
    <div class="nch-left">

      <!-- Flag -->
      <div class="nch-flag">
        <div class="nch-flag-line"></div>
        <span class="nch-flag-text">
          {%- if section.settings.badge != blank -%}{{ section.settings.badge }}{%- else -%}منتجات مختارة بعناية{%- endif -%}
        </span>
      </div>

      <!-- Headline -->
      <h1 class="nch-headline">
        {%- if section.settings.title != blank -%}
          {{ section.settings.title }}
        {%- else -%}
          اكتشف ما يستحق<br><span class="nch-hl-accent">اهتمامك حقاً</span>
        {%- endif -%}
      </h1>

      <!-- Subtitle -->
      <p class="nch-sub">
        {%- if section.settings.subtitle != blank -%}
          {{ section.settings.subtitle }}
        {%- else -%}
          منتجات استثنائية بجودة عالمية، تُوصَّل إلى باب منزلك في المملكة العربية السعودية. الدفع عند الاستلام، الشحن مجاناً.
        {%- endif -%}
      </p>

      <!-- CTAs -->
      <div class="nch-cta-group">
        <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="nch-btn-primary" id="nch-primary-btn-{{ section.id }}">
          {%- if section.settings.btn1_label != blank -%}{{ section.settings.btn1_label }}{%- else -%}ابدأ التسوق{%- endif -%}
          <span class="nch-arrow">←</span>
        </a>
        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_url | default: '/collections/all' }}" class="nch-btn-secondary">
            {{ section.settings.btn2_label }}
          </a>
        {%- else -%}
          <a href="/collections/all" class="nch-btn-secondary">اكتشف المنتجات</a>
        {%- endif -%}
      </div>

      <!-- Trust -->
      <div class="nch-trust">
        <span class="nch-trust-item"><span class="nch-ti">🚚</span> شحن سريع</span>
        <span class="nch-trust-divider"></span>
        <span class="nch-trust-item"><span class="nch-ti">💳</span> الدفع عند الاستلام</span>
        <span class="nch-trust-divider"></span>
        <span class="nch-trust-item"><span class="nch-ti">🔒</span> دفع آمن</span>
        <span class="nch-trust-divider"></span>
        <span class="nch-trust-item"><span class="nch-ti">⭐</span> آلاف العملاء</span>
        <span class="nch-trust-divider"></span>
        <span class="nch-trust-item"><span class="nch-ti">🛡</span> ضمان الجودة</span>
      </div>

    </div><!-- /left -->

    <!-- ══ RIGHT — 7-PRODUCT CAROUSEL ══ -->
    <div class="nch-right">

      <!-- Background glow -->
      <div class="nch-right-glow"></div>

      <!-- Glass chip: Stars -->
      <div class="nch-chip nch-chip-stars">
        <span class="nch-chip-star">★★★★★</span>
        <span>4.9 / 5</span>
      </div>

      <!-- Glass chip: Live orders -->
      <div class="nch-chip nch-chip-sold">
        <span class="nch-chip-dot"></span>
        <span id="nch-live-{{ section.id }}">47</span> طلب الآن
      </div>

      <!-- Glass chip: New -->
      <div class="nch-chip nch-chip-new">
        <span class="nch-chip-dot-gold"></span>
        <span>وصل حديثاً ✦</span>
      </div>

      <!-- ── CAROUSEL ── -->
      <div class="nch-carousel" id="nch-cr-{{ section.id }}">
        <div class="nch-cr-track" id="nch-cr-track-{{ section.id }}">

          {%- assign p_ids   = '1,2,3,4,5,6,7' | split: ',' -%}
          {%- assign p_emojis = '🛒,✨,🎁,⭐,🔥,💎,🎯' | split: ',' -%}
          {%- assign p_cats   = 'منتج مميز,الأكثر مبيعاً,عرض خاص,وصل حديثاً,الأكثر طلباً,مجموعة فاخرة,اختيار المحرر' | split: ',' -%}

          {%- for pid in p_ids -%}
            {%- assign img_key   = 'product_image_'   | append: pid -%}
            {%- assign title_key = 'product_title_'   | append: pid -%}
            {%- assign price_key = 'product_price_'   | append: pid -%}
            {%- assign old_key   = 'product_old_'     | append: pid -%}
            {%- assign badge_key = 'product_badge_'   | append: pid -%}
            {%- assign url_key   = 'product_url_'     | append: pid -%}
            {%- assign idx0      = forloop.index0 -%}

            <a
              href="{{ section.settings[url_key] | default: '/collections/all' }}"
              class="nch-cr-card"
              aria-label="{{ section.settings[title_key] }}"
              data-idx="{{ idx0 }}"
            >
              <div class="nch-cr-img-wrap">
                {%- if section.settings[badge_key] != blank -%}
                  <span class="nch-cr-badge">{{ section.settings[badge_key] }}</span>
                {%- endif -%}
                {%- if section.settings[img_key] != blank -%}
                  {{ section.settings[img_key] | image_url: width: 400 | image_tag:
                      loading: 'lazy',
                      alt: section.settings[title_key],
                      class: 'nch-cr-card-img' }}
                {%- else -%}
                  <div class="nch-cr-placeholder">{{ p_emojis[idx0] }}</div>
                {%- endif -%}
              </div>
              <div class="nch-cr-body">
                <div class="nch-cr-cat">{{ p_cats[idx0] }}</div>
                <div class="nch-cr-name">
                  {%- if section.settings[title_key] != blank -%}
                    {{ section.settings[title_key] }}
                  {%- else -%}
                    المنتج {{ pid }}
                  {%- endif -%}
                </div>
                <div class="nch-cr-prices">
                  <div class="nch-cr-price-wrap">
                    {%- if section.settings[old_key] != blank -%}
                      <span class="nch-cr-old">{{ section.settings[old_key] }} ريال</span>
                    {%- endif -%}
                    <span class="nch-cr-now">
                      {{ section.settings[price_key] | default: '—' }} <small>ريال</small>
                    </span>
                  </div>
                  <span class="nch-cr-arrow">←</span>
                </div>
              </div>
            </a>

          {%- endfor -%}

        </div><!-- /track -->
      </div><!-- /carousel -->

      <!-- Dots -->
      <div class="nch-cr-dots" id="nch-cr-dots-{{ section.id }}">
        <button class="nch-cr-dot active" data-dot="0" aria-label="1"></button>
        <button class="nch-cr-dot" data-dot="1" aria-label="2"></button>
        <button class="nch-cr-dot" data-dot="2" aria-label="3"></button>
        <button class="nch-cr-dot" data-dot="3" aria-label="4"></button>
        <button class="nch-cr-dot" data-dot="4" aria-label="5"></button>
      </div>

    </div><!-- /right -->
  </div><!-- /main -->

  <!-- Scroll caret -->
  <div class="nch-scroll">
    <div class="nch-scroll-line"></div>
    <span>استكشف</span>
  </div>

</div><!-- /section -->

<script>
(function(){
  /* ── Live counter ── */
  var el = document.getElementById('nch-live-{{ section.id }}');
  if(el){
    var v = parseInt(el.textContent);
    setInterval(function(){
      v += Math.random() > .5 ? 1 : -1;
      v = Math.max(30, Math.min(90, v));
      el.textContent = v;
    }, 3800);
  }

  /* ── Sticky hide ── */
  var sec    = document.getElementById('nch-{{ section.id }}');
  var sticky = document.getElementById('nch-sticky-{{ section.id }}');
  if(sec && sticky){
    var io = new IntersectionObserver(function(e){
      sticky.style.display = e[0].isIntersecting ? 'none' : '';
    }, { threshold: .05 });
    io.observe(sec);
  }

  /* ── Ripple ── */
  var btn = document.getElementById('nch-primary-btn-{{ section.id }}');
  if(btn){
    btn.addEventListener('click', function(e){
      var r = document.createElement('span');
      var rect = btn.getBoundingClientRect();
      var sz = Math.max(rect.width, rect.height);
      r.style.cssText = [
        'position:absolute','border-radius:50%','pointer-events:none',
        'width:'+sz+'px','height:'+sz+'px',
        'top:'+(e.clientY-rect.top-sz/2)+'px',
        'right:'+(rect.right-e.clientX-sz/2)+'px',
        'background:rgba(255,255,255,.22)',
        'transform:scale(0)','animation:nch_rip .55s ease forwards'
      ].join(';');
      btn.appendChild(r);
      setTimeout(function(){ r.remove(); }, 600);
    });
  }
  if(!document.getElementById('nch-rip-style')){
    var s = document.createElement('style');
    s.id = 'nch-rip-style';
    s.textContent = '@keyframes nch_rip{to{transform:scale(3.5);opacity:0}}';
    document.head.appendChild(s);
  }

  /* ══════════════════════════════════════
     7-PRODUCT CAROUSEL
  ══════════════════════════════════════ */
  var carousel  = document.getElementById('nch-cr-{{ section.id }}');
  var track     = document.getElementById('nch-cr-track-{{ section.id }}');
  var dotsWrap  = document.getElementById('nch-cr-dots-{{ section.id }}');
  if(!carousel || !track) return;

  var CARDS      = track.querySelectorAll('.nch-cr-card');
  var TOTAL      = CARDS.length;           // 7
  var VISIBLE    = 3;                      // cards shown at once
  var MAX_OFFSET = TOTAL - VISIBLE;        // 4  (offsets 0-4)
  var offset     = 0;
  var autoTimer  = null;
  var GAP        = 14;                     // matches CSS gap

  /* ── measure a card width after layout ── */
  function cardW(){
    return CARDS[0] ? CARDS[0].getBoundingClientRect().width : 162;
  }

  /* ── apply offset + highlight center card ── */
  function goTo(n, animate){
    offset = Math.max(0, Math.min(MAX_OFFSET, n));
    var step = cardW() + GAP;
    /* RTL: carousel track slides in positive X direction */
    track.style.transition = animate === false ? 'none' : '';
    track.style.transform  = 'translateX(' + (offset * step) + 'px)';

    /* center card = offset + 1, clamped to valid index */
    var centerIdx = Math.min(offset + 1, TOTAL - 1);
    CARDS.forEach(function(c, i){
      c.classList.toggle('nch-cr-center', i === centerIdx);
    });

    /* dots */
    if(dotsWrap){
      dotsWrap.querySelectorAll('.nch-cr-dot').forEach(function(d){
        d.classList.toggle('active', parseInt(d.dataset.dot) === offset);
      });
    }
  }

  /* ── auto-advance ── */
  function startAuto(){
    stopAuto();
    autoTimer = setInterval(function(){
      goTo(offset < MAX_OFFSET ? offset + 1 : 0);
    }, 4200);
  }
  function stopAuto(){ clearInterval(autoTimer); }

  /* ── dots click ── */
  if(dotsWrap){
    dotsWrap.querySelectorAll('.nch-cr-dot').forEach(function(d){
      d.addEventListener('click', function(){
        stopAuto();
        goTo(parseInt(this.dataset.dot));
        startAuto();
      });
    });
  }

  /* ── Pointer drag / swipe ── */
  var dragStart = null, dragStartOffset = null, dragging = false;
  carousel.addEventListener('pointerdown', function(e){
    dragStart = e.clientX;
    dragStartOffset = offset;
    dragging = false;
    stopAuto();
    carousel.setPointerCapture(e.pointerId);
  });
  carousel.addEventListener('pointermove', function(e){
    if(dragStart === null) return;
    var dx = e.clientX - dragStart;
    if(Math.abs(dx) > 6) dragging = true;
    if(dragging){
      var step = cardW() + GAP;
      /* RTL inversion: dragging right (positive dx) = going to previous */
      var virtual = dragStartOffset - dx / step;
      track.style.transition = 'none';
      track.style.transform  = 'translateX(' + (Math.max(0, Math.min(MAX_OFFSET, virtual)) * step) + 'px)';
    }
  });
  carousel.addEventListener('pointerup', function(e){
    if(dragStart === null) return;
    var dx = e.clientX - dragStart;
    dragStart = null;
    if(dragging){
      /* RTL: drag right = prev, drag left = next */
      if(dx > 50)       goTo(dragStartOffset - 1);
      else if(dx < -50) goTo(dragStartOffset + 1);
      else              goTo(dragStartOffset);
    }
    dragging = false;
    startAuto();
  });
  /* Prevent card link navigation when it was a drag */
  carousel.addEventListener('click', function(e){
    if(dragging) e.preventDefault();
  }, true);

  /* ── pause on hover ── */
  carousel.addEventListener('mouseenter', stopAuto);
  carousel.addEventListener('mouseleave', startAuto);

  /* ── init ── */
  goTo(0, false);
  startAuto();
})();
</script>

