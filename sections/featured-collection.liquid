{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign products_to_display = section.settings.products_to_show
-%}

<div class="collection section-{{ section.id }}-padding isolate">
  <div class="collection__title page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="collection__eyebrow">{{ section.settings.eyebrow | upcase }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="collection__heading h1">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p class="collection__description">{{ section.settings.description | escape }}</p>
    {%- endif -%}
  </div>

  {%- if section.settings.collection == blank -%}
    <div class="collection__grid page-width grid grid--{{ section.settings.columns_desktop }}-col">
      {%- for i in (1..products_to_display) -%}
        <div class="grid__item">
          {%- render 'card-product', card_product: nil, placeholder_index: i -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="collection__grid page-width grid grid--{{ section.settings.columns_desktop }}-col">
      {%- for product in section.settings.collection.products limit: products_to_display -%}
        <div class="grid__item">
          {%- render 'card-product', card_product: product -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_view_all and section.settings.collection != blank -%}
    <div class="collection__view-all center">
      <a href="{{ section.settings.collection.url }}" class="button button--secondary">
        {{ section.settings.view_all_label | default: 'Voir tout' }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Collection en vedette",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texte au-dessus du titre",
      "default": "Nouvelle Arrivée"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Notre Collection"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Produits à afficher"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Colonnes (bureau)"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Afficher 'Voir tout'"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "default": "Voir toute la collection",
      "label": "Texte du bouton"
    }
  ],
  "presets": [
    {
      "name": "Collection en vedette"
    }
  ]
}
{% endschema %}
