<script>
(function() {
  /* ---- Variant Switcher ---- */
  var variants    = JSON.parse(document.getElementById('ow-variants-json').textContent);
  var optionNames = JSON.parse(document.getElementById('ow-options-json').textContent);
  var form        = document.getElementById('ow-product-form');
  var formBottom  = document.getElementById('ow-product-form-bottom');
  var variantId   = document.getElementById('ow-variant-id');
  var variantIdB  = document.getElementById('ow-variant-id-bottom');
  var priceEl     = document.getElementById('ow-price-sale');
  var priceOrig   = document.getElementById('ow-price-orig');
  var priceSave   = document.getElementById('ow-price-save');
  var submitBtn   = document.getElementById('ow-submit-btn');
  var submitLabel = document.getElementById('ow-submit-label');

  function formatMoney(cents) {
    return (cents / 100).toFixed(2).replace(/\.00$/, '') + ' ريال';
  }

  function getSelectedVariant() {
    if (!form) return null;
    var selected = optionNames.map(function(name) {
      var el = form.querySelector('input[name="' + CSS.escape(name) + '"]:checked');
      return el ? el.value : null;
    });
    return variants.find(function(v) {
      return v.options.every(function(opt, i) { return opt === selected[i]; });
    });
  }

  function updateVariant() {
    var v = getSelectedVariant();
    if (!v) return;

    if (variantId) variantId.value = v.id;
    if (variantIdB) variantIdB.value = v.id;

    /* Price */
    if (v.compare_at_price && v.compare_at_price > v.price) {
      var pct = Math.round((v.compare_at_price - v.price) * 100 / v.compare_at_price);
      if (priceEl) priceEl.textContent = formatMoney(v.price);
      if (priceOrig) { priceOrig.textContent = formatMoney(v.compare_at_price); priceOrig.style.display = ''; }
      if (priceSave) { priceSave.textContent = 'وفر ' + pct + '% اليوم فقط'; priceSave.style.display = ''; }
    } else {
      if (priceEl) priceEl.textContent = formatMoney(v.price);
      if (priceOrig) priceOrig.style.display = 'none';
      if (priceSave) priceSave.style.display = 'none';
    }

    /* Availability */
    if (submitBtn) {
      submitBtn.disabled = !v.available;
      submitBtn.style.opacity = v.available ? '1' : '0.5';
    }
    if (submitLabel) {
      submitLabel.textContent = v.available ? '⌚ اطلب الآن — الدفع عند الاستلام' : 'نفدت الكمية';
    }

    /* Image */
    if (v.featured_image) {
      var img = document.getElementById('ow-main-img');
      if (img) img.src = v.featured_image.src;
    }

    /* EasySell event */
    document.dispatchEvent(new CustomEvent('variant:change', { detail: { variant: v } }));
  }

  if (form) {
    form.querySelectorAll('input[type="radio"]').forEach(function(r) {
      r.addEventListener('change', updateVariant);
    });
    updateVariant();
  }

  /* ---- Countdown ---- */
  var endTime = Date.now() + (2 * 3600 + 47 * 60 + 33) * 1000;
  function updateCountdown() {
    var diff = Math.max(0, Math.floor((endTime - Date.now()) / 1000));
    var h = Math.floor(diff / 3600);
    var m = Math.floor((diff % 3600) / 60);
    var s = diff % 60;
    var hEl = document.getElementById('ow-cd-h');
    var mEl = document.getElementById('ow-cd-m');
    var sEl = document.getElementById('ow-cd-s');
    if (hEl) hEl.textContent = String(h).padStart(2, '0');
    if (mEl) mEl.textContent = String(m).padStart(2, '0');
    if (sEl) sEl.textContent = String(s).padStart(2, '0');
    if (diff > 0) setTimeout(updateCountdown, 1000);
  }
  updateCountdown();

  /* ---- Social Proof Toast ---- */
  var toastNames = [
    ['م.العتيبي', 'طلب للتو من الرياض'],
    ['أ.الشمري', 'طلب للتو من جدة'],
    ['ف.السهلي', 'طلب للتو من الدمام'],
    ['خ.المطيري', 'طلب للتو من مكة المكرمة'],
    ['س.الغامدي', 'طلب للتو من المدينة المنورة'],
    ['ع.الدوسري', 'طلب للتو من الطائف'],
    ['ن.الزهراني', 'طلب للتو من أبها'],
    ['ب.القحطاني', 'طلب للتو من تبوك'],
  ];
  var toastEl = document.getElementById('ow-toast');
  var toastName = document.getElementById('ow-toast-name');
  var toastMsg = document.getElementById('ow-toast-msg');
  var toastIdx = 0;

  function showToast() {
    var entry = toastNames[toastIdx % toastNames.length];
    toastIdx++;
    if (toastName) toastName.textContent = entry[0] + ' ';
    if (toastMsg) toastMsg.textContent = entry[1];
    if (toastEl) {
      toastEl.classList.add('visible');
      setTimeout(function() { toastEl.classList.remove('visible'); }, 3500);
    }
    setTimeout(showToast, Math.random() * 8000 + 6000);
  }
  setTimeout(showToast, 4000);

  /* ---- Sticky hide on form visible ---- */
  var sticky = document.getElementById('ow-sticky');
  if (sticky) {
    var hero = document.querySelector('.ow-order-card');
    if (hero && 'IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function(entries) {
        sticky.style.display = entries[0].isIntersecting ? 'none' : 'flex';
      }, { threshold: 0.3 });
      obs.observe(hero);
    }
  }
})();
</script>

