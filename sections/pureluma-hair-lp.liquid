  <button class="pl-sticky__btn" onclick="plScrollOrder(this)">🛒 اطلبي الآن</button>
</div>

<script>
(function(){
  // Loader
  window.addEventListener('load',function(){
    setTimeout(function(){document.getElementById('pl-loader').classList.add('gone');},600);
  });

  // Progress
  var pb=document.getElementById('pl-progress');
  window.addEventListener('scroll',function(){
    var max=document.body.scrollHeight-window.innerHeight;
    if(pb&&max>0)pb.style.transform='scaleX('+(window.scrollY/max)+')';
  },{passive:true});

  // Scroll anims
  var obs=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target);}});
  },{threshold:0.1,rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.pl-anim').forEach(function(el){obs.observe(el);});

  // Toast
  var toasts=[
    {n:'فاطمة من الدار البيضاء',t:'اشترت سيروم PURELUMA 💚'},
    {n:'خديجة من الرباط',t:'أضافت المنتج للسلة ✨'},
    {n:'مريم من مراكش',t:'طلبت للمرة الثالثة 🌿'},
    {n:'سكينة من طنجة',t:'اشترت للتو سيروم PURELUMA'},
    {n:'لطيفة من أكادير',t:'قيّمت المنتج 5 نجوم ⭐'},
    {n:'هند من فاس',t:'طلبت قطعتين بخصم 🎁'}
  ];
  var tEl=document.getElementById('pl-toast');
  var tN=document.getElementById('pl-toast-name');
  var tT=tEl&&tEl.querySelector('span+div .pl-toast__txt');
  var ti=0;
  function showToast(){
    if(!tEl)return;
    var t=toasts[ti%toasts.length]; ti++;
    tN.textContent=t.n;
    tEl.classList.add('show');
    setTimeout(function(){tEl.classList.remove('show');},3500);
    setTimeout(showToast,9000+Math.random()*5000);
  }
  setTimeout(showToast,3000);

  // Viewers
  var vEl=document.getElementById('pl-viewers');
  if(vEl){setInterval(function(){var c=parseInt(vEl.textContent);vEl.textContent=Math.max(14,Math.min(32,c+(Math.random()>.5?1:-1)));},5000);}

  // Countdown
  var end=Date.now()+(23*3600+59*60+59)*1000;
  function cdUpdate(){
    var d=Math.max(0,end-Date.now());
    var h=Math.floor(d/3600000),m=Math.floor(d%3600000/60000),s=Math.floor(d%60000/1000);
    var hEl=document.getElementById('pl-cdh'),mEl=document.getElementById('pl-cdm'),sEl=document.getElementById('pl-cds');
    if(hEl)hEl.textContent=String(h).padStart(2,'0');
    if(mEl)mEl.textContent=String(m).padStart(2,'0');
    if(sEl)sEl.textContent=String(s).padStart(2,'0');
  }
  setInterval(cdUpdate,1000); cdUpdate();

  // Sticky
  var sticky=document.getElementById('pl-sticky'),ord=document.getElementById('pl-order');
  if(sticky&&ord){
    window.addEventListener('scroll',function(){
      var r=ord.getBoundingClientRect();
      sticky.style.display=r.top>window.innerHeight?'flex':'none';
    },{passive:true});
  }

  // Exit intent
  var exitShown=false;
  document.addEventListener('mouseleave',function(e){
    if(e.clientY<10&&!exitShown){
      exitShown=true;
      document.getElementById('pl-exit-overlay').classList.add('open');
    }
  });
  // Mobile scroll back = exit intent
  var lastScroll=0;
  window.addEventListener('scroll',function(){
    var cur=window.scrollY;
    if(cur<50&&lastScroll>300&&!exitShown){exitShown=true;setTimeout(function(){document.getElementById('pl-exit-overlay').classList.add('open');},400);}
    lastScroll=cur;
  },{passive:true});

  // Ripple
  document.querySelectorAll('.pl-btn-primary').forEach(function(btn){
    btn.addEventListener('click',function(e){
      var r=document.createElement('span');r.className='pl-ripple';
      var rect=btn.getBoundingClientRect();
      r.style.left=(e.clientX-rect.left)+'px';r.style.top=(e.clientY-rect.top)+'px';
      btn.appendChild(r);setTimeout(function(){r.remove();},700);
    });
  });
})();

function plScrollOrder(){
  var el=document.getElementById('pl-order');
  if(el)el.scrollIntoView({behavior:'smooth',block:'start'});
}

function plFaq(btn){
  var item=btn.closest('.pl-faq-item');
  var open=item.classList.contains('open');
  document.querySelectorAll('.pl-faq-item.open').forEach(function(i){i.classList.remove('open');});
  if(!open)item.classList.add('open');
}

function plLB(src){
  var lb=document.getElementById('pl-lb'),img=document.getElementById('pl-lb-img');
  if(lb&&img){img.src=src;lb.classList.add('open');}
}
</script>

