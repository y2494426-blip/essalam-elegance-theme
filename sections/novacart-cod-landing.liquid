{% comment %}
==================================================================================
NOVACART — صفحة هبوط منتج واحد (One Product Landing Page)
منتج: مصباح فني بالشحن اللاسلكي
السوق: السعودية 🇸🇦 | اللغة: عربي RTL | العملة: ر.س
COD Engine: EasySell App Block
Theme: Shopify OS 2.0 compatible
==================================================================================
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}

{{ 'https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap' | stylesheet_tag }}

<script type="application/json" id="nv-variants-json">{{ product.variants | json }}</script>
<script type="application/json" id="nv-options-json">{{ product.options | json }}</script>

<div class="nv-page" dir="rtl" lang="ar">

<style>
  .nv-page{
    --nv-bg:#F7F4EF;
    --nv-primary:#111111;
    --nv-secondary:#666666;
    --nv-btn:#0E7A3E;
    --nv-btn-hover:#0A5F31;
    --nv-accent:#D4AF37;
    --nv-white:#FFFFFF;
    --nv-radius:18px;
    --nv-shadow: 0 12px 32px rgba(17,17,17,0.08);
    --nv-shadow-lg: 0 24px 60px rgba(17,17,17,0.12);
    font-family: 'Cairo', sans-serif;
    background: var(--nv-bg);
    color: var(--nv-primary);
    overflow-x: hidden;
  }
  .nv-page *{ box-sizing: border-box; }
  .nv-page img{ max-width:100%; display:block; }
  .nv-container{ max-width:1180px; margin:0 auto; padding:0 20px; }
  .nv-section{ padding: 72px 0; }
  .nv-section--tight{ padding: 48px 0; }

  .nv-eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-size:13px; font-weight:700; letter-spacing:.3px;
    color: var(--nv-btn); background: rgba(14,122,62,.08);
    padding:6px 16px; border-radius: 999px; margin-bottom:14px;
  }
  .nv-h2{ font-size: clamp(26px,4vw,40px); font-weight:800; margin:0 0 12px; line-height:1.3;}
  .nv-sub{ color:var(--nv-secondary); font-size:16px; max-width:640px; margin:0 auto; line-height:1.9;}
  .nv-center{ text-align:center; }

  /* fade animations */
  .nv-fade-up{ opacity:0; transform: translateY(28px); transition: opacity .7s ease, transform .7s ease; }
  .nv-fade-up.nv-in{ opacity:1; transform:none; }
  .nv-fade-left{ opacity:0; transform: translateX(28px); transition: opacity .7s ease, transform .7s ease; }
  .nv-fade-left.nv-in{ opacity:1; transform:none; }

  /* ============ HERO ============ */
  .nv-hero{ padding: 28px 0 56px; position:relative; }
  .nv-hero-grid{
    display:grid; grid-template-columns: 1fr 1fr; gap:56px; align-items:start;
  }
  .nv-hero-media{ position:relative; border-radius: var(--nv-radius); overflow:hidden; }
  .nv-hero-media::before{
    content:""; position:absolute; inset:-30%; z-index:0;
    background: radial-gradient(circle at 50% 50%, rgba(212,175,55,.20), transparent 60%);
    animation: nvGlow 6s ease-in-out infinite;
  }
  @keyframes nvGlow{ 0%,100%{ opacity:.6; transform:scale(1);} 50%{ opacity:1; transform:scale(1.08);} }
  .nv-hero-media img{ position:relative; z-index:1; border-radius: var(--nv-radius); }
  .nv-badge-float{
    position:absolute; z-index:2; background: var(--nv-white); box-shadow: var(--nv-shadow);
    border-radius: 999px; padding:8px 14px; font-size:12px; font-weight:700;
    display:flex; align-items:center; gap:6px; animation: nvFloat 3.4s ease-in-out infinite;
  }
  .nv-badge-float--1{ top:8%; right:6%; animation-delay:.2s; }
  .nv-badge-float--2{ bottom:10%; left:4%; animation-delay:1s; }
  @keyframes nvFloat{ 0%,100%{ transform:translateY(0);} 50%{ transform:translateY(-10px);} }

  .nv-title{ font-size: clamp(30px,4.4vw,46px); font-weight:900; line-height:1.25; margin:0 0 14px; }
  .nv-subtitle{ font-size:18px; color:var(--nv-secondary); line-height:1.9; margin:0 0 22px; }

  .nv-price-row{ display:flex; align-items:baseline; gap:14px; margin-bottom:10px; flex-wrap:wrap;}
  .nv-price-old{ font-size:20px; color:var(--nv-secondary); text-decoration: line-through; }
  .nv-price-new{ font-size:36px; font-weight:900; color: var(--nv-btn); }
  .nv-discount-badge{
    background: var(--nv-accent); color:#111; font-weight:800; font-size:13px;
    padding:6px 14px; border-radius: 999px;
  }
  .nv-price-note{ font-size:13px; color:var(--nv-secondary); margin-bottom:22px;}

  .nv-trust-list{ list-style:none; padding:0; margin:0 0 26px; display:flex; flex-direction:column; gap:10px;}
  .nv-trust-list li{ display:flex; align-items:center; gap:10px; font-size:15px; font-weight:600;}
  .nv-trust-list li .nv-check{ color:var(--nv-btn); font-size:18px; }

  .nv-cta{
    display:flex; align-items:center; justify-content:center; gap:10px;
    background: var(--nv-btn); color:#fff; border:none; width:100%;
    font-family:'Cairo',sans-serif; font-weight:800; font-size:19px;
    padding:18px 24px; border-radius: var(--nv-radius); cursor:pointer;
    box-shadow: var(--nv-shadow); transition: background .25s ease, transform .15s ease;
  }
  .nv-cta:hover{ background: var(--nv-btn-hover); transform: translateY(-2px); }
  .nv-cta:active{ transform: translateY(0); }

  .nv-social-row{ display:flex; align-items:center; justify-content:center; gap:8px; margin-top:16px; font-size:14px; color:var(--nv-secondary); font-weight:600;}
  .nv-stars{ color: var(--nv-accent); letter-spacing:2px; }

  /* ============ CARDS (why love it) ============ */
  .nv-cards-grid{ display:grid; grid-template-columns: repeat(3,1fr); gap:22px; margin-top:44px; }
  .nv-card{
    background:var(--nv-white); border-radius: var(--nv-radius); padding:30px 26px;
    box-shadow: var(--nv-shadow); transition: transform .3s ease, box-shadow .3s ease;
  }
  .nv-card:hover{ transform: translateY(-6px); box-shadow: var(--nv-shadow-lg); }
  .nv-card-icon{
    width:52px; height:52px; border-radius:14px; background: rgba(14,122,62,.08);
    display:flex; align-items:center; justify-content:center; font-size:24px; margin-bottom:16px;
  }
  .nv-card h3{ font-size:18px; font-weight:800; margin:0 0 8px; }
  .nv-card p{ font-size:14.5px; color:var(--nv-secondary); line-height:1.8; margin:0; }

  /* ============ LIFESTYLE BANNER ============ */
  .nv-banner{
    position:relative; border-radius: var(--nv-radius); overflow:hidden; min-height:380px;
    display:flex; align-items:center; justify-content:center; text-align:center;
    background-color:#111;
  }
  .nv-banner img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.55; }
  .nv-banner-content{ position:relative; z-index:1; color:#fff; padding:40px 20px; }
  .nv-banner-content p:first-child{ font-size:18px; opacity:.85; margin:0 0 10px;}
  .nv-banner-content p:last-child{ font-size: clamp(24px,3.4vw,34px); font-weight:800; margin:0; line-height:1.5;}

  /* ============ COMPARISON ============ */
  .nv-compare{ display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:40px;}
  .nv-compare-col{ border-radius: var(--nv-radius); padding:30px; }
  .nv-compare-col--before{ background:#F0EDE7; border:1.5px dashed #cfc9bd; }
  .nv-compare-col--after{ background:#0E7A3E0D; border:1.5px solid rgba(14,122,62,.3); }
  .nv-compare-col h4{ font-size:18px; font-weight:800; margin:0 0 18px; }
  .nv-compare-col ul{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:12px;}
  .nv-compare-col li{ font-size:15px; font-weight:600; display:flex; gap:8px;}

  /* ============ SPECS ============ */
  .nv-specs{ background:var(--nv-white); border-radius: var(--nv-radius); box-shadow: var(--nv-shadow); padding: 12px; margin-top:40px; }
  .nv-spec-row{ display:flex; justify-content:space-between; align-items:center; padding:18px 22px; border-bottom:1px solid #EFEBE3; font-size:15px;}
  .nv-spec-row:last-child{ border-bottom:none; }
  .nv-spec-label{ color:var(--nv-secondary); font-weight:600;}
  .nv-spec-value{ font-weight:800; }

  /* ============ GALLERY ============ */
  .nv-gallery{ display:grid; grid-template-columns: repeat(4,1fr); gap:16px; margin-top:40px;}
  .nv-gallery-item{ border-radius: var(--nv-radius); overflow:hidden; cursor:zoom-in; box-shadow: var(--nv-shadow); }
  .nv-gallery-item img{ width:100%; height:220px; object-fit:cover; transition: transform .45s ease; }
  .nv-gallery-item:hover img{ transform: scale(1.08); }

  .nv-lightbox{ position:fixed; inset:0; background:rgba(17,17,17,.92); z-index:9999; display:none; align-items:center; justify-content:center; padding:30px;}
  .nv-lightbox.nv-open{ display:flex; }
  .nv-lightbox img{ max-width:90vw; max-height:85vh; border-radius:12px; }
  .nv-lightbox-close{ position:absolute; top:24px; left:24px; color:#fff; font-size:32px; background:none; border:none; cursor:pointer; }

  /* ============ REVIEWS ============ */
  .nv-reviews-grid{ display:grid; grid-template-columns: repeat(3,1fr); gap:20px; margin-top:40px;}
  .nv-review-card{ background:var(--nv-white); border-radius: var(--nv-radius); padding:22px; box-shadow: var(--nv-shadow); }
  .nv-review-stars{ color:var(--nv-accent); font-size:14px; margin-bottom:10px; letter-spacing:2px;}
  .nv-review-text{ font-size:14.5px; line-height:1.85; color:#333; margin:0 0 14px;}
  .nv-review-foot{ display:flex; justify-content:space-between; align-items:center; }
  .nv-review-name{ font-weight:800; font-size:14px;}
  .nv-review-city{ color:var(--nv-secondary); font-weight:500; font-size:13px;}
  .nv-verified{ display:inline-flex; align-items:center; gap:4px; font-size:11.5px; color:var(--nv-btn); font-weight:800; margin-top:8px;}
  .nv-review-date{ font-size:11.5px; color:#999; }

  /* ============ WHY BUY (4 cards) ============ */
  .nv-why-grid{ display:grid; grid-template-columns: repeat(4,1fr); gap:20px; margin-top:40px;}
  .nv-why-card{ text-align:center; background:var(--nv-white); border-radius: var(--nv-radius); padding:28px 18px; box-shadow: var(--nv-shadow);}
  .nv-why-card .nv-why-icon{ font-size:30px; margin-bottom:10px; }
  .nv-why-card h4{ font-size:15.5px; font-weight:800; margin:0; }

  /* ============ FAQ ============ */
  .nv-faq{ max-width:820px; margin:40px auto 0; }
  .nv-faq-item{ background:var(--nv-white); border-radius:14px; box-shadow: var(--nv-shadow); margin-bottom:12px; overflow:hidden;}
  .nv-faq-q{ width:100%; text-align:right; background:none; border:none; padding:20px 22px; font-family:'Cairo',sans-serif; font-size:15.5px; font-weight:700; cursor:pointer; display:flex; justify-content:space-between; align-items:center; color:var(--nv-primary);}
  .nv-faq-q .nv-plus{ transition: transform .3s ease; color:var(--nv-btn); font-size:20px; }
  .nv-faq-item.nv-open .nv-plus{ transform: rotate(45deg); }
  .nv-faq-a{ max-height:0; overflow:hidden; transition: max-height .35s ease; padding:0 22px; }
  .nv-faq-item.nv-open .nv-faq-a{ max-height:220px; padding-bottom:20px; }
  .nv-faq-a p{ margin:0; font-size:14.5px; color:var(--nv-secondary); line-height:1.85; }

  /* ============ LIMITED OFFER ============ */
  .nv-offer{ background: var(--nv-primary); border-radius: var(--nv-radius); padding:44px 30px; text-align:center; color:#fff; }
  .nv-offer h3{ font-size: clamp(22px,3vw,30px); font-weight:800; margin:0 0 6px;}
  .nv-offer p{ color:#cfcfcf; margin:0 0 22px; font-size:15px;}
  .nv-countdown{ display:flex; justify-content:center; gap:14px; margin-bottom:26px; }
  .nv-count-box{ background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.15); border-radius:12px; padding:14px 18px; min-width:72px; }
  .nv-count-num{ font-size:26px; font-weight:900; color:var(--nv-accent); }
  .nv-count-label{ font-size:11px; color:#bbb; margin-top:2px;}

  /* ============ EASYSELL FORM SECTION ============ */
  .nv-form-section{ background:var(--nv-white); border-radius: var(--nv-radius); box-shadow: var(--nv-shadow-lg); padding:40px; margin-top:10px; }
  .nv-form-lead{ text-align:center; font-size:16px; font-weight:700; margin:0 0 24px; }

  /* ---- Variant pills ---- */
  .nv-variant-section{ margin-bottom:18px; }
  .nv-variant-label{ display:block; font-size:14px; font-weight:700; color:#333; margin-bottom:10px; }
  .nv-variant-pills{ display:flex; flex-wrap:wrap; gap:8px; }
  .nv-variant-pill input[type="radio"]{ position:absolute; opacity:0; width:0; height:0; }
  .nv-variant-pill span{
    display:block; border:2px solid #ddd; border-radius:8px;
    padding:8px 16px; font-size:14px; font-weight:600; cursor:pointer;
    color:#444; transition:all .2s; background:#fafafa;
  }
  .nv-variant-pill input:checked + span{ border-color:#C9A84C; color:#8B6914; background:#FFF8E7; }

  /* ---- Qty row ---- */
  .nv-qty-row{ display:flex; align-items:center; gap:12px; margin-bottom:18px; }
  .nv-qty-label{ font-size:14px; font-weight:700; color:#333; }
  .nv-qty-box{ display:flex; align-items:center; border:2px solid #ddd; border-radius:8px; overflow:hidden; }
  .nv-qty-btn{ width:38px; height:38px; background:#f5f5f5; border:none; font-size:20px; cursor:pointer; display:flex; align-items:center; justify-content:center; font-weight:700; color:#333; font-family:'Cairo',sans-serif; }
  .nv-qty-input{ width:48px; height:38px; border:none; border-right:2px solid #ddd; border-left:2px solid #ddd; text-align:center; font-size:16px; font-weight:700; font-family:'Cairo',sans-serif; }

  /* ---- Submit button ---- */
  .nv-submit-btn{
    display:flex; align-items:center; justify-content:center; gap:10px;
    width:100%; background: linear-gradient(135deg, var(--nv-btn), #1a9e50, var(--nv-btn));
    color:#fff; border:none; border-radius:var(--nv-radius);
    padding:18px 24px; font-size:18px; font-weight:900; cursor:pointer;
    font-family:'Cairo',sans-serif;
    box-shadow:0 4px 20px rgba(14,122,62,.35);
    transition:opacity .2s, transform .1s;
  }
  .nv-submit-btn:hover{ opacity:.92; transform:translateY(-1px); }
  .nv-submit-btn:active{ transform:translateY(0); }
  .nv-secure-note{ text-align:center; font-size:12px; color:#888; margin-top:12px; display:flex; align-items:center; justify-content:center; gap:4px; }

  /* ============ STICKY BOTTOM BAR ============ */
  .nv-sticky-bar{
    position:fixed; bottom:0; inset-inline:0; z-index:999; background:var(--nv-white);
    box-shadow: 0 -8px 24px rgba(17,17,17,.12); padding:12px 18px;
    display:flex; align-items:center; justify-content:space-between; gap:14px;
    transform: translateY(120%); transition: transform .35s ease;
  }
  .nv-sticky-bar.nv-show{ transform: translateY(0); }
  .nv-sticky-info{ display:flex; align-items:center; gap:10px; min-width:0; }
  .nv-sticky-info img{ width:44px; height:44px; object-fit:cover; border-radius:10px; flex-shrink:0; }
  .nv-sticky-text{ min-width:0; }
  .nv-sticky-title{ font-size:12.5px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:160px;}
  .nv-sticky-price{ font-size:13.5px; font-weight:800; color:var(--nv-btn); }
  .nv-sticky-old{ font-size:11.5px; color:var(--nv-secondary); text-decoration:line-through; margin-right:6px;}
  .nv-sticky-btn{ background:var(--nv-btn); color:#fff; border:none; border-radius:12px; padding:12px 22px; font-family:'Cairo',sans-serif; font-weight:800; font-size:14px; cursor:pointer; white-space:nowrap; }
  .nv-sticky-btn:hover{ background:var(--nv-btn-hover); }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 980px){
    .nv-hero-grid{ grid-template-columns:1fr; gap:32px; }
    .nv-cards-grid{ grid-template-columns: repeat(2,1fr); }
    .nv-compare{ grid-template-columns:1fr; }
    .nv-gallery{ grid-template-columns: repeat(2,1fr); }
    .nv-reviews-grid{ grid-template-columns: repeat(2,1fr); }
    .nv-why-grid{ grid-template-columns: repeat(2,1fr); }
  }
  @media (max-width: 640px){
    .nv-section{ padding:48px 0; }
    .nv-cards-grid{ grid-template-columns:1fr; }
    .nv-gallery{ grid-template-columns: repeat(2,1fr); }
    .nv-reviews-grid{ grid-template-columns:1fr; }
    .nv-why-grid{ grid-template-columns: repeat(2,1fr); }
    .nv-form-section{ padding:20px; }
    .nv-hero{ padding: 20px 0 36px; }
    .nv-countdown{ gap:8px; }
    .nv-count-box{ min-width:60px; padding:10px 12px; }
    body{ padding-bottom:78px; }
  }
  @media (prefers-reduced-motion: reduce){
    .nv-fade-up, .nv-fade-left, .nv-hero-media::before, .nv-badge-float{ animation:none !important; transition:none !important; opacity:1 !important; transform:none !important; }
  }
</style>

  <!-- ============ HERO ============ -->
  <section class="nv-hero">
    <div class="nv-container nv-hero-grid">
      <div class="nv-hero-media nv-fade-left">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | image_url: width: 900 }}"
               loading="eager" fetchpriority="high"
               width="900" height="900"
               alt="{{ product.featured_image.alt | default: product.title }}">
        {% else %}
          <img src="{{ 'novacart-lamp.jpg' | asset_url }}" loading="eager" alt="{{ product.title }}">
        {% endif %}
        <span class="nv-badge-float nv-badge-float--1">⚡ شحن لاسلكي</span>
        <span class="nv-badge-float nv-badge-float--2">🏆 الأكثر مبيعاً</span>
      </div>

      <div class="nv-hero-copy nv-fade-up">
        <span class="nv-eyebrow">✨ قطعة فنية + شاحن ذكي</span>
        <h1 class="nv-title">مصباح فني بالشحن اللاسلكي</h1>
        <p class="nv-subtitle">لوحة فنية أنيقة تتحول إلى قاعدة شحن لاسلكي ذكية لهاتفك.</p>

        <div class="nv-price-row">
          <span class="nv-price-old">{% if product.compare_at_price > product.price %}{{ product.compare_at_price | money }}{% else %}299 ر.س{% endif %}</span>
          <span class="nv-price-new">{% if product.price %}{{ product.price | money }}{% else %}179 ر.س{% endif %}</span>
          <span class="nv-discount-badge">وفر 40%</span>
        </div>
        <p class="nv-price-note">السعر شامل الشحن — الدفع عند الاستلام بدون أي مبلغ مقدّم</p>

        <ul class="nv-trust-list">
          <li><span class="nv-check">✅</span> الدفع عند الاستلام</li>
          <li><span class="nv-check">✅</span> شحن مجاني لجميع مدن السعودية</li>
          <li><span class="nv-check">✅</span> ضمان الجودة</li>
        </ul>

        <!-- ===== INLINE COD FORM ===== -->
        <div class="nv-form-section" id="nv-order-form" style="margin-top:22px;">
          <p class="nv-form-lead">🛒 اطلب الآن — الدفع عند الاستلام</p>
          <p style="text-align:center;font-size:13px;color:#888;margin:-14px 0 22px;">أدخل طلبك وسيتصل بك فريقنا لتأكيد الشحن</p>

          {%- form 'product', product, id: 'nv-product-form', novalidate: true -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" id="nv-variant-id">

            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <div class="nv-variant-section">
                  <span class="nv-variant-label">{{ option.name }}</span>
                  <div class="nv-variant-pills">
                    {%- for value in option.values -%}
                      <label class="nv-variant-pill">
                        <input
                          type="radio"
                          name="{{ option.name }}"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <span>{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            {%- endunless -%}

            <div class="nv-qty-row">
              <span class="nv-qty-label">الكمية:</span>
              <div class="nv-qty-box">
                <button type="button" class="nv-qty-btn" onclick="var q=document.getElementById('nv-qty');if(q.value>1)q.value=+q.value-1;">−</button>
                <input type="number" id="nv-qty" name="quantity" value="1" min="1" class="nv-qty-input" readonly>
                <button type="button" class="nv-qty-btn" onclick="var q=document.getElementById('nv-qty');q.value=+q.value+1;">+</button>
              </div>
            </div>

            {% content_for 'blocks' %}

            <button type="submit" name="add" class="nv-submit-btn" id="nv-submit-btn">
              🛒 اطلب الآن — الدفع عند الاستلام
            </button>
          {%- endform -%}

          <p class="nv-secure-note">🔒 طلبك آمن 100% — لا حاجة لبطاقة بنكية</p>
        </div>

        <div class="nv-social-row" style="margin-top:14px;">
          <span class="nv-stars">⭐⭐⭐⭐⭐</span>
          <span>4.9/5 — أكثر من 3200 عميل سعيد</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SECTION 2: WHY CUSTOMERS LOVE IT ============ -->
  <section class="nv-section">
    <div class="nv-container">
      <div class="nv-center nv-fade-up">
        <span class="nv-eyebrow">لماذا نحن مختلفون</span>
        <h2 class="nv-h2">لماذا يعشق الجميع هذا المصباح؟</h2>
