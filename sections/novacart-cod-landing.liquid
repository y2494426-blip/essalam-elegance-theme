<script>
(function(){
  var doc = document;

  /* ---- Scroll to EasySell form ---- */
  var formTarget = doc.getElementById('nv-order-form');
  doc.querySelectorAll('[data-nv-scroll-form]').forEach(function(btn){
    btn.addEventListener('click', function(){
      if (formTarget) formTarget.scrollIntoView({ behavior:'smooth', block:'start' });
    });
  });

  /* ---- Sticky bottom bar visibility ---- */
  var stickyBar = doc.getElementById('nvStickyBar');
  if (stickyBar && formTarget) {
    var ioForm = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting) { stickyBar.classList.remove('nv-show'); }
        else { stickyBar.classList.add('nv-show'); }
      });
    }, { threshold: 0.2 });
    ioForm.observe(formTarget);
  }

  /* ---- Fade-up / fade-left on scroll ---- */
  var fadeEls = doc.querySelectorAll('.nv-fade-up, .nv-fade-left');
  var fadeIo = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if (entry.isIntersecting) {
        entry.target.classList.add('nv-in');
        fadeIo.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  fadeEls.forEach(function(el){ fadeIo.observe(el); });

  /* ---- FAQ accordion ---- */
  doc.querySelectorAll('[data-nv-faq-toggle]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.closest('.nv-faq-item');
      var wasOpen = item.classList.contains('nv-open');
      doc.querySelectorAll('.nv-faq-item.nv-open').forEach(function(el){ el.classList.remove('nv-open'); });
      if (!wasOpen) item.classList.add('nv-open');
    });
  });

  /* ---- Gallery lightbox ---- */
  var lightbox = doc.getElementById('nvLightbox');
  var lightboxImg = doc.getElementById('nvLightboxImg');
  var lightboxClose = doc.getElementById('nvLightboxClose');
  doc.querySelectorAll('[data-nv-lightbox-trigger]').forEach(function(item){
    item.addEventListener('click', function(){
      var img = item.querySelector('img');
      if (!img || !lightbox) return;
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightbox.classList.add('nv-open');
    });
  });
  if (lightboxClose) {
    lightboxClose.addEventListener('click', function(){ lightbox.classList.remove('nv-open'); });
  }
  if (lightbox) {
    lightbox.addEventListener('click', function(e){
      if (e.target === lightbox) lightbox.classList.remove('nv-open');
    });
  }

  /* ---- Variant switcher ---- */
  var nvVariants    = JSON.parse(document.getElementById('nv-variants-json').textContent);
  var nvOptionNames = JSON.parse(document.getElementById('nv-options-json').textContent);
  var nvForm        = document.getElementById('nv-product-form');
  var nvVariantId   = document.getElementById('nv-variant-id');

  function nvGetSelectedVariant() {
    if (!nvForm) return null;
    var selected = nvOptionNames.map(function(name) {
      var el = nvForm.querySelector('input[name="' + name + '"]:checked');
      return el ? el.value : null;
    });
    return nvVariants.find(function(v) {
      return v.options.every(function(opt, i) { return opt === selected[i]; });
    });
  }

  function nvUpdateVariant() {
    var v = nvGetSelectedVariant();
    if (!v) return;
    if (nvVariantId) nvVariantId.value = v.id;
    document.dispatchEvent(new CustomEvent('variant:change', { detail: { variant: v } }));
  }

  if (nvForm) {
    nvForm.querySelectorAll('input[type="radio"]').forEach(function(r) {
      r.addEventListener('change', nvUpdateVariant);
    });
    nvUpdateVariant();
  }

  /* ---- Countdown timer ---- */
  var hoursEl = doc.getElementById('nvHours');
  var minutesEl = doc.getElementById('nvMinutes');
  var secondsEl = doc.getElementById('nvSeconds');
  function pad(n){ return n < 10 ? '0' + n : '' + n; }
  function tick(){
    var now = new Date();
    var midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 0);
    var diff = Math.max(0, midnight - now);
    var h = Math.floor(diff / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    if (hoursEl) hoursEl.textContent = pad(h);
    if (minutesEl) minutesEl.textContent = pad(m);
    if (secondsEl) secondsEl.textContent = pad(s);
  }
  tick();
  setInterval(tick, 1000);
})();
</script>

