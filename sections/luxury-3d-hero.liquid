{%- comment -%}
  ============================================================
  LUXURY HERO — simple, reliable version
  ------------------------------------------------------------
  The previous Three.js + GSAP + Lenis build kept freezing —
  almost certainly the async import() calls to external CDN
  modules hanging or being blocked (Shopify's CSP / network),
  with no fallback path once that happened.

  This version drops all of that: no WebGL, no dynamic imports,
  no external JS libraries at all (only Google Fonts, which has
  already proven reliable elsewhere in this theme). The floating
  "3D" cards are plain CSS 3D transforms (perspective + rotateX/
  rotateY), driven by a small vanilla-JS scroll/mouse listener
  that can't hang the page — worst case it just doesn't run and
  the cards sit still, everything else keeps working.
  ============================================================
{%- endcomment -%}
<section id="essalem-lux-root">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  #essalem-lux-root {
    --lux-bg: {{ section.settings.color_bg | default: '#050505' }};
    --lux-bg2: {{ section.settings.color_bg2 | default: '#101010' }};
    --lux-gold: {{ section.settings.color_gold | default: '#D4AF37' }};
    --lux-gold-soft: {{ section.settings.color_gold_soft | default: '#E8C86B' }};
    --lux-champagne: {{ section.settings.color_champagne | default: '#F5E7C2' }};
    --lux-white: #FFFFFF;
    --lux-font-heading: 'Cormorant Garamond', Georgia, serif;
    --lux-font-body: 'Poppins', Arial, sans-serif;
    display: block;
    background: var(--lux-bg);
  }
  #essalem-lux-root *{ box-sizing: border-box; }

  #essalem-lux-root .lux-hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: radial-gradient(ellipse at 70% 30%, var(--lux-bg2) 0%, var(--lux-bg) 65%);
    color: var(--lux-white);
    font-family: var(--lux-font-body);
  }

  /* ===== CSS-only depth background (no images, no JS needed) ===== */
  #essalem-lux-root .lux-marble {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      radial-gradient(circle at 20% 15%, rgba(232,200,107,.05), transparent 40%),
      radial-gradient(circle at 85% 75%, rgba(212,175,55,.06), transparent 45%),
      repeating-linear-gradient(115deg, rgba(255,255,255,.015) 0 2px, transparent 2px 40px),
      linear-gradient(180deg, #060606 0%, #0c0c0c 50%, #050505 100%);
  }
  #essalem-lux-root .lux-rays {
    position: absolute; z-index: 2; pointer-events: none;
    top: 50%; left: 65%; width: 180vmax; height: 180vmax; margin: -90vmax 0 0 -90vmax;
    background: conic-gradient(from 0deg,
      transparent 0deg, rgba(232,200,107,.05) 8deg, transparent 20deg,
      transparent 160deg, rgba(212,175,55,.04) 170deg, transparent 185deg,
      transparent 340deg, rgba(232,200,107,.03) 350deg, transparent 360deg);
    animation: lux-spin 90s linear infinite;
    mix-blend-mode: screen;
  }
  @keyframes lux-spin { to { transform: rotate(360deg); } }

  #essalem-lux-root .lux-vignette {
    position: absolute; inset: 0; z-index: 5; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(5,5,5,.85) 0%, rgba(5,5,5,.3) 42%, transparent 62%),
      radial-gradient(ellipse at center, transparent 45%, rgba(0,0,0,.5) 100%);
  }

  /* ===== The "3D" stage: plain CSS perspective, no WebGL ===== */
  #essalem-lux-root .lux-stage {
    position: absolute; inset: 0; z-index: 3;
    perspective: 1400px;
  }
  #essalem-lux-root .lux-stage-inner {
    position: absolute; inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--lux-tilt-x, 0deg)) rotateY(var(--lux-tilt-y, 0deg));
    transition: transform .3s ease-out;
  }
  #essalem-lux-root .lux-card {
    position: absolute;
    width: clamp(120px, 14vw, 190px);
    aspect-ratio: 1;
    border-radius: 24px;
    background: rgba(255,255,255,.05);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(212,175,55,.28);
    box-shadow: 0 30px 60px -20px rgba(0,0,0,.6), inset 0 0 30px rgba(232,200,107,.05);
    display: flex; align-items: center; justify-content: center;
    color: var(--lux-gold-soft);
    animation: lux-float 6s ease-in-out infinite;
    transform: translate3d(var(--x, 0), var(--y, 0), var(--z, 0)) rotate(var(--r, 0deg));
    will-change: transform;
  }
  #essalem-lux-root .lux-card svg { width: 56%; height: 56%; }
  #essalem-lux-root .lux-card--watch   { top: 14%; right: 26%; animation-delay: 0s; }
  #essalem-lux-root .lux-card--glasses { top: 42%; right: 6%;  animation-delay: 1.4s; }
  #essalem-lux-root .lux-card--bracelet{ top: 60%; right: 34%; animation-delay: 2.6s; }
  #essalem-lux-root .lux-card--bag     { top: 30%; right: 46%; animation-delay: .8s; }
  @keyframes lux-float {
    0%, 100% { margin-top: 0; }
    50% { margin-top: -18px; }
  }

  @media (max-width: 900px) {
    #essalem-lux-root .lux-card { position: relative; margin: 0 !important; top: auto; right: auto; }
    #essalem-lux-root .lux-stage { position: relative; inset: auto; height: 260px; perspective: none; }
    #essalem-lux-root .lux-stage-inner {
      position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
      padding: 0 20px; transform: none !important;
    }
  }

  /* ===== Content ===== */
  #essalem-lux-root .lux-content {
    position: relative; z-index: 6;
    min-height: 100svh;
    display: flex; flex-direction: column; justify-content: center;
    max-width: 620px;
    padding: 120px 6vw 100px;
  }
  #essalem-lux-root .lux-eyebrow {
    font-size: .8rem; font-weight: 500; letter-spacing: .45em; text-transform: uppercase;
    color: var(--lux-gold-soft);
    margin-bottom: 22px;
  }
  #essalem-lux-root .lux-heading {
    font-family: var(--lux-font-heading);
    font-weight: 600;
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 1.08;
    margin: 0 0 22px;
    background: linear-gradient(100deg, var(--lux-white) 30%, var(--lux-gold-soft) 60%, var(--lux-champagne) 80%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  #essalem-lux-root .lux-sub {
    font-size: 1rem; font-weight: 300; letter-spacing: .06em;
    color: rgba(255,255,255,.65);
    margin: 0 0 44px;
  }
  #essalem-lux-root .lux-ctas { display: flex; flex-wrap: wrap; gap: 18px; }
  #essalem-lux-root .lux-btn {
    font-size: .82rem; font-weight: 500; letter-spacing: .18em; text-transform: uppercase;
    padding: 18px 36px; border-radius: 2px; text-decoration: none;
    display: inline-flex; align-items: center; justify-content: center;
    transition: transform .35s ease, box-shadow .35s ease, color .35s ease, border-color .35s ease;
  }
  #essalem-lux-root .lux-btn--gold {
    background: linear-gradient(120deg, var(--lux-gold-soft), var(--lux-gold));
    color: #10100c;
    box-shadow: 0 18px 40px -14px rgba(212,175,55,.55);
  }
  #essalem-lux-root .lux-btn--gold:hover { transform: translateY(-3px); }
  #essalem-lux-root .lux-btn--ghost {
    background: transparent; color: var(--lux-white); border: 1px solid rgba(255,255,255,.35);
  }
  #essalem-lux-root .lux-btn--ghost:hover { border-color: var(--lux-gold-soft); color: var(--lux-gold-soft); transform: translateY(-3px); }

  #essalem-lux-root [data-lux-reveal] { opacity: 0; transform: translateY(16px); transition: opacity .8s ease, transform .8s ease; }
  #essalem-lux-root [data-lux-reveal].is-visible { opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) {
    #essalem-lux-root .lux-card { animation: none; }
    #essalem-lux-root .lux-rays { animation: none; }
    #essalem-lux-root [data-lux-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>

<div class="lux-hero" id="lux-hero">
  <div class="lux-marble"></div>
  <div class="lux-rays"></div>

  {%- comment -%} Simple CSS-3D floating cards — no WebGL, nothing that can hang {%- endcomment -%}
  <div class="lux-stage">
    <div class="lux-stage-inner" id="lux-stage-inner">
      <div class="lux-card lux-card--watch" style="--z:40px;">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><circle cx="32" cy="32" r="20"/><path d="M32 20v12l8 6"/><rect x="26" y="4" width="12" height="8" rx="2"/><rect x="26" y="52" width="12" height="8" rx="2"/></svg>
      </div>
      <div class="lux-card lux-card--glasses" style="--z:10px;">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="22" width="22" height="16" rx="4"/><rect x="38" y="22" width="22" height="16" rx="4"/><path d="M26 28h12"/></svg>
      </div>
      <div class="lux-card lux-card--bracelet" style="--z:60px;">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><circle cx="32" cy="32" r="22"/><path d="M24 14l6 6-6 6"/></svg>
      </div>
      <div class="lux-card lux-card--bag" style="--z:0px;">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><rect x="10" y="24" width="44" height="32" rx="8"/><path d="M22 24v-6a10 10 0 0 1 20 0v6"/></svg>
      </div>
    </div>
  </div>

  <div class="lux-vignette"></div>

  <div class="lux-content">
    <span class="lux-eyebrow" data-lux-reveal>{{ section.settings.eyebrow }}</span>
    <h1 class="lux-heading" data-lux-reveal>{{ section.settings.heading }}</h1>
    <p class="lux-sub" data-lux-reveal>{{ section.settings.subheading }}</p>
    <div class="lux-ctas" data-lux-reveal>
      {%- if section.settings.cta_primary_text != blank -%}
        <a href="{{ section.settings.cta_primary_url | default: '#' }}" class="lux-btn lux-btn--gold">{{ section.settings.cta_primary_text }}</a>
      {%- endif -%}
      {%- if section.settings.cta_secondary_text != blank -%}
        <a href="{{ section.settings.cta_secondary_url | default: '#' }}" class="lux-btn lux-btn--ghost">{{ section.settings.cta_secondary_text }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('essalem-lux-root');
    var heroEl = document.getElementById('lux-hero');
    var stage = document.getElementById('lux-stage-inner');
    if (!root || !heroEl) return;

    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var isMobile = window.matchMedia('(max-width: 900px)').matches;

    /* reveal-on-load for the text */
    root.querySelectorAll('[data-lux-reveal]').forEach(function (el, i) {
      setTimeout(function () { el.classList.add('is-visible'); }, 150 + i * 150);
    });

    if (stage && !isMobile && !prefersReducedMotion) {
      /* subtle mouse tilt — plain CSS custom properties, synchronous, nothing to hang on */
      heroEl.addEventListener('pointermove', function (e) {
        var rect = heroEl.getBoundingClientRect();
        var nx = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        var ny = ((e.clientY - rect.top) / rect.height) * 2 - 1;
        stage.style.setProperty('--lux-tilt-y', (nx * 6) + 'deg');
        stage.style.setProperty('--lux-tilt-x', (ny * -4) + 'deg');
      });

      /* gentle parallax drift on scroll */
      window.addEventListener('scroll', function () {
        var progress = Math.min(1, Math.max(0, -heroEl.getBoundingClientRect().top / heroEl.offsetHeight));
        root.querySelectorAll('.lux-card').forEach(function (card, i) {
          var dir = i % 2 === 0 ? 1 : -1;
          card.style.setProperty('--x', (progress * 40 * dir) + 'px');
          card.style.setProperty('--y', (progress * -60) + 'px');
        });
      }, { passive: true });
    }
  })();
</script>

</section>

{% schema %}
{
  "name": "Luxury Hero",
  "tag": "section",
  "class": "section section--luxury-hero",
  "settings": [
    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "eyebrow", "label": "Texte au-dessus du titre", "default": "COLLECTION PREMIUM" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Élégance qui rassemble" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Montres • Lunettes • Bracelets • Sacs" },
    { "type": "header", "content": "Boutons" },
    { "type": "text", "id": "cta_primary_text", "label": "Bouton principal — texte", "default": "Découvrir la collection" },
    { "type": "url", "id": "cta_primary_url", "label": "Bouton principal — lien" },
    { "type": "text", "id": "cta_secondary_text", "label": "Bouton secondaire — texte", "default": "Voir les nouveautés" },
    { "type": "url", "id": "cta_secondary_url", "label": "Bouton secondaire — lien" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "color_bg", "label": "Fond principal", "default": "#050505" },
    { "type": "color", "id": "color_bg2", "label": "Fond secondaire", "default": "#101010" },
    { "type": "color", "id": "color_gold", "label": "Or", "default": "#D4AF37" },
    { "type": "color", "id": "color_gold_soft", "label": "Or doux", "default": "#E8C86B" },
    { "type": "color", "id": "color_champagne", "label": "Champagne", "default": "#F5E7C2" }
  ],
  "presets": [
    { "name": "Luxury Hero" }
  ]
}
{% endschema %}
