<div class="dc-discount-bar">
  <span>✨ عرض محدود</span>
  <span>اشتري 3 واحصلي على سعر خاص 399 ر.س</span>
  <span>|</span>
  <span>⏰ ينتهي العرض خلال: <span class="dc-bar-countdown" id="dcBarTimer">00:59:59</span></span>
  <span>🚚 شحن مجاني لجميع مدن السعودية</span>
</div>

<!-- ==================== HERO ==================== -->
<section class="dc-hero" id="dc-top">
  <div class="dc-wrap dc-hero-grid">

    <!-- Image col -->
    <div class="dc-hero-media dc-fade-left">
      <div class="dc-hero-img-wrap">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | image_url: width: 1000 }}"
               loading="eager" fetchpriority="high"
               width="1000" height="1000"
               alt="{{ product.featured_image.alt | default: product.title }}">
        {% else %}
          <img src="{{ 'product-1' | placeholder_svg_tag }}" alt="{{ product.title }}">
        {% endif %}
        <div class="dc-hero-glow"></div>
      </div>
      <div class="dc-float-badge dc-float-badge--1">✨ تركيبة كورية فاخرة</div>
      <div class="dc-float-badge dc-float-badge--2">🏆 أكثر من 10,000 عميلة</div>
    </div>

    <!-- Copy + Form col -->
    <div class="dc-hero-copy dc-fade">
      <span class="dc-eyebrow">DEEP CERA — Korean Brightening</span>
      <h1 class="dc-h1">
        إشراقة تبدأ<br>
        <span class="dc-hero-title-accent">من أول قطرة</span> ✨
      </h1>
      <p class="dc-hero-sub">
        سيروم كوري فاخر يجمع بين فيتامين C والنياسيناميد والسيراميد لبشرة مشرقة، موحدة اللون، مرطبة بعمق — من أول أسبوع.
      </p>

      <div class="dc-trust-row">
        <div class="dc-trust-pill">⭐ أكثر من 10,000 عميلة</div>
        <div class="dc-trust-pill">🚚 شحن سريع</div>
        <div class="dc-trust-pill">💵 الدفع عند الاستلام</div>
        <div class="dc-trust-pill">🇸🇦 جميع أنحاء السعودية</div>
      </div>

      <!-- === EASYSELL FORM === -->
      <div class="dc-hero-form" id="dc-order-form">
        <p class="dc-form-lead">🛒 اطلبي الآن — الدفع عند الاستلام</p>
        <p class="dc-form-sub">أدخلي طلبك وسيتصل بك فريقنا لتأكيد الشحن</p>

        <!-- Package selector -->
        <div class="dc-pkg-grid" id="dc-pkg-grid">
          <div class="dc-pkg" data-pkg="1" data-price="170" data-qty="1">
            <div class="dc-pkg-qty">زجاجة واحدة</div>
            <div class="dc-pkg-price">170 <span>ر.س</span></div>
          </div>
          <div class="dc-pkg" data-pkg="2" data-price="299" data-qty="2">
            <div class="dc-pkg-qty">زجاجتان</div>
            <div class="dc-pkg-price">299 <span>ر.س</span></div>
            <div class="dc-pkg-save">وفري 41 ر.س</div>
          </div>
          <div class="dc-pkg dc-pkg--best dc-pkg--active" data-pkg="3" data-price="399" data-qty="3">
            <div class="dc-pkg-qty">3 زجاجات</div>
            <div class="dc-pkg-price">399 <span>ر.س</span></div>
            <div class="dc-pkg-save">وفري 111 ر.س ✨</div>
          </div>
          <div class="dc-pkg" data-pkg="4" data-price="450" data-qty="4">
            <div class="dc-pkg-qty">4 زجاجات</div>
            <div class="dc-pkg-price">450 <span>ر.س</span></div>
            <div class="dc-pkg-save">وفري 230 ر.س</div>
          </div>
        </div>

        {%- form 'product', product, id: 'dc-product-form', novalidate: true -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="dc-variant-id">

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="dc-variant-sec">
                <span class="dc-variant-label">{{ option.name }}</span>
                <div class="dc-variant-pills">
                  {%- for value in option.values -%}
                    <label class="dc-variant-pill">
                      <input type="radio" name="{{ option.name }}" value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}>
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <div class="dc-qty-row">
            <span class="dc-qty-lbl">الكمية:</span>
            <div class="dc-qty-box">
              <button type="button" class="dc-qty-btn" onclick="var q=document.getElementById('dc-qty');if(q.value>1)q.value=+q.value-1;">−</button>
              <input type="number" id="dc-qty" name="quantity" value="3" min="1" class="dc-qty-inp" readonly>
              <button type="button" class="dc-qty-btn" onclick="var q=document.getElementById('dc-qty');q.value=+q.value+1;">+</button>
            </div>
          </div>

          {% content_for 'blocks' %}

          <button type="submit" name="add" class="dc-submit" id="dc-submit">
            🛒 اطلبي الآن — الدفع عند الاستلام
          </button>
        {%- endform -%}

        <p class="dc-secure">🔒 طلبك آمن 100% — لا حاجة لبطاقة بنكية</p>
      </div>
    </div>

  </div>
</section>

