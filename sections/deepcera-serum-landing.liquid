<script>
(function(){
  var doc = document;

  /* ---- Countdown ---- */
  function dcCountdown(elH, elM, elS, barEl, totalSeconds){
    var end = Date.now() + totalSeconds * 1000;
    function tick(){
      var rem = Math.max(0, Math.floor((end - Date.now()) / 1000));
      var h = Math.floor(rem / 3600);
      var m = Math.floor((rem % 3600) / 60);
      var s = rem % 60;
      var pad = function(n){ return n < 10 ? '0' + n : '' + n; };
      elH.textContent = pad(h);
      elM.textContent = pad(m);
      elS.textContent = pad(s);
      if(barEl) barEl.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
      if(rem > 0) setTimeout(tick, 1000);
    }
    tick();
  }
  var cH = doc.getElementById('dcH');
  var cM = doc.getElementById('dcM');
  var cS = doc.getElementById('dcS');
  var barT = doc.getElementById('dcBarTimer');
  if(cH && cM && cS) dcCountdown(cH, cM, cS, barT, 3 * 3600 + 59 * 60 + 59);

  /* ---- Fade on scroll ---- */
  var fadeEls = doc.querySelectorAll('.dc-fade, .dc-fade-left');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('dc-in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.10 });
  fadeEls.forEach(function(el){ io.observe(el); });

  /* ---- Sticky bar ---- */
  var stickyBar = doc.getElementById('dcStickyBar');
  var heroForm = doc.getElementById('dc-order-form');
  if(stickyBar && heroForm){
    var sio = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ stickyBar.classList.remove('dc-show'); }
        else { stickyBar.classList.add('dc-show'); }
      });
    }, { threshold: 0.15 });
    sio.observe(heroForm);
  }

  /* ---- FAQ ---- */
  doc.querySelectorAll('[data-dc-faq]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.closest('.dc-faq-item');
      var wasOpen = item.classList.contains('dc-open');
      doc.querySelectorAll('.dc-faq-item.dc-open').forEach(function(el){ el.classList.remove('dc-open'); });
      if(!wasOpen) item.classList.add('dc-open');
    });
  });

  /* ---- Package selector (hero) ---- */
  doc.querySelectorAll('#dc-pkg-grid .dc-pkg').forEach(function(pkg){
    pkg.addEventListener('click', function(){
      doc.querySelectorAll('#dc-pkg-grid .dc-pkg').forEach(function(p){ p.classList.remove('dc-pkg--active'); });
      pkg.classList.add('dc-pkg--active');
      var qty = parseInt(pkg.dataset.qty) || 1;
      var qEl = doc.getElementById('dc-qty');
      if(qEl) qEl.value = qty;
    });
  });

  /* ---- Package select from offer grid ---- */
  window.dcSelectPkg = function(qty, price){
    var qEl = doc.getElementById('dc-main-qty');
    if(qEl) qEl.value = qty;
    var targetForm = doc.getElementById('dc-main-form');
    if(targetForm) targetForm.scrollIntoView({ behavior:'smooth', block:'center' });
  };

  /* ---- Before/After slider ---- */
  var ba = doc.getElementById('dcBa');
  var baAfter = doc.getElementById('dcBaAfter');
  var baDivider = doc.getElementById('dcBaDivider');
  if(ba && baAfter && baDivider){
    var dragging = false;
    function setPos(x){
      var rect = ba.getBoundingClientRect();
      var pct = Math.min(Math.max((x - rect.left) / rect.width, 0.05), 0.95);
      baAfter.style.width = (pct * 100) + '%';
      baDivider.style.right = (pct * 100) + '%';
    }
    ba.addEventListener('mousedown', function(e){ dragging = true; setPos(e.clientX); });
    window.addEventListener('mousemove', function(e){ if(dragging) setPos(e.clientX); });
    window.addEventListener('mouseup', function(){ dragging = false; });
    ba.addEventListener('touchstart', function(e){ dragging = true; setPos(e.touches[0].clientX); }, { passive:true });
    window.addEventListener('touchmove', function(e){ if(dragging) setPos(e.touches[0].clientX); }, { passive:true });
    window.addEventListener('touchend', function(){ dragging = false; });
  }

  /* ---- Random viewers counter ---- */
  var vEl = doc.getElementById('dcViewers');
  if(vEl){
    setInterval(function(){
      var base = 40 + Math.floor(Math.random() * 20);
      vEl.textContent = base;
    }, 7000);
  }

  /* ---- Recent order popup ---- */
  var popup = doc.getElementById('dcPopup');
  var popupName = doc.getElementById('dcPopupName');
  var popupNames = [
    'نورة من الرياض','سارة من جدة','هند من الدمام','ريم من مكة','منى من المدينة',
    'لمى من الطائف','عبير من الخبر','دانة من أبها','وفاء من القصيم','أميرة من ينبع',
    'شيخة من حائل','ثريا من نجران','رنا من تبوك','غادة من الجبيل'
  ];
  var popupIdx = 0;
  function showPopup(){
    if(!popup || !popupName) return;
    popupName.textContent = popupNames[popupIdx % popupNames.length];
    popupIdx++;
    popup.classList.add('dc-show');
    setTimeout(function(){ popup.classList.remove('dc-show'); }, 4000);
  }
  setTimeout(function(){
    showPopup();
    setInterval(showPopup, 12000);
  }, 5000);

  /* ---- Variant sync ---- */
  var variantData = JSON.parse(doc.getElementById('dc-variants-json').textContent);
  function syncVariant(formId, varInputId){
    var form = doc.getElementById(formId);
    if(!form) return;
    form.querySelectorAll('.dc-variant-pill input[type=radio]').forEach(function(r){
      r.addEventListener('change', function(){
        var selected = {};
        form.querySelectorAll('.dc-variant-pill input[type=radio]:checked').forEach(function(c){
          selected[c.name] = c.value;
        });
        var match = variantData.find(function(v){
          return Object.keys(selected).every(function(k){ return v['option' + (variantData[0] ? Object.keys(selected).indexOf(k)+1 : 1)] === selected[k]; });
        });
        if(match){ var el = doc.getElementById(varInputId); if(el) el.value = match.id; }
      });
    });
  }
  syncVariant('dc-product-form','dc-variant-id');
  syncVariant('dc-main-product-form','dc-main-variant-id');

})();
</script>

