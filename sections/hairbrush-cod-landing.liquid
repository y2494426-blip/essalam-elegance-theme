    {% if product.price %} | {{ current_variant.price | money }}{% endif %}
  </button>
</div>

</div><!-- end .hb-page -->

<script>
(function(){
  var doc = document;

  /* Scroll reveal */
  var revealEls = doc.querySelectorAll('.hb-page .reveal');
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    },{threshold:.15});
    revealEls.forEach(function(el){ io.observe(el); });
  } else { revealEls.forEach(function(el){ el.classList.add('in'); }); }

  /* Temperature selector */
  window.hbSelectTemp = function(el){
    doc.querySelectorAll('.hb-page .temp-pill').forEach(function(p){ p.classList.remove('active'); });
    el.classList.add('active');
    var d = doc.getElementById('hbTempDesc');
    if(d) d.textContent = el.getAttribute('data-desc');
  };

  /* Before/After slider */
  var baRange = doc.getElementById('hbBaRange');
  var baAfter = doc.getElementById('hbBaAfter');
  var baHandle = doc.getElementById('hbBaHandle');
  function hbUpdateBA(v){
    if(baAfter) baAfter.style.clipPath = 'inset(0 0 0 '+v+'%)';
    if(baHandle) baHandle.style.right = v+'%';
  }
  if(baRange){
    baRange.addEventListener('input', function(e){ hbUpdateBA(e.target.value); });
    hbUpdateBA(50);
  }

  /* FAQ accordion */
  doc.querySelectorAll('[data-hb-faq]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.parentElement;
      var wasOpen = item.classList.contains('open');
      doc.querySelectorAll('.hb-page .faq-item').forEach(function(i){
        i.classList.remove('open');
        var a = i.querySelector('.faq-a');
        if(a) a.style.maxHeight = null;
      });
      if(!wasOpen){
        item.classList.add('open');
        var a = item.querySelector('.faq-a');
        if(a) a.style.maxHeight = a.scrollHeight+'px';
      }
    });
  });

  /* Gallery lightbox */
  var lb = doc.getElementById('hb-lightbox');
  var lbImg = doc.getElementById('hb-lb-img');
  doc.querySelectorAll('[data-hb-lb]').forEach(function(el){
    el.addEventListener('click', function(){
      if(!lb||!lbImg) return;
      lbImg.src = el.dataset.hbLb;
      lb.style.display = 'flex';
      doc.body.style.overflow = 'hidden';
    });
  });
  if(lb) lb.addEventListener('click', function(e){ if(e.target===lb){ lb.style.display='none'; doc.body.style.overflow=''; } });

  /* Submit ripple */
  var submitBtn = doc.getElementById('hb-submit');
  if(submitBtn){
    submitBtn.addEventListener('click', function(e){
      var rect = submitBtn.getBoundingClientRect();
      var r = doc.createElement('span');
      r.className = 'hb-ripple';
      var sz = Math.max(submitBtn.offsetWidth, submitBtn.offsetHeight);
      r.style.cssText = 'width:'+sz+'px;height:'+sz+'px;top:'+(e.clientY-rect.top-sz/2)+'px;left:'+(e.clientX-rect.left-sz/2)+'px;position:absolute;';
      submitBtn.appendChild(r);
      setTimeout(function(){ r.remove(); }, 700);
    });
  }

  /* Variant sync */
  var variantsEl = doc.getElementById('hb-variants-json');
  if(variantsEl && variantsEl.textContent.trim() !== 'null'){
    try{
      var variantData = JSON.parse(variantsEl.textContent);
      var form = doc.getElementById('hb-product-form');
      if(form && variantData){
        form.querySelectorAll('.hb-var-pill input').forEach(function(r){
          r.addEventListener('change', function(){
            var opts = {};
            form.querySelectorAll('.hb-var-pill input:checked').forEach(function(c){ opts[c.name] = c.value; });
            var match = variantData.find(function(v){
              return Object.keys(opts).every(function(k,i){ return v['option'+(i+1)] === opts[k]; });
            });
            if(match){
              var vid = doc.getElementById('hb-variant-id');
              if(vid) vid.value = match.id;
              /* Update displayed price if possible */
              var priceEls = doc.querySelectorAll('.hb-page [data-hb-price]');
              priceEls.forEach(function(pe){ pe.textContent = match.price; });
            }
          });
        });
      }
    } catch(e){}
  }

})();
</script>

<!-- ===================== ORDER NOTIFICATION POPUP ===================== -->
<div class="hb-page" id="hbOrderPopup" style="
  position:fixed;bottom:20px;right:20px;z-index:99999;
  background:#fff;border-radius:14px;padding:14px 16px;
  box-shadow:0 8px 32px rgba(33,76,53,0.18);
  display:flex;align-items:center;gap:12px;max-width:280px;
  border-right:4px solid #214C35;
  transform:translateX(140%);
  transition:transform 0.5s cubic-bezier(0.34,1.56,0.64,1);
  font-family:'Tajawal',sans-serif;direction:rtl;
">
  <div style="width:38px;height:38px;border-radius:50%;background:#e8f4ed;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;">🛍️</div>
  <div style="flex:1;min-width:0;">
    <div id="hbPopupName" style="font-size:13px;font-weight:700;color:#214C35;margin-bottom:2px;"></div>
    <div id="hbPopupText" style="font-size:11px;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></div>
  </div>
  <button onclick="document.getElementById('hbOrderPopup').style.transform='translateX(140%)'"
    style="background:none;border:none;cursor:pointer;color:#aaa;font-size:18px;line-height:1;padding:0;flex-shrink:0;align-self:flex-start;">×</button>
</div>

<script>
(function(){
  var popup   = document.getElementById('hbOrderPopup');
  if(!popup) return;
  var nameEl  = document.getElementById('hbPopupName');
  var textEl  = document.getElementById('hbPopupText');
  var names   = ['أحمد','سارة','محمد','فاطمة','خالد','ليلى','يوسف','نادية','عمر','هند','عبدالله','ريم','سلمى','بدر','لمياء'];
  var cities  = ['الرياض','جدة','مكة','الدمام','المدينة','أبها','الطائف','تبوك','القصيم','حائل'];
  var times   = ['2','5','8','12','15','20','25'];
  var title   = {{ product.title | json }};

  function show(){
    var name = names[Math.floor(Math.random()*names.length)];
    var city = cities[Math.floor(Math.random()*cities.length)];
    var mins = times[Math.floor(Math.random()*times.length)];
    nameEl.textContent = name + ' من ' + city;
    textEl.textContent = 'طلبت ' + (title||'المنتج') + ' منذ ' + mins + ' دقيقة';
    popup.style.transform = 'translateX(0)';
    setTimeout(function(){ popup.style.transform = 'translateX(140%)'; }, 5000);
  }

  setTimeout(function(){
    show();
    setInterval(show, 18000);
  }, 8000);
})();
</script>

