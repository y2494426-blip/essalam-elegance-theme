          style="position:absolute;top:24px;right:24px;color:#fff;font-size:28px;background:rgba(255,255,255,.12);border:none;cursor:pointer;width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;">✕</button>
