<section id="hb-order">
  <div class="container" style="max-width:640px;text-align:center;">
    <div class="eyebrow" style="justify-content:center;display:flex;">أكملي طلبك</div>
    <h2 style="font-size:clamp(26px,3.4vw,36px);">إتمام الطلب</h2>
    <p style="color:#3d5c4b;margin-top:10px;">الدفع عند الاستلام — بدون أي دفع مسبق</p>

    <div class="form-card">
      <div class="form-total">
        <span>السعر الإجمالي</span>
        <span>
          {% if product.price %}
            {{ current_variant.price | money }}
          {% else %}
            — ريال
          {% endif %}
        </span>
      </div>

      {%- form 'product', product, id: 'hb-product-form', novalidate: true -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="hb-variant-id">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="hb-var-sec">
              <span class="hb-var-lbl">{{ option.name }}</span>
              <div class="hb-var-pills">
                {%- for value in option.values -%}
                  <label class="hb-var-pill">
                    <input type="radio" name="{{ option.name }}" value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}>
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="hb-qty-row">
          <span class="hb-qty-lbl">الكمية:</span>
          <div class="hb-qty-box">
            <button type="button" class="hb-qty-btn" onclick="var q=document.getElementById('hb-qty');if(q.value>1)q.value=+q.value-1;">−</button>
            <input type="number" id="hb-qty" name="quantity" value="1" min="1" class="hb-qty-inp" readonly>
            <button type="button" class="hb-qty-btn" onclick="var q=document.getElementById('hb-qty');q.value=+q.value+1;">+</button>
          </div>
        </div>

        {% content_for 'blocks' %}

        {% if current_variant.available %}
          <button type="submit" name="add" class="btn-primary hb-submit" id="hb-submit">
            🛒 أكملي طلبك الآن — الدفع عند الاستلام ←
          </button>
        {% else %}
          <button type="button" disabled class="btn-primary hb-submit" style="opacity:.5;cursor:not-allowed;">
            نفذت الكمية — تواصلي معنا
          </button>
        {% endif %}

      {%- endform -%}

      <p class="hb-secure">🔒 طلبك آمن 100% — لا دفع مسبق</p>
      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:14px;">
        <span style="font-size:13px;font-weight:600;color:#5b7a68;">✅ دفع عند الاستلام</span>
        <span style="font-size:13px;font-weight:600;color:#5b7a68;">🚚 توصيل سريع</span>
        <span style="font-size:13px;font-weight:600;color:#5b7a68;">🛡️ ضمان الجودة</span>
      </div>
    </div>
  </div>
</section>

