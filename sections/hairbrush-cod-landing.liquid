<!-- ==================== GALLERY ==================== -->
{% if product.images.size > 1 %}
<section style="background:var(--offwhite);">
  <div class="container">
    <div class="eyebrow" style="justify-content:center;display:flex;">معرض الصور</div>
    <h2 style="text-align:center;font-size:clamp(26px,3.4vw,36px);">شاهديها من كل زاوية</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;margin-top:36px;">
      {% for image in product.images limit: 8 %}
        <div style="border-radius:var(--radius-md);overflow:hidden;box-shadow:var(--shadow-tiny);cursor:zoom-in;transition:transform .3s,box-shadow .3s;"
             data-hb-lb="{{ image | image_url: width: 1200 }}"
             onmouseover="this.style.transform='scale(1.04)';this.style.boxShadow='var(--shadow-soft)'"
             onmouseout="this.style.transform='';this.style.boxShadow='var(--shadow-tiny)'">
          <img src="{{ image | image_url: width: 500 }}" loading="lazy"
               alt="{{ image.alt | default: product.title }}"
               style="width:100%;aspect-ratio:1;object-fit:cover;display:block;">
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

