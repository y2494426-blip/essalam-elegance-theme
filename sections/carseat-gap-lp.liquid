{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_img = current_variant.featured_image | default: product.featured_image
  assign img2 = product.media[1]
  assign img3 = product.media[2]
  assign price_money = current_variant.price | money_without_trailing_zeros
  assign compare_money = current_variant.compare_at_price | money_without_trailing_zeros
-%}

<style>
  :root{
    --black:#111111;
    --white:#FFFFFF;
    --accent:#E53935;
    --accent-dark:#c62828;
    --bg-soft:#F8F8F8;
    --trust-green:#2E7D32;
    --line:#ECECEC;
    --radius-lg:28px;
    --radius-md:18px;
    --radius-sm:12px;
    --shadow-soft: 0 20px 45px rgba(17,17,17,0.08);
    --shadow-card: 0 10px 30px rgba(17,17,17,0.06);
    --ease: cubic-bezier(.16,.84,.32,1);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  .cs-body{
    margin:0;
    font-family:'Tajawal', sans-serif;
    background:var(--white);
    color:var(--black);
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
    direction:rtl;
  }
  h1,h2,h3,h4,.cs-display{
    font-family:'Cairo', sans-serif;
    font-weight:800;
    margin:0;
    line-height:1.25;
  }
  p{margin:0;}
  img{max-width:100%;display:block;}
  a{text-decoration:none;color:inherit;}
  ul{margin:0;padding:0;list-style:none;}
  .cs-container{max-width:1140px;margin:0 auto;padding:0 20px;}
  section{position:relative;}
  .cs-pad{padding:64px 0;}
  .cs-bg-soft{background:var(--bg-soft);}
  .cs-eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-size:13px;font-weight:700;color:var(--accent);
    background:rgba(229,57,53,0.08);padding:8px 16px;
    border-radius:999px;margin-bottom:16px;
  }
  .cs-center{text-align:center;}
  .cs-section-title{font-size:clamp(24px,5vw,38px);margin-bottom:14px;}
  .cs-section-sub{font-size:16px;color:#555;max-width:560px;margin:0 auto;line-height:1.8;}

  /* reveal */
  .cs-reveal{opacity:0;transform:translateY(28px);transition:opacity .8s var(--ease),transform .8s var(--ease);}
  .cs-reveal.in{opacity:1;transform:translateY(0);}

  /* gap motif */
  .cs-gap-divider{position:relative;height:46px;display:flex;align-items:center;justify-content:center;margin:0 auto;}
  .cs-gap-divider svg{width:220px;height:46px;}
  .cs-gap-dash{stroke:var(--accent);stroke-width:2.5;stroke-dasharray:6 8;fill:none;stroke-linecap:round;animation:csDashMove 2.4s linear infinite;}
  @keyframes csDashMove{to{stroke-dashoffset:-56;}}

  /* topbar */
  .cs-topbar{background:var(--black);color:var(--white);font-size:12.5px;font-weight:500;text-align:center;padding:9px 10px;letter-spacing:.2px;}

  /* header */
  header.cs-site{position:sticky;top:0;z-index:60;background:rgba(255,255,255,0.85);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);}
  .cs-nav-wrap{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;max-width:1140px;margin:0 auto;}
  .cs-logo{font-family:'Cairo',sans-serif;font-weight:900;font-size:20px;letter-spacing:.5px;}
  .cs-logo span{color:var(--accent);}
  .cs-nav-cta{background:var(--accent);color:#fff;font-weight:700;font-size:14px;padding:11px 22px;border-radius:999px;box-shadow:0 8px 20px rgba(229,57,53,0.35);transition:transform .25s var(--ease);}
  .cs-nav-cta:active{transform:scale(.96);}

  /* hero */
  .cs-hero{padding:38px 0 20px;background:radial-gradient(circle at 85% 0%, rgba(229,57,53,0.06), transparent 55%),linear-gradient(180deg,#0d0d0d 0%,#111111 55%,#161616 100%);color:#fff;overflow:hidden;}
  .cs-hero-grid{display:grid;grid-template-columns:1fr;gap:28px;align-items:center;}
  .cs-hero-copy{text-align:center;}
  .cs-hero-badges{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-bottom:18px;}
  .cs-hero-badge{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.14);color:#eee;font-size:12px;font-weight:600;padding:7px 13px;border-radius:999px;}
  .cs-hero h1{font-size:clamp(28px,7vw,46px);color:#fff;margin-bottom:16px;}
  .cs-hero h1 em{font-style:normal;color:var(--accent);}
  .cs-hero-sub{font-size:clamp(15px,3.6vw,19px);color:#c9c9c9;max-width:520px;margin:0 auto 26px;line-height:1.9;}
  .cs-trust-row{display:flex;justify-content:center;gap:18px;flex-wrap:wrap;margin:26px 0 8px;font-size:13.5px;color:#ddd;font-weight:600;}
  .cs-trust-row .item{display:flex;align-items:center;gap:6px;}
  .cs-cta-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--accent);color:#fff;font-family:'Cairo',sans-serif;font-weight:800;font-size:18px;padding:18px 44px;border-radius:999px;border:none;cursor:pointer;box-shadow:0 14px 30px rgba(229,57,53,0.4);transition:transform .25s var(--ease);width:100%;max-width:360px;}
  .cs-cta-btn:active{transform:scale(.97);}
  .cs-cta-wrap{display:flex;justify-content:center;}
  .cs-hero-img-wrap{position:relative;border-radius:var(--radius-lg);overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,0.5);margin:0 8px;}
  .cs-hero-img-wrap img{width:100%;height:auto;}
  .cs-hero-note{text-align:center;font-size:12.5px;color:#9a9a9a;margin-top:14px;}

  @media(min-width:860px){
    .cs-hero-grid{grid-template-columns:1.05fr .95fr;text-align:right;}
    .cs-hero-copy{text-align:right;}
    .cs-hero-badges,.cs-cta-wrap,.cs-trust-row{justify-content:flex-start;}
    .cs-hero-sub{margin:0 0 26px;}
    .cs-hero h1{font-size:clamp(34px,4.2vw,54px);}
  }

  /* benefits */
  .cs-benefit-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:38px;}
  @media(min-width:720px){.cs-benefit-grid{grid-template-columns:repeat(3,1fr);}}
  .cs-benefit-card{background:#fff;border-radius:var(--radius-md);padding:26px 18px;text-align:center;box-shadow:var(--shadow-card);border:1px solid var(--line);transition:transform .3s var(--ease),box-shadow .3s var(--ease);}
  .cs-benefit-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-soft);}
  .cs-icon-circle{width:56px;height:56px;border-radius:50%;background:var(--black);color:#fff;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;}
  .cs-benefit-card h3{font-size:15.5px;margin-bottom:6px;}
  .cs-benefit-card p{font-size:13px;color:#666;line-height:1.7;}
  .cs-icon-svg{width:26px;height:26px;}

  /* problem/solution */
  .cs-ps-grid{display:grid;grid-template-columns:1fr;gap:30px;align-items:center;}
  @media(min-width:860px){.cs-ps-grid{grid-template-columns:1fr 1fr;}}
  .cs-ps-images{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .cs-ps-images img{border-radius:var(--radius-md);box-shadow:var(--shadow-card);height:100%;object-fit:cover;}
  .cs-ps-text h2{font-size:clamp(24px,5vw,34px);margin-bottom:18px;}
  .cs-ps-text p{font-size:16px;color:#555;line-height:1.9;margin-bottom:14px;}
  .cs-ps-text .cs-highlight{color:var(--accent);font-weight:700;}

  /* before/after */
  .cs-ba-grid{display:grid;grid-template-columns:1fr;gap:18px;margin-top:36px;}
  @media(min-width:720px){.cs-ba-grid{grid-template-columns:1fr 1fr;}}
  .cs-ba-card{border-radius:var(--radius-md);padding:28px 24px;box-shadow:var(--shadow-card);}
  .cs-ba-card.before{background:#fff;border:2px solid #f3d9d8;}
  .cs-ba-card.after{background:var(--black);color:#fff;}
  .cs-ba-title{font-family:'Cairo',sans-serif;font-weight:800;font-size:19px;margin-bottom:16px;display:flex;align-items:center;gap:8px;}
  .cs-ba-card li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;padding:8px 0;border-bottom:1px dashed rgba(0,0,0,0.08);}
  .cs-ba-card.after li{border-bottom:1px dashed rgba(255,255,255,0.12);}
  .cs-ba-card li:last-child{border-bottom:none;}

  /* features */
  .cs-feat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:36px;}
  @media(min-width:720px){.cs-feat-grid{grid-template-columns:repeat(5,1fr);}}
  .cs-feat-card{background:#fff;border-radius:var(--radius-md);padding:22px 14px;text-align:center;box-shadow:var(--shadow-card);border:1px solid var(--line);}
  .cs-feat-card .cs-icon-circle{background:var(--accent);}
  .cs-feat-card h4{font-size:14px;}

  /* steps */
  .cs-steps-wrap{display:flex;flex-direction:column;gap:0;margin-top:40px;}
  .cs-step-item{display:flex;gap:18px;align-items:flex-start;padding:22px 0;}
  .cs-step-num{flex:0 0 auto;width:52px;height:52px;border-radius:50%;background:var(--black);color:#fff;font-family:'Cairo',sans-serif;font-weight:800;font-size:20px;display:flex;align-items:center;justify-content:center;}
  .cs-step-content h3{font-size:17px;margin-bottom:6px;}
  .cs-step-content p{font-size:14px;color:#666;line-height:1.7;}
  .cs-step-connector{width:2px;background:repeating-linear-gradient(180deg,var(--accent) 0 8px,transparent 8px 16px);margin-right:25px;height:24px;}

  /* reviews */
  .cs-review-scroll{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;margin-top:36px;}
  .cs-review-card{background:#fff;border-radius:var(--radius-md);padding:22px;box-shadow:var(--shadow-card);border:1px solid var(--line);}
  .cs-review-top{display:flex;align-items:center;gap:12px;margin-bottom:12px;}
  .cs-avatar{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#2b2b2b,#4a4a4a);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-family:'Cairo',sans-serif;font-size:15px;flex-shrink:0;}
  .cs-review-name{font-weight:700;font-size:14.5px;}
  .cs-verified{display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--trust-green);font-weight:700;margin-top:2px;}
  .cs-stars{color:#f5a623;font-size:14px;letter-spacing:2px;margin-bottom:10px;}
  .cs-review-text{font-size:14px;color:#444;line-height:1.8;}

  /* stats */
  .cs-stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:30px;}
  .cs-stat-card{text-align:center;padding:20px 8px;}
  .cs-stat-num{font-family:'Cairo',sans-serif;font-weight:900;font-size:clamp(28px,7vw,44px);color:var(--accent);}
  .cs-stat-label{font-size:12.5px;color:#ccc;margin-top:6px;line-height:1.6;}
  .cs-stats-section{background:var(--black);color:#fff;}
  .cs-stats-section .cs-section-sub{color:#aaa;}

  /* compare */
  .cs-compare-table{width:100%;border-collapse:separate;border-spacing:0;margin-top:34px;background:#fff;border-radius:var(--radius-md);overflow:hidden;box-shadow:var(--shadow-card);font-size:14px;}
  .cs-compare-table th,.cs-compare-table td{padding:14px 10px;text-align:center;border-bottom:1px solid var(--line);}
  .cs-compare-table th{font-family:'Cairo',sans-serif;font-weight:800;font-size:14px;}
  .cs-compare-table th:first-child,.cs-compare-table td:first-child{text-align:right;font-weight:600;}
  .cs-compare-table thead tr th.us{background:var(--black);color:#fff;}
  .cs-compare-table thead tr th.them{background:#f1f1f1;color:#777;}
  .cs-yes{color:var(--trust-green);font-size:17px;font-weight:900;}
  .cs-no{color:#c62828;font-size:17px;font-weight:900;}

  /* FAQ */
  .cs-faq-item{background:#fff;border:1px solid var(--line);border-radius:var(--radius-sm);margin-bottom:12px;overflow:hidden;}
  .cs-faq-q{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;cursor:pointer;font-weight:700;font-size:15px;gap:12px;}
  .cs-faq-q .cs-plus{flex-shrink:0;width:26px;height:26px;border-radius:50%;background:var(--bg-soft);display:flex;align-items:center;justify-content:center;transition:transform .3s var(--ease);font-size:16px;color:var(--accent);font-weight:900;}
  .cs-faq-item.open .cs-plus{transform:rotate(45deg);}
  .cs-faq-a{max-height:0;overflow:hidden;transition:max-height .35s var(--ease),padding .35s var(--ease);padding:0 20px;font-size:14px;color:#666;line-height:1.8;}
  .cs-faq-item.open .cs-faq-a{max-height:300px;padding:0 20px 20px;}

  /* trust icons */
  .cs-trust-icons-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:30px;}
  @media(min-width:720px){.cs-trust-icons-grid{grid-template-columns:repeat(4,1fr);}}
  .cs-trust-icon-card{text-align:center;padding:20px 10px;}
  .cs-trust-icon-card .cs-icon-circle{background:var(--trust-green);}
  .cs-trust-icon-card h4{font-size:13.5px;}

  /* offer cards */
  .cs-offer-grid{display:grid;grid-template-columns:1fr;gap:18px;margin-top:30px;max-width:820px;margin-inline:auto;}
  @media(min-width:720px){.cs-offer-grid{grid-template-columns:repeat(2,1fr);align-items:center;}}
  .cs-offer-card{position:relative;background:#fff;border:2px solid var(--line);border-radius:var(--radius-md);padding:24px 18px;text-align:center;cursor:pointer;transition:all .25s var(--ease);}
  .cs-offer-card.selected{border-color:var(--accent);box-shadow:0 12px 26px rgba(229,57,53,0.18);transform:translateY(-4px);}
  .cs-offer-card.featured{border-width:3px;padding:32px 22px;box-shadow:var(--shadow-soft);}
  @media(min-width:720px){.cs-offer-card.featured{transform:scale(1.06);}.cs-offer-card.featured.selected{transform:scale(1.06) translateY(-4px);}}
  .cs-offer-badge{position:absolute;top:-14px;right:50%;transform:translateX(50%);background:var(--accent);color:#fff;font-size:12px;font-weight:800;padding:6px 16px;border-radius:999px;white-space:nowrap;box-shadow:0 8px 18px rgba(229,57,53,0.35);}
  .cs-offer-qty{font-family:'Cairo',sans-serif;font-weight:800;font-size:17px;margin-bottom:4px;}
  .cs-offer-sub{font-size:12.5px;color:#888;margin-bottom:10px;}
  .cs-offer-price{font-family:'Cairo',sans-serif;font-weight:900;font-size:26px;color:var(--accent);}
  .cs-offer-old{font-size:13px;color:#999;text-decoration:line-through;margin-inline-start:6px;}
  .cs-offer-unit{font-size:12.5px;color:#666;margin-top:8px;line-height:1.7;}
  .cs-offer-savings{display:inline-block;margin-top:12px;background:rgba(46,125,50,0.09);color:var(--trust-green);font-size:12.5px;font-weight:700;padding:6px 14px;border-radius:999px;}
  .cs-offer-cta{display:inline-flex;align-items:center;justify-content:center;width:100%;margin-top:16px;background:var(--black);color:#fff;font-family:'Cairo',sans-serif;font-weight:700;font-size:14.5px;padding:13px 10px;border-radius:999px;border:none;cursor:pointer;transition:transform .2s var(--ease);}
  .cs-offer-card.featured .cs-offer-cta{background:var(--accent);box-shadow:0 10px 22px rgba(229,57,53,0.3);}
  .cs-offer-cta:active{transform:scale(.97);}

  /* ============================================================
     ORDER SECTION — EasySell App Block Integration
     ============================================================ */
  .cs-order-section{background:var(--bg-soft);}
  .cs-order-box{
    background:#fff;
    border-radius:var(--radius-lg);
    box-shadow:var(--shadow-soft);
    padding:30px 22px;
    margin-top:20px;
    max-width:560px;
    margin-inline:auto;
  }
  .cs-order-summary{display:flex;align-items:center;gap:14px;padding-bottom:20px;margin-bottom:20px;border-bottom:1px solid var(--line);}
  .cs-order-summary img{width:70px;height:70px;object-fit:cover;border-radius:14px;}
  .cs-order-summary .cs-name{font-weight:700;font-size:15px;}
  .cs-order-summary .cs-price{color:var(--accent);font-weight:800;font-family:'Cairo',sans-serif;font-size:18px;margin-top:4px;}
  /* Variant hidden input helper */
  .cs-variant-select{display:none;}

  /* EasySell renders its own fields inside content_for blocks —
     these styles make sure it inherits the page's look */
  .cs-order-box input[type="text"],
  .cs-order-box input[type="tel"],
  .cs-order-box input[type="email"],
  .cs-order-box select,
  .cs-order-box textarea{
    width:100%;padding:15px 16px;border-radius:14px;
    border:1.5px solid #e4e4e4;
    font-family:'Tajawal',sans-serif;font-size:15px;
    background:#fafafa;transition:border-color .2s;
    margin-bottom:14px;
  }
  .cs-order-box input:focus,
  .cs-order-box select:focus,
  .cs-order-box textarea:focus{outline:none;border-color:var(--accent);background:#fff;}
  .cs-order-box label{display:block;font-size:13.5px;font-weight:700;margin-bottom:8px;color:#333;}
  /* Submit button rendered by EasySell */
  .cs-order-box button[type="submit"],
  .cs-order-box input[type="submit"],
  .cs-order-box button[name="add"]{
    width:100%;background:var(--accent);color:#fff;border:none;
    padding:18px;border-radius:16px;
    font-family:'Cairo',sans-serif;font-weight:800;font-size:17px;
    cursor:pointer;box-shadow:0 12px 26px rgba(229,57,53,0.35);
    display:flex;align-items:center;justify-content:center;gap:10px;
    transition:transform .2s;margin-top:8px;
  }
  .cs-order-box button[type="submit"]:active,
  .cs-order-box button[name="add"]:active{transform:scale(.98);}
  .cs-order-note{text-align:center;font-size:12px;color:#999;margin-top:14px;display:flex;align-items:center;justify-content:center;gap:6px;}

  /* floating / sticky */
  .cs-scrolltop-btn{position:fixed;bottom:100px;right:18px;width:48px;height:48px;border-radius:50%;background:var(--black);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 20px rgba(0,0,0,0.25);z-index:70;opacity:0;pointer-events:none;transition:opacity .3s;}
  .cs-scrolltop-btn.show{opacity:1;pointer-events:auto;}
  .cs-sticky-mobile{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--line);padding:12px 16px;display:flex;gap:12px;align-items:center;z-index:65;box-shadow:0 -10px 24px rgba(0,0,0,0.08);transform:translateY(110%);transition:transform .35s var(--ease);}
  .cs-sticky-mobile.show{transform:translateY(0);}
  .cs-sticky-mobile .cs-price-block{flex-shrink:0;}
  .cs-sticky-mobile .cs-price-block .cs-p{font-family:'Cairo',sans-serif;font-weight:900;font-size:17px;color:var(--accent);}
  .cs-sticky-mobile .cs-price-block .cs-op{font-size:11px;color:#999;text-decoration:line-through;}
  .cs-sticky-mobile .cs-cta-btn{padding:14px 10px;font-size:15px;flex:1;max-width:none;}
  @media(min-width:860px){.cs-sticky-mobile{display:none;}}

  /* footer */
  .cs-footer{background:var(--black);color:#ccc;padding:50px 0 110px;font-size:13.5px;}
  @media(min-width:860px){.cs-footer{padding-bottom:50px;}}
  .cs-footer-grid{display:grid;grid-template-columns:1fr;gap:26px;margin-bottom:30px;}
  @media(min-width:720px){.cs-footer-grid{grid-template-columns:2fr 1fr 1fr;}}
  .cs-footer-logo{font-family:'Cairo',sans-serif;font-weight:900;font-size:19px;color:#fff;margin-bottom:10px;}
  .cs-footer-col h5{color:#fff;font-size:14px;margin-bottom:14px;font-weight:700;}
  .cs-footer-col li{margin-bottom:10px;color:#999;}
  .cs-payment-icons{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;}
  .cs-payment-icons span{background:#1e1e1e;border-radius:8px;padding:6px 10px;font-size:11px;color:#bbb;}
  .cs-footer-bottom{border-top:1px solid #262626;padding-top:20px;text-align:center;color:#777;font-size:12px;}
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&family=Cairo:wght@600;700;800;900&display=swap" rel="stylesheet">

<div class="cs-body">

<div class="cs-topbar">🔥 عرض حصري لفترة محدودة — شحن مجاني + الدفع عند الاستلام في جميع مناطق المملكة</div>

<header class="cs-site">
  <div class="cs-nav-wrap">
    <div class="cs-logo">سدّاد<span>.</span></div>
    <a href="#cs-order" class="cs-nav-cta">اطلب الآن</a>
  </div>
</header>

<!-- HERO -->
<section class="cs-hero">
  <div class="cs-container">
    <div class="cs-hero-grid">
      <div class="cs-hero-copy cs-reveal">
        <div class="cs-hero-badges">
          <span class="cs-hero-badge">⭐ أكثر من 5000 عميل سعيد</span>
          <span class="cs-hero-badge">🚚 شحن مجاني لكل المناطق</span>
          <span class="cs-hero-badge">💵 الدفع عند الاستلام</span>
        </div>
        <h1>ودّع ضياع أغراضك <em>داخل السيارة</em> نهائيًا</h1>
