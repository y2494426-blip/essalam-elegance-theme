<!-- ================================================================
     ORDER SECTION — EasySell COD App Block
     ================================================================
     HOW THIS WORKS:
     1. {%- form 'product', product -%} wraps everything — this is
        Shopify's standard product form that EasySell intercepts.
     2. The hidden input keeps the selected variant in sync.
     3. {% content_for 'blocks' %} renders the EasySell App Block
        that you add from the Theme Editor → Add block → EasySell.
        EasySell injects its OWN fields (name, phone, address, city)
        and its OWN submit button through this tag.
     4. The schema below declares { "type": "@app" } which makes
        the "Add block" button appear in Theme Editor.
     ================================================================ -->
<section class="cs-pad cs-order-section" id="cs-order">
  <div class="cs-container">
    <div class="cs-center cs-reveal">
      <span class="cs-eyebrow">آخر خطوة</span>
      <h2 class="cs-section-title">اطلب الآن</h2>
      <p class="cs-section-sub">عبّئ بياناتك وسيصلك طلبك خلال أيام قليلة، مع إمكانية الدفع عند الاستلام.</p>
    </div>

    <div class="cs-order-box cs-reveal">
      <!-- Product summary -->
      <div class="cs-order-summary">
        {%- if product_img -%}
          {{ product_img | image_url: width: 140 | image_tag: alt: product.title, loading: 'lazy', style: 'width:70px;height:70px;object-fit:cover;border-radius:14px;' }}
        {%- endif -%}
        <div>
          <div class="cs-name">{{ product.title }}</div>
          <div class="cs-price" id="cs-orderPriceDisplay">{{ price_money }}</div>
          <div style="font-size:12px;color:var(--trust-green);font-weight:700;margin-top:4px;">🚚 شحن مجاني</div>
        </div>
      </div>

      <!-- EasySell product form — DO NOT remove the form tag or content_for -->
      {%- form 'product', product, id: 'cs-product-form', novalidate: true -%}
        {%- comment -%} Keeps selected variant in sync with offer cards above {%- endcomment -%}
        <input type="hidden" name="id" id="cs-variant-id" value="{{ current_variant.id }}">

        {%- comment -%}
          {% content_for 'blocks' %} is where EasySell renders its
          COD form fields and submit button.
          To activate: Theme Editor → this section → Add block → EasySell COD Form
        {%- endcomment -%}
        {% content_for 'blocks' %}

      {%- endform -%}

      <div class="cs-order-note">🔒 معلوماتك بأمان تام ولن تُشارك مع أي جهة</div>
    </div>
  </div>
</section>

<!-- FLOATING SCROLL TOP -->
