<script>
  var csVariants = {{ product.variants | json }};

  /* ---- Variant selection from offer cards ---- */
  function csSelectVariant(variantId, card) {
    // update hidden input
    var inp = document.getElementById('cs-variant-id');
    if (inp) inp.value = variantId;

    // highlight selected offer card
    document.querySelectorAll('.cs-offer-card').forEach(function(c){ c.classList.remove('selected'); });
    if (card) card.classList.add('selected');

    // find variant data
    var v = csVariants.find(function(x){ return String(x.id) === String(variantId); });
    if (!v) return;

    // update displayed prices
    var price = Math.round(v.price / 100) + ' ر.س';
    var els = ['cs-orderPriceDisplay','cs-stickyPrice'];
    els.forEach(function(id){ var el=document.getElementById(id); if(el) el.textContent=price; });

    // update product image
    if (v.featured_image && v.featured_image.src) {
      var imgs = document.querySelectorAll('.cs-hero-img-wrap img');
      imgs.forEach(function(img){ img.src = v.featured_image.src; });
    }

    // scroll to order form
    document.getElementById('cs-order').scrollIntoView({behavior:'smooth'});
  }

  /* ---- Reveal on scroll ---- */
  var csRevealEls = document.querySelectorAll('.cs-reveal');
  var csIO = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting){ e.target.classList.add('in'); csIO.unobserve(e.target); }
    });
  }, {threshold:0.12});
  csRevealEls.forEach(function(el){ csIO.observe(el); });

  /* ---- Animated counters ---- */
  var csCounters = document.querySelectorAll('.cs-stat-num');
  var csCIO = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if (entry.isIntersecting){
        var el = entry.target;
        var target = parseInt(el.getAttribute('data-target'), 10);
        var suffix = el.getAttribute('data-suffix') || '';
        var cur = 0;
        var step = Math.max(1, Math.ceil(target/60));
        var timer = setInterval(function(){
          cur += step;
          if (cur >= target){ cur = target; clearInterval(timer); }
          el.textContent = cur + suffix;
        }, 25);
        csCIO.unobserve(el);
      }
    });
  }, {threshold:0.4});
  csCounters.forEach(function(c){ csCIO.observe(c); });

  /* ---- FAQ accordion ---- */
  document.querySelectorAll('.cs-faq-item').forEach(function(item){
    item.querySelector('.cs-faq-q').addEventListener('click', function(){
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.cs-faq-item.open').forEach(function(o){ o.classList.remove('open'); });
      if (!isOpen) item.classList.add('open');
    });
  });

  /* ---- Sticky mobile + scroll top ---- */
  var csStickyMobile = document.getElementById('cs-stickyMobile');
  var csScrollTopBtn = document.getElementById('cs-scrollTopBtn');
  var csOrderSection = document.getElementById('cs-order');
  window.addEventListener('scroll', function(){
    var showAfter = window.innerHeight * 0.8;
    if (window.scrollY > showAfter){
      if (csStickyMobile) csStickyMobile.classList.add('show');
      if (csScrollTopBtn) csScrollTopBtn.classList.add('show');
    } else {
      if (csStickyMobile) csStickyMobile.classList.remove('show');
      if (csScrollTopBtn) csScrollTopBtn.classList.remove('show');
    }
    if (csOrderSection) {
      var rect = csOrderSection.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.5 && csStickyMobile){
        csStickyMobile.classList.remove('show');
      }
    }
  });
</script>

