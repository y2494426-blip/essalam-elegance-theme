{%- assign current_variant = product.selected_or_first_available_variant -%}
<style>
@import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap');
:root{
  --pr-pink:#E91E63;--pr-pink-dark:#C2185B;--pr-pink-light:#F48FB1;
  --pr-pink-pale:#FCE4EC;--pr-pink-bg:#FFF0F5;
  --pr-gold:#C9A227;--pr-gold-light:#F0D080;--pr-gold-pale:#FFF8E7;
  --pr-white:#FFFFFF;--pr-dark:#222222;--pr-gray:#6B7280;--pr-light-gray:#F9F9F9;
  --pr-shadow:0 4px 24px rgba(233,30,99,.1);--pr-shadow-lg:0 16px 56px rgba(233,30,99,.16);
  --pr-shadow-gold:0 8px 32px rgba(201,162,39,.2);
  --pr-r:20px;--pr-r-sm:14px;--pr-r-xs:8px
}
.pr-page*{box-sizing:border-box;margin:0;padding:0}
.pr-page{font-family:'Tajawal',sans-serif;direction:rtl;background:var(--pr-white);color:var(--pr-dark);overflow-x:hidden}
/* LOADER */
.pr-loader{position:fixed;inset:0;background:var(--pr-white);z-index:99999;display:flex;align-items:center;justify-content:center;transition:opacity .6s,visibility .6s}
.pr-loader.gone{opacity:0;visibility:hidden;pointer-events:none}
.pr-loader__ring{width:52px;height:52px;border:3px solid var(--pr-pink-pale);border-top-color:var(--pr-pink);border-radius:50%;animation:pr-spin .8s linear infinite;margin:0 auto 12px}
.pr-loader__logo{font-size:15px;font-weight:800;color:var(--pr-pink);letter-spacing:1px}
@keyframes pr-spin{to{transform:rotate(360deg)}}
/* PROGRESS */
.pr-progress{position:fixed;top:0;right:0;left:0;height:2px;background:linear-gradient(90deg,var(--pr-pink-light),var(--pr-pink));transform-origin:right;z-index:9999;transform:scaleX(0)}
/* TOAST */
.pr-toast{position:fixed;bottom:90px;right:16px;background:#fff;border-radius:16px;padding:12px 15px;box-shadow:0 8px 32px rgba(0,0,0,.12);display:flex;align-items:center;gap:10px;z-index:8500;transform:translateX(140%);transition:transform .4s cubic-bezier(.34,1.56,.64,1);max-width:264px;border-right:3px solid var(--pr-pink)}
.pr-toast.show{transform:translateX(0)}
.pr-toast__txt{font-size:12px;line-height:1.5;color:#444}
.pr-toast__txt strong{color:var(--pr-pink);display:block;font-size:13px}
/* VIEWERS */
.pr-viewers{position:fixed;bottom:158px;right:16px;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);border-radius:30px;padding:7px 13px;box-shadow:var(--pr-shadow);display:flex;align-items:center;gap:6px;z-index:8499;font-size:12px;color:var(--pr-dark);animation:pr-fadein .5s 2.5s both}
.pr-viewers__dot{width:7px;height:7px;background:#4CAF50;border-radius:50%;animation:pr-pulse 2s infinite}
/* EXIT POPUP */
.pr-exit-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:99990;opacity:0;pointer-events:none;transition:opacity .3s;display:flex;align-items:center;justify-content:center;padding:20px}
.pr-exit-overlay.open{opacity:1;pointer-events:all}
.pr-exit-popup{background:#fff;border-radius:28px;padding:38px 28px;max-width:420px;width:100%;text-align:center;transform:scale(.9) translateY(20px);transition:transform .3s;position:relative;box-shadow:0 30px 80px rgba(0,0,0,.2)}
.pr-exit-overlay.open .pr-exit-popup{transform:scale(1) translateY(0)}
.pr-exit-close{position:absolute;top:14px;left:14px;background:none;border:none;font-size:22px;cursor:pointer;color:var(--pr-gray);width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:50%}
.pr-exit-close:hover{background:var(--pr-pink-pale)}
.pr-exit-popup__badge{display:inline-block;background:linear-gradient(135deg,var(--pr-pink),var(--pr-pink-dark));color:#fff;font-size:12px;font-weight:700;padding:4px 16px;border-radius:20px;margin-bottom:16px}
.pr-exit-popup__title{font-size:22px;font-weight:800;color:var(--pr-dark);margin-bottom:8px}
.pr-exit-popup__sub{font-size:14px;color:var(--pr-gray);margin-bottom:20px;line-height:1.7}
.pr-exit-popup__price{font-size:36px;font-weight:900;color:var(--pr-pink);margin-bottom:4px}
.pr-exit-popup__old{font-size:15px;color:var(--pr-gray);text-decoration:line-through;margin-bottom:22px}
.pr-exit-btn{display:block;width:100%;padding:16px;background:linear-gradient(135deg,var(--pr-pink),var(--pr-pink-dark));color:#fff;font-family:'Tajawal',sans-serif;font-size:17px;font-weight:800;border:none;border-radius:50px;cursor:pointer;transition:all .2s}
.pr-exit-btn:hover{transform:translateY(-2px);box-shadow:var(--pr-shadow-lg)}
/* WHATSAPP */
.pr-wa{position:fixed;bottom:90px;left:16px;width:52px;height:52px;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(37,211,102,.4);z-index:8400;text-decoration:none;animation:pr-fadein .5s 3s both;transition:transform .2s}
.pr-wa:hover{transform:scale(1.1)}
.pr-wa svg{width:26px;height:26px;fill:#fff}
/* ANIMS */
@keyframes pr-fadein{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes pr-float{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-12px) rotate(-1deg)}}
@keyframes pr-pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.6)}}
@keyframes pr-ripple{0%{transform:scale(0);opacity:.4}100%{transform:scale(4);opacity:0}}
@keyframes pr-shimmer{0%{background-position:200% center}100%{background-position:-200% center}}
@keyframes pr-glow-pink{0%,100%{box-shadow:0 0 20px rgba(233,30,99,.3)}50%{box-shadow:0 0 40px rgba(233,30,99,.6)}}
.pr-anim{opacity:0;transform:translateY(24px);transition:all .65s cubic-bezier(.22,1,.36,1)}
.pr-anim.visible{opacity:1;transform:translateY(0)}
.pr-d1{transition-delay:.1s}.pr-d2{transition-delay:.2s}.pr-d3{transition-delay:.3s}
.pr-d4{transition-delay:.4s}.pr-d5{transition-delay:.5s}.pr-d6{transition-delay:.6s}
/* TOP BAR */
.pr-topbar{background:linear-gradient(90deg,var(--pr-pink-dark),var(--pr-pink));padding:10px 20px;text-align:center}
.pr-topbar__txt{font-size:13px;color:rgba(255,255,255,.92);font-weight:500}
.pr-topbar__txt strong{color:#fff}
/* HERO */
.pr-hero{background:linear-gradient(160deg,#fff 0%,var(--pr-pink-bg) 50%,#fff 100%);padding:60px 20px 50px;position:relative;overflow:hidden}
.pr-hero__bg{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.pr-hero__blob{position:absolute;border-radius:50%;filter:blur(70px);opacity:.2}
.pr-hero__blob1{width:600px;height:600px;background:var(--pr-pink-pale);top:-150px;left:-200px}
.pr-hero__blob2{width:400px;height:400px;background:var(--pr-gold-pale);bottom:-100px;right:-100px}
.pr-hero__inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr;gap:52px;align-items:center;position:relative;z-index:1}
@media(min-width:768px){.pr-hero__inner{grid-template-columns:1fr 1fr}}
.pr-hero__content{text-align:center}
@media(min-width:768px){.pr-hero__content{text-align:right}}
.pr-hero__kicker{display:inline-flex;align-items:center;gap:7px;background:rgba(233,30,99,.08);border:1px solid rgba(233,30,99,.2);border-radius:30px;padding:6px 16px;font-size:12px;font-weight:700;color:var(--pr-pink);margin-bottom:16px;animation:pr-fadein .5s .3s both}
.pr-hero__title{font-size:clamp(24px,5.5vw,46px);font-weight:900;color:var(--pr-dark);line-height:1.25;margin-bottom:16px;animation:pr-fadein .6s .35s both}
.pr-hero__title em{font-style:normal;background:linear-gradient(135deg,var(--pr-pink),var(--pr-pink-dark));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.pr-hero__desc{font-size:clamp(14px,2.8vw,16px);color:var(--pr-gray);line-height:1.85;margin-bottom:22px;animation:pr-fadein .6s .4s both}
.pr-hero__price-card{background:#fff;border-radius:var(--pr-r);padding:18px 20px;margin-bottom:22px;box-shadow:var(--pr-shadow);border:1px solid var(--pr-pink-pale);display:inline-flex;align-items:center;gap:14px;flex-wrap:wrap;justify-content:center;animation:pr-fadein .6s .45s both}
@media(min-width:768px){.pr-hero__price-card{justify-content:flex-start}}
.pr-hero__price{font-size:34px;font-weight:900;color:var(--pr-pink);line-height:1}
.pr-hero__old-price{font-size:18px;color:var(--pr-gray);text-decoration:line-through;font-weight:400}
.pr-hero__save{background:linear-gradient(135deg,#FEF2F2,#FCE4EC);color:var(--pr-pink-dark);font-size:13px;font-weight:700;padding:4px 12px;border-radius:20px;border:1px solid var(--pr-pink-pale)}
.pr-hero__ship{display:inline-flex;align-items:center;gap:7px;background:linear-gradient(135deg,#F0FFF4,#DCFCE7);border:1px solid #BBF7D0;border-radius:30px;padding:6px 14px;font-size:13px;color:#15803D;font-weight:600;margin-bottom:22px;animation:pr-fadein .6s .5s both}
.pr-hero__btns{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-bottom:26px;animation:pr-fadein .6s .55s both}
@media(min-width:768px){.pr-hero__btns{justify-content:flex-start}}
.pr-btn-primary{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,var(--pr-pink),var(--pr-pink-dark));color:#fff;font-family:'Tajawal',sans-serif;font-size:16px;font-weight:800;padding:14px 30px;border-radius:50px;border:none;cursor:pointer;transition:all .2s;position:relative;overflow:hidden;animation:pr-glow-pink 3s 1s infinite}
.pr-btn-primary:hover{transform:translateY(-2px);box-shadow:var(--pr-shadow-lg)}
.pr-btn-ghost{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--pr-pink);font-family:'Tajawal',sans-serif;font-size:16px;font-weight:700;padding:14px 28px;border-radius:50px;border:2px solid var(--pr-pink-pale);cursor:pointer;transition:all .2s}
.pr-btn-ghost:hover{background:var(--pr-pink-pale);border-color:var(--pr-pink-light)}
.pr-ripple{position:absolute;background:rgba(255,255,255,.3);border-radius:50%;width:20px;height:20px;pointer-events:none;animation:pr-ripple .6s linear;transform:translate(-50%,-50%)}
.pr-hero__badges{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;animation:pr-fadein .6s .6s both}
@media(min-width:768px){.pr-hero__badges{justify-content:flex-start}}
.pr-hero__badge-item{display:flex;align-items:center;gap:5px;font-size:13px;color:var(--pr-dark);font-weight:500}
.pr-hero__badge-item span:first-child{color:var(--pr-pink)}
/* HERO IMAGE */
.pr-hero__img-wrap{display:flex;justify-content:center;align-items:center;position:relative}
.pr-hero__img{width:100%;max-width:400px;border-radius:30px;box-shadow:var(--pr-shadow-lg);animation:pr-float 5s ease-in-out infinite;cursor:zoom-in;transition:transform .3s}
.pr-hero__img:hover{transform:scale(1.03) rotate(-1deg)}
.pr-hero__img-badge{position:absolute;top:14px;right:14px;background:linear-gradient(135deg,var(--pr-gold),var(--pr-gold-light));color:#fff;font-size:12px;font-weight:700;padding:6px 14px;border-radius:20px;box-shadow:var(--pr-shadow-gold);text-shadow:0 1px 2px rgba(0,0,0,.15)}
.pr-hero__rating-pill{position:absolute;bottom:14px;right:14px;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-radius:30px;padding:7px 14px;box-shadow:var(--pr-shadow);display:flex;align-items:center;gap:7px}
.pr-hero__rating-stars{color:#F59E0B;font-size:14px}
.pr-hero__rating-txt{font-size:12px;font-weight:600;color:var(--pr-dark)}
/* COUNTDOWN */
.pr-countdown{background:linear-gradient(90deg,var(--pr-pink-dark),var(--pr-pink),#D81B60);padding:18px 20px;text-align:center}
.pr-countdown__inner{max-width:700px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap}
.pr-countdown__lbl{color:rgba(255,255,255,.92);font-size:14px;font-weight:600;white-space:nowrap}
.pr-countdown__timer{display:flex;align-items:center;gap:5px}
.pr-countdown__unit{background:rgba(255,255,255,.15);border-radius:8px;width:44px;height:44px;display:flex;flex-direction:column;align-items:center;justify-content:center}
.pr-countdown__num{font-size:18px;font-weight:900;color:#fff;line-height:1}
.pr-countdown__ulbl{font-size:9px;color:rgba(255,255,255,.7)}
.pr-countdown__sep{font-size:18px;font-weight:900;color:rgba(255,255,255,.6);margin-bottom:5px}
.pr-countdown__stock{display:flex;align-items:center;gap:6px;background:rgba(255,255,255,.15);border-radius:20px;padding:6px 14px;font-size:13px;color:#fff;font-weight:600;white-space:nowrap}
.pr-countdown__sdot{width:7px;height:7px;background:#FCD34D;border-radius:50%;animation:pr-pulse 1.5s infinite}
/* SECTIONS */
.pr-section{padding:72px 20px}
.pr-section--pink{background:var(--pr-pink-bg)}
.pr-section--gold{background:linear-gradient(135deg,#2D1B00,var(--pr-gold))}
.pr-container{max-width:1100px;margin:0 auto}
.pr-lbl{display:inline-block;font-size:11px;font-weight:700;padding:4px 14px;border-radius:20px;letter-spacing:.8px;margin-bottom:12px;text-transform:uppercase}
.pr-lbl--pink{background:var(--pr-pink-pale);color:var(--pr-pink)}
.pr-lbl--gold{background:rgba(255,255,255,.2);color:rgba(255,255,255,.9)}
.pr-lbl--white{background:rgba(255,255,255,.15);color:#fff}
.pr-h2{font-size:clamp(22px,5vw,36px);font-weight:800;color:var(--pr-dark);line-height:1.3;margin-bottom:14px}
.pr-h2--white{color:#fff}
.pr-p{font-size:15px;color:var(--pr-gray);line-height:1.8;max-width:680px}
.pr-p--white{color:rgba(255,255,255,.8)}
.pr-divider{width:44px;height:3px;border-radius:2px;margin:14px auto 0}
.pr-divider--pink{background:linear-gradient(90deg,var(--pr-pink),var(--pr-pink-light))}
.pr-divider--gold{background:linear-gradient(90deg,var(--pr-gold),var(--pr-gold-light))}
.pr-header{text-align:center;margin-bottom:48px}
/* BENEFITS */
.pr-benefits-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
@media(min-width:600px){.pr-benefits-grid{grid-template-columns:repeat(3,1fr)}}
.pr-benefit-card{background:#fff;border-radius:var(--pr-r);padding:24px 16px;text-align:center;box-shadow:0 2px 16px rgba(233,30,99,.06);border:1px solid var(--pr-pink-pale);transition:all .3s}
.pr-benefit-card:hover{transform:translateY(-5px);box-shadow:var(--pr-shadow);border-color:var(--pr-pink-light)}
.pr-benefit-card__icon{font-size:30px;margin-bottom:12px}
.pr-benefit-card__title{font-size:14px;font-weight:700;color:var(--pr-dark);margin-bottom:5px}
.pr-benefit-card__desc{font-size:12px;color:var(--pr-gray);line-height:1.6}
/* INGREDIENTS */
.pr-ing-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;max-width:800px;margin:0 auto}
@media(min-width:600px){.pr-ing-grid{grid-template-columns:repeat(3,1fr)}}
.pr-ing-card{background:#fff;border-radius:var(--pr-r);padding:22px 16px;text-align:center;box-shadow:var(--pr-shadow-gold);border:1px solid var(--pr-gold-pale);transition:all .3s}
.pr-ing-card:hover{transform:translateY(-4px);background:var(--pr-gold-pale)}
.pr-ing-card__icon{font-size:28px;margin-bottom:10px}
.pr-ing-card__name{font-size:14px;font-weight:700;color:var(--pr-gold);margin-bottom:5px}
.pr-ing-card__desc{font-size:12px;color:var(--pr-gray);line-height:1.6}
/* HOW TO USE */
.pr-timeline{display:flex;flex-direction:column;gap:0;max-width:480px;margin:0 auto}
.pr-tl-item{display:flex;gap:16px;align-items:flex-start;position:relative}
.pr-tl-item:not(:last-child)::after{content:'';position:absolute;right:19px;top:44px;width:2px;background:linear-gradient(180deg,var(--pr-pink),var(--pr-pink-pale));height:calc(100% - 8px);transform:translateX(50%)}
.pr-tl-num{min-width:40px;height:40px;background:linear-gradient(135deg,var(--pr-pink),var(--pr-pink-dark));border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;color:#fff;box-shadow:0 4px 14px rgba(233,30,99,.3);flex-shrink:0}
.pr-tl-body{padding:8px 0 28px}
.pr-tl-body h4{font-size:15px;font-weight:700;color:var(--pr-dark);margin-bottom:3px}
.pr-tl-body p{font-size:13px;color:var(--pr-gray);line-height:1.6}
/* WHY */
.pr-why-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
@media(min-width:600px){.pr-why-grid{grid-template-columns:repeat(3,1fr)}}
.pr-why-card{background:rgba(255,255,255,.1);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.2);border-radius:var(--pr-r);padding:22px 16px;text-align:center;transition:all .3s}
.pr-why-card:hover{background:rgba(255,255,255,.2);transform:translateY(-4px)}
.pr-why-card__icon{font-size:26px;margin-bottom:10px}
.pr-why-card__title{font-size:14px;font-weight:700;color:#fff;margin-bottom:4px}
.pr-why-card__desc{font-size:12px;color:rgba(255,255,255,.7);line-height:1.5}
/* BEFORE/AFTER */
.pr-ba-wrap{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:680px;margin:0 auto}
.pr-ba-card{border-radius:var(--pr-r);padding:28px 20px;text-align:center}
.pr-ba-card--before{background:#FEF2F2;border:1.5px solid #FECACA}
.pr-ba-card--after{background:linear-gradient(135deg,#FFF0F5,var(--pr-pink-pale));border:1.5px solid var(--pr-pink-light)}
.pr-ba-tag{font-size:14px;font-weight:800;margin-bottom:16px;display:block}
.pr-ba-card--before .pr-ba-tag{color:#DC2626}
.pr-ba-card--after .pr-ba-tag{color:var(--pr-pink)}
.pr-ba-item{font-size:14px;line-height:2.1;color:var(--pr-dark)}
/* SPECS */
.pr-specs{display:grid;grid-template-columns:1fr;gap:2px;max-width:560px;margin:0 auto;border-radius:var(--pr-r);overflow:hidden;box-shadow:var(--pr-shadow)}
.pr-spec-row{display:flex;align-items:center;gap:14px;padding:15px 20px;background:#fff}
.pr-spec-row:nth-child(even){background:var(--pr-pink-bg)}
.pr-spec-row__lbl{font-size:13px;color:var(--pr-gray);min-width:130px;font-weight:500}
.pr-spec-row__val{font-size:14px;font-weight:700;color:var(--pr-dark)}
/* REVIEWS */
.pr-rating-box{display:flex;align-items:center;gap:20px;background:var(--pr-pink-pale);border-radius:var(--pr-r);padding:22px;margin-bottom:28px;flex-wrap:wrap;justify-content:center}
.pr-rating-big__num{font-size:52px;font-weight:900;color:var(--pr-pink);line-height:1}
.pr-rating-big__stars{color:#F59E0B;font-size:20px}
.pr-rating-big__lbl{font-size:12px;color:var(--pr-gray);margin-top:3px}
.pr-reviews-grid{display:grid;grid-template-columns:1fr;gap:14px}
@media(min-width:600px){.pr-reviews-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:900px){.pr-reviews-grid{grid-template-columns:repeat(3,1fr)}}
.pr-rev-card{background:#fff;border:1px solid var(--pr-pink-pale);border-radius:var(--pr-r);padding:20px;transition:all .3s}
.pr-rev-card:hover{transform:translateY(-3px);box-shadow:var(--pr-shadow)}
.pr-rev-card__hd{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.pr-rev-card__av{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--pr-pink),var(--pr-pink-dark));display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:700;color:#fff;flex-shrink:0}
.pr-rev-card__name{font-size:14px;font-weight:700;color:var(--pr-dark)}
.pr-rev-card__city{font-size:12px;color:var(--pr-gray)}
.pr-rev-card__stars{color:#F59E0B;font-size:14px;margin-bottom:8px}
.pr-rev-card__txt{font-size:13px;color:#374151;line-height:1.75;font-style:italic}
.pr-rev-card__verified{display:inline-flex;align-items:center;gap:4px;font-size:11px;color:#16A34A;font-weight:600;margin-top:8px}
/* OFFER */
.pr-offer-box{background:linear-gradient(135deg,var(--pr-pink-dark) 0%,var(--pr-pink) 50%,#E91E8C 100%);border-radius:28px;padding:48px 28px;text-align:center;max-width:580px;margin:0 auto;position:relative;overflow:hidden}
.pr-offer-box__shine{position:absolute;top:-40px;right:-40px;width:200px;height:200px;background:rgba(255,255,255,.08);border-radius:50%;pointer-events:none}
.pr-offer-box__shine2{position:absolute;bottom:-60px;left:-30px;width:180px;height:180px;background:rgba(255,255,255,.05);border-radius:50%;pointer-events:none}
.pr-offer-box__lbl{display:inline-block;background:rgba(255,255,255,.2);color:#fff;font-size:13px;font-weight:700;padding:5px 18px;border-radius:20px;margin-bottom:18px}
.pr-offer-box__old{font-size:22px;color:rgba(255,255,255,.55);text-decoration:line-through;margin-bottom:6px}
.pr-offer-box__price{font-size:62px;font-weight:900;color:#fff;line-height:1;margin-bottom:6px}
