<script>
(function(){
  window.addEventListener('load',function(){setTimeout(function(){document.getElementById('pr-loader').classList.add('gone');},600);});
  var pb=document.getElementById('pr-progress');
  window.addEventListener('scroll',function(){var max=document.body.scrollHeight-window.innerHeight;if(pb&&max>0)pb.style.transform='scaleX('+(window.scrollY/max)+')';},{passive:true});
  var obs=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target);}});},{threshold:0.1,rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.pr-anim').forEach(function(el){obs.observe(el);});
  var toasts=[{n:'نادية من الدار البيضاء',t:'اشترت كريم الريتينول 💖'},{n:'إيمان من مراكش',t:'طلبت للمرة الثانية 🌸'},{n:'سلمى من الرباط',t:'أضافت للسلة ✨'},{n:'ريم من طنجة',t:'قيّمت 5 نجوم ⭐'},{n:'حنان من أكادير',t:'اشترت للتو 💖'},{n:'رجاء من فاس',t:'طلبت قطعتين 🎁'}];
  var tEl=document.getElementById('pr-toast'),tN=document.getElementById('pr-toast-name'),ti=0;
  function showT(){if(!tEl)return;var t=toasts[ti%toasts.length];ti++;tN.textContent=t.n;tEl.classList.add('show');setTimeout(function(){tEl.classList.remove('show');},3500);setTimeout(showT,9000+Math.random()*5000);}
  setTimeout(showT,3000);
  var vEl=document.getElementById('pr-viewers');
  if(vEl){setInterval(function(){var c=parseInt(vEl.textContent);vEl.textContent=Math.max(18,Math.min(40,c+(Math.random()>.5?1:-1)));},5000);}
  var end=Date.now()+(23*3600+59*60+59)*1000;
  function cd(){var d=Math.max(0,end-Date.now());var h=Math.floor(d/3600000),m=Math.floor(d%3600000/60000),s=Math.floor(d%60000/1000);var hEl=document.getElementById('pr-cdh'),mEl=document.getElementById('pr-cdm'),sEl=document.getElementById('pr-cds');if(hEl)hEl.textContent=String(h).padStart(2,'0');if(mEl)mEl.textContent=String(m).padStart(2,'0');if(sEl)sEl.textContent=String(s).padStart(2,'0');}
  setInterval(cd,1000);cd();
  var sticky=document.getElementById('pr-sticky'),ord=document.getElementById('pr-order');
  if(sticky&&ord){window.addEventListener('scroll',function(){var r=ord.getBoundingClientRect();sticky.style.display=r.top>window.innerHeight?'flex':'none';},{passive:true});}
  var exitShown=false;
  document.addEventListener('mouseleave',function(e){if(e.clientY<10&&!exitShown){exitShown=true;document.getElementById('pr-exit-overlay').classList.add('open');}});
  var lastSc=0;
  window.addEventListener('scroll',function(){var cur=window.scrollY;if(cur<50&&lastSc>300&&!exitShown){exitShown=true;setTimeout(function(){document.getElementById('pr-exit-overlay').classList.add('open');},400);}lastSc=cur;},{passive:true});
  document.querySelectorAll('.pr-btn-primary').forEach(function(btn){btn.addEventListener('click',function(e){var r=document.createElement('span');r.className='pr-ripple';var rect=btn.getBoundingClientRect();r.style.left=(e.clientX-rect.left)+'px';r.style.top=(e.clientY-rect.top)+'px';btn.appendChild(r);setTimeout(function(){r.remove();},700);});});
})();
function prScroll(){var el=document.getElementById('pr-order');if(el)el.scrollIntoView({behavior:'smooth',block:'start'});}
function prFaq(btn){var item=btn.closest('.pr-faq-item');var open=item.classList.contains('open');document.querySelectorAll('.pr-faq-item.open').forEach(function(i){i.classList.remove('open');});if(!open)item.classList.add('open');}
function prLB(src){var lb=document.getElementById('pr-lb'),img=document.getElementById('pr-lb-img');if(lb&&img){img.src=src;lb.classList.add('open');}}
</script>

