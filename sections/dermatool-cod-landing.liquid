  var header = doc.getElementById('dt-header');
  window.addEventListener('scroll', function(){
    header.classList.toggle('scrolled', window.scrollY > 60);
  }, {passive:true});

  /* Scroll fade */
  var fadeEls = doc.querySelectorAll('.dt-fade, .dt-fade-l, .dt-fade-r, .dt-scale');
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('dt-in'); io.unobserve(e.target); }
      });
    }, {threshold:0.10});
    fadeEls.forEach(function(el){ io.observe(el); });
  } else {
    fadeEls.forEach(function(el){ el.classList.add('dt-in'); });
  }

  /* Sticky bar */
  var stickyBar = doc.getElementById('dt-sticky-bar');
  var orderSec = doc.getElementById('dt-order-section');
  if(stickyBar && orderSec){
    var sio = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        stickyBar.classList.toggle('dt-show', !e.isIntersecting);
      });
    }, {threshold:.05});
    sio.observe(orderSec);
  }

  /* FAQ accordion */
  doc.querySelectorAll('[data-dt-faq]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.closest('.dt-faq-item');
      var wasOpen = item.classList.contains('dt-open');
      doc.querySelectorAll('.dt-faq-item.dt-open').forEach(function(el){ el.classList.remove('dt-open'); });
      if(!wasOpen) item.classList.add('dt-open');
    });
  });

  /* Lightbox */
  var lb = doc.getElementById('dt-lightbox');
  var lbImg = doc.getElementById('dt-lb-img');
  var lbClose = doc.getElementById('dt-lb-close');
  doc.querySelectorAll('[data-dt-lightbox]').forEach(function(el){
    el.addEventListener('click', function(){
      if(!lb) return;
      lbImg.src = el.dataset.dtLightbox;
      lb.classList.add('dt-open');
      doc.body.style.overflow = 'hidden';
    });
  });
  if(lbClose) lbClose.addEventListener('click', function(){ lb.classList.remove('dt-open'); doc.body.style.overflow = ''; });
  if(lb) lb.addEventListener('click', function(e){ if(e.target===lb){ lb.classList.remove('dt-open'); doc.body.style.overflow = ''; } });

  /* Submit ripple */
  doc.querySelectorAll('.dt-order-submit, .dt-kit-cta').forEach(function(btn){
    btn.addEventListener('click', function(e){
      var rect = btn.getBoundingClientRect();
      var r = doc.createElement('span');
      r.className = 'dt-ripple';
      var sz = Math.max(btn.offsetWidth, btn.offsetHeight);
      r.style.cssText = 'width:'+sz+'px;height:'+sz+'px;top:'+(e.clientY-rect.top-sz/2)+'px;left:'+(e.clientX-rect.left-sz/2)+'px;';
      btn.appendChild(r);
      setTimeout(function(){ r.remove(); }, 700);
    });
  });

  /* Variant sync */
  var variantsEl = doc.getElementById('dt-variants-json');
  if(variantsEl && variantsEl.textContent.trim() !== 'null'){
    try{
      var variantData = JSON.parse(variantsEl.textContent);
      var form = doc.getElementById('dt-product-form');
      if(form && variantData){
        form.querySelectorAll('.dt-var-pill input').forEach(function(r){
          r.addEventListener('change', function(){
            var opts = {};
            form.querySelectorAll('.dt-var-pill input:checked').forEach(function(c){
              opts[c.name] = c.value;
            });
            var match = variantData.find(function(v){
              return Object.keys(opts).every(function(k,i){ return v['option'+(i+1)] === opts[k]; });
            });
            if(match){
              var vidEl = doc.getElementById('dt-variant-id');
              if(vidEl) vidEl.value = match.id;
            }
          });
        });
      }
    } catch(e){}
  }

})();
</script>

