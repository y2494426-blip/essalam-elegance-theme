        </ul>
      </div>
      <!-- APRÈS -->
      <div class="dt-ba-card dt-ba-card--after dt-fade-r">
        <div class="dt-ba-header">
          <div class="dt-ba-title">✨ APRÈS</div>
          <div class="dt-ba-badge dt-ba-badge--after">Avec DERMATOOL®</div>
        </div>
        <div class="dt-ba-img">
          {% if section.settings.after_image %}
            <img src="{{ section.settings.after_image | image_url: width: 700 }}" loading="lazy" alt="Après DERMATOOL">
          {% else %}
            😊
          {% endif %}
        </div>
        <ul class="dt-ba-list">
          <li>✅ Ongles propres et nets</li>
          <li>✅ Aspect naturel et régulier</li>
