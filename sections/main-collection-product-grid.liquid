  @media (max-width: 900px) { #essalem-collection-lux .ee-why__grid { grid-template-columns: repeat(2, 1fr); } }
  #essalem-collection-lux .ee-why__card { background: var(--ee-white); border-radius: 14px; padding: 28px 18px; text-align: center; box-shadow: 0 4px 18px rgba(17,17,17,.06); transition: transform .35s ease, box-shadow .35s ease; }
  #essalem-collection-lux .ee-why__card:hover { transform: translateY(-6px); box-shadow: 0 16px 34px rgba(212,175,55,.22); }
  #essalem-collection-lux .ee-why__icon { display: block; font-size: 1.9rem; margin-bottom: 12px; }
  #essalem-collection-lux .ee-why__text { margin: 0; font-size: .88rem; font-weight: 600; color: var(--ee-black); }

