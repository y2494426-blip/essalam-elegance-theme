  #essalem-collection-lux .ee-final { position: relative; text-align: center; padding: 90px 24px; background: radial-gradient(circle at 50% 20%, #1c1c1c 0%, var(--ee-black) 70%); overflow: hidden; }
  #essalem-collection-lux .ee-final__glow { position: absolute; top: -30%; left: 50%; transform: translateX(-50%); width: 60vw; height: 60vw; max-width: 700px; max-height: 700px; border-radius: 50%; background: radial-gradient(circle, rgba(212,175,55,.22), transparent 70%); }
  #essalem-collection-lux .ee-final__title { position: relative; z-index: 1; font-family: var(--ee-font-body); font-weight: 900; font-size: clamp(1.8rem, 4.5vw, 3rem); color: var(--ee-white); margin: 0 0 16px; }
  #essalem-collection-lux .ee-final__text { position: relative; z-index: 1; color: rgba(255,255,255,.75); font-size: 1rem; max-width: 500px; margin: 0 auto 34px; line-height: 1.8; }
  #essalem-collection-lux .ee-final__cta { position: relative; z-index: 1; }

  /* ===== WHATSAPP ===== */
  #essalem-collection-lux .ee-whatsapp { position: fixed; bottom: 28px; left: 24px; z-index: 9999; width: 56px; height: 56px; border-radius: 50%; background: #25D366; color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 20px rgba(37,211,102,.45); animation: ee-wa-pulse 2.4s ease-in-out infinite; }
  @keyframes ee-wa-pulse { 0%, 100% { box-shadow: 0 6px 20px rgba(37,211,102,.45); } 50% { box-shadow: 0 6px 30px rgba(37,211,102,.75); } }

  /* ===== QUICK VIEW MODAL ===== */
  #essalem-collection-lux .ee-qv { position: fixed; inset: 0; z-index: 10000; display: flex; align-items: center; justify-content: center; padding: 20px; }
  #essalem-collection-lux .ee-qv[hidden] { display: none; }
  #essalem-collection-lux .ee-qv__backdrop { position: absolute; inset: 0; background: rgba(17,17,17,.6); backdrop-filter: blur(2px); }
  #essalem-collection-lux .ee-qv__panel { position: relative; z-index: 1; background: var(--ee-white); border-radius: 18px; max-width: 640px; width: 100%; display: grid; grid-template-columns: 1fr 1fr; overflow: hidden; box-shadow: 0 30px 70px rgba(0,0,0,.35); }
  @media (max-width: 600px) { #essalem-collection-lux .ee-qv__panel { grid-template-columns: 1fr; max-height: 90vh; overflow-y: auto; } }
  #essalem-collection-lux .ee-qv__close { position: absolute; top: 12px; left: 12px; z-index: 2; width: 32px; height: 32px; border-radius: 50%; border: none; background: rgba(255,255,255,.9); cursor: pointer; font-size: .95rem; }
  #essalem-collection-lux .ee-qv__img-wrap { background: var(--ee-beige); }
  #essalem-collection-lux .ee-qv__img { width: 100%; height: 100%; min-height: 240px; object-fit: cover; display: block; }
  #essalem-collection-lux .ee-qv__body { padding: 28px 24px; display: flex; flex-direction: column; justify-content: center; }
  #essalem-collection-lux .ee-qv__title { font-family: var(--ee-font-heading); font-size: 1.4rem; color: var(--ee-black); margin: 0 0 14px; }
  #essalem-collection-lux .ee-qv__price { display: flex; align-items: center; gap: 10px; margin-bottom: 22px; }
  #essalem-collection-lux .ee-qv__price-now { font-size: 1.2rem; font-weight: 800; color: var(--ee-black); }
  #essalem-collection-lux .ee-qv__price-compare { font-size: .95rem; color: #999; text-decoration: line-through; }
  #essalem-collection-lux .ee-qv__cta { width: 100%; }

  @media (prefers-reduced-motion: reduce) {
    #essalem-collection-lux * { animation: none !important; transition: none !important; }
    #essalem-collection-lux [data-ee-reveal] { opacity: 1; transform: none; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('essalem-collection-lux');
  if (!root) return;

  /* reveal on scroll */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    root.querySelectorAll('[data-ee-reveal]').forEach(function (el) { io.observe(el); });
  } else {
    root.querySelectorAll('[data-ee-reveal]').forEach(function (el) { el.classList.add('is-visible'); });
  }

  /* reviews slider */
  window.eeReviewScroll = function (sectionId, dir) {
    var track = document.getElementById('ee-reviews-track-' + sectionId);
    if (!track) return;
    var card = track.querySelector('.ee-review-card');
    var amount = card ? (card.offsetWidth + 20) : 300;
    track.scrollBy({ left: dir * amount, behavior: 'smooth' });
  };

  /* quick view modal (shared across all cards on the page) */
  var modal = root.querySelector('.ee-qv');
  window.essalemQuickView = function (btn) {
    if (!modal || !btn) { if (btn) window.location.href = btn.dataset.qvUrl; return; }
    var sid = modal.id.replace('ee-qv-', '');
    var img = document.getElementById('ee-qv-img-' + sid);
    var title = document.getElementById('ee-qv-title-' + sid);
    var price = document.getElementById('ee-qv-price-' + sid);
    var compare = document.getElementById('ee-qv-compare-' + sid);
    var cta = document.getElementById('ee-qv-cta-' + sid);

    if (img) { img.src = btn.dataset.qvImage; img.alt = btn.dataset.qvTitle || ''; }
    if (title) title.textContent = btn.dataset.qvTitle || '';
    if (price) price.textContent = btn.dataset.qvPrice || '';
    if (compare) compare.textContent = btn.dataset.qvCompare || '';
    if (cta) {
      cta.href = btn.dataset.qvUrl || '#';
      cta.textContent = (btn.dataset.qvAvailable === 'true') ? 'اطلب الآن' : 'نفذت الكمية';
    }
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  };
  window.essalemQuickViewClose = function () {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = '';
  };
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal && !modal.hidden) window.essalemQuickViewClose();
  });
})();
</script>

