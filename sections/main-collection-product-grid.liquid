{{ 'luxury-theme.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign products_per_page = section.settings.products_per_page
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign total_count = collection.products_count
-%}

{% render 'essalem-back-button' %}

<div class="lux-collection-page">

  {%- comment -%} Collection Banner {%- endcomment -%}
  <div class="lux-collection-banner">
    {%- if collection.image -%}
      <div class="lux-collection-banner__bg">
        {{ collection.image | image_url: width: 1600 | image_tag: loading: 'eager', class: 'lux-collection-banner__img' }}
      </div>
    {%- endif -%}
    <div class="lux-collection-banner__content">
      <nav class="lux-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Accueil</a>
        <span>&#8594;</span>
        <a href="{{ routes.collections_url }}">Collections</a>
        <span>&#8594;</span>
        <span>{{ collection.title }}</span>
      </nav>
      <h1 class="lux-collection-banner__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="lux-collection-banner__desc">{{ collection.description }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Toolbar {%- endcomment -%}
  <div class="lux-toolbar">
    <div class="lux-toolbar__count">
      <span>{{ total_count }} produit{% if total_count != 1 %}s{% endif %}</span>
    </div>
    <div class="lux-toolbar__sort">
      <form method="get">
        <label for="lux-sort" class="visually-hidden">Trier par</label>
        <select id="lux-sort" name="sort_by" class="lux-select" onchange="this.form.submit()">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
      </form>
    </div>
  </div>

  {%- comment -%} Product Grid {%- endcomment -%}
  <div class="lux-collection-grid-wrap">
    {%- paginate collection.products by products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="lux-product-grid" role="list">
          {%- for product in collection.products -%}
            <li class="lux-product-grid__item lux-fade-up" style="animation-delay: {{ forloop.index0 | times: 60 }}ms">
              {%- render 'card-product',
                card_product: product,
                media_aspect_ratio: 'portrait',
                show_secondary_image: true,
                show_vendor: false,
                show_rating: false
              -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="lux-pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="lux-pagination__btn">&larr; Précédent</a>
            {%- endif -%}
            <span class="lux-pagination__info">Page {{ paginate.current_page }} / {{ paginate.pages }}</span>
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="lux-pagination__btn">Suivant &rarr;</a>
            {%- endif -%}
          </nav>
        {%- endif -%}

      {%- else -%}
        <div class="lux-empty-state">
          <p>Aucun produit dans cette collection.</p>
          <a href="{{ routes.collections_url }}" class="lux-btn">Voir toutes les collections</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>

</div>

{% schema %}
{
  "name": "Collection Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
