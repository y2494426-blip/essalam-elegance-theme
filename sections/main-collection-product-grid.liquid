{{ 'luxury-theme.css' | asset_url | stylesheet_tag }}
{% render 'essalem-back-button' %}
{% render 'lux-float-cart' %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">

{%- liquid
  assign pid = section.id
-%}

<div id="essalem-collection-lux" dir="rtl">

  {%- comment -%} ============================= HERO ============================= {%- endcomment -%}
  <section class="ee-hero" id="ee-hero-{{ pid }}">
    <div class="ee-hero__bg" id="ee-hero-bg-{{ pid }}">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'ee-hero__img', alt: '' }}
      {%- else -%}
        <div class="ee-scene ee-scene--dark" aria-hidden="true">
          <div class="ee-bokeh ee-bokeh--1"></div>
          <div class="ee-bokeh ee-bokeh--2"></div>
          <div class="ee-bokeh ee-bokeh--3"></div>
          <div class="ee-bokeh ee-bokeh--4"></div>
          <div class="ee-rays"></div>
        </div>
      {%- endif -%}
      <div class="ee-hero__overlay"></div>
      <div class="ee-hero__vignette"></div>
    </div>

    <div class="ee-particles ee-hero__particles" id="ee-hero-particles-{{ pid }}" aria-hidden="true">
      {%- for i in (1..22) -%}<span class="ee-particle" style="--i:{{ i }};"></span>{%- endfor -%}
    </div>

    <div class="ee-hero__content">
      {%- if collection.title != blank -%}
        <p class="ee-kicker" data-ee-reveal>{{ collection.title }} · ESSALAM ELEGANCE</p>
      {%- endif -%}
      <span class="ee-hero__heart" data-ee-reveal aria-hidden="true">❤</span>
      <h1 class="ee-hero__title" data-ee-reveal>{{ section.settings.hero_heading | default: 'الوقت كيجمع القلوب' }}</h1>
      <p class="ee-hero__subtitle" data-ee-reveal>{{ section.settings.hero_subheading | newline_to_br }}</p>
      <a href="#ee-showroom-{{ pid }}" class="ee-cta ee-cta--glass" data-ee-reveal>
        <span class="ee-cta__glow"></span>
        <span class="ee-cta__label">{{ section.settings.hero_cta_text | default: 'اطلب دابا' }}</span>
      </a>
    </div>

    <button type="button" class="ee-hero__scroll" aria-label="مرر للأسفل" onclick="document.getElementById('ee-stats-{{ pid }}').scrollIntoView({behavior:'smooth'})">
      <span></span>
    </button>
  </section>

  {%- comment -%} ============================= STATS ============================= {%- endcomment -%}
  <section class="ee-stats" id="ee-stats-{{ pid }}">
    <div class="ee-stats__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="ee-stat" data-ee-reveal {{ block.shopify_attributes }}>
            <div class="ee-stat__icon">{{ block.settings.icon }}</div>
            {%- if block.settings.number != blank -%}
              <div class="ee-stat__value">
                <span>{{ block.settings.number_prefix }}</span><span class="ee-stat__num" data-count="{{ block.settings.number }}">0</span><span>{{ block.settings.number_suffix }}</span>
              </div>
            {%- endif -%}
            <p class="ee-stat__label">{{ block.settings.label }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ============================= SHOWROOM ============================= {%- endcomment -%}
  <section class="ee-showroom" id="ee-showroom-{{ pid }}">
    <div class="ee-section-head">
      <p class="ee-eyebrow" data-ee-reveal>ESSALAM ELEGANCE</p>
      <h2 class="ee-title" data-ee-reveal>المجموعة</h2>
      {%- if collection.description != blank -%}
        <p class="ee-section-desc" data-ee-reveal>{{ collection.description | strip_html | truncate: 140 }}</p>
      {%- endif -%}
      <div class="ee-line"></div>
    </div>

    <div class="ee-showroom__bar">
      <p class="ee-showroom__count">
        {{ collection.products_count }} {% if collection.products_count == 1 %}منتج{% else %}منتجات{% endif %}
      </p>
      {%- if collection.products_count > 0 -%}
        <form class="ee-sort-form" id="ee-sort-form-{{ pid }}">
          <label class="ee-sort-label" for="ee-sort-{{ pid }}">ترتيب:</label>
          <select id="ee-sort-{{ pid }}" class="ee-sort-select" name="sort_by" onchange="document.getElementById('ee-sort-form-{{ pid }}').submit()">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected="selected"{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </form>
      {%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="ee-showroom__wrap">
        <button type="button" class="ee-hscroll-arrow ee-hscroll-arrow--prev" aria-label="السابق" onclick="window.eeHScroll && eeHScroll('ee-showroom-track-{{ pid }}', -1)">‹</button>
        <div class="ee-showroom__track" id="ee-showroom-track-{{ pid }}">
          {%- for product in collection.products -%}
            {%- liquid
              assign size_idx = forloop.index0 | modulo: 3
              assign size_class = 'ee-showroom-item--lg'
              if size_idx == 1
                assign size_class = 'ee-showroom-item--md'
              elsif size_idx == 2
                assign size_class = 'ee-showroom-item--sm'
              endif
            -%}
            <div class="ee-showroom-item {{ size_class }}" data-ee-reveal>
              <div class="ee-showroom-frame">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'portrait',
                  show_secondary_image: true,
                  show_vendor: false
                %}
              </div>
            </div>
          {%- else -%}
            <p class="ee-empty">ما كايناش منتجات فهاد المجموعة حالياً.</p>
          {%- endfor -%}
        </div>
        <button type="button" class="ee-hscroll-arrow ee-hscroll-arrow--next" aria-label="التالي" onclick="window.eeHScroll && eeHScroll('ee-showroom-track-{{ pid }}', 1)">›</button>
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="ee-pagination" role="navigation" aria-label="ترقيم الصفحات">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="ee-pagination__arrow">‹</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="ee-pagination__num">{{ part.title }}</a>
            {%- else -%}
              {%- if part.title == paginate.current_page -%}
                <span class="ee-pagination__num ee-pagination__num--active">{{ part.title }}</span>
              {%- else -%}
                <span class="ee-pagination__dots">{{ part.title }}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="ee-pagination__arrow">›</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </section>

  {%- comment -%} ============================= EMOTIONAL ============================= {%- endcomment -%}
  <section class="ee-emotional">
    <div class="ee-emotional__bg">
      {%- if section.settings.emotional_image != blank -%}
        {{ section.settings.emotional_image | image_url: width: 2400 | image_tag: loading: 'lazy', class: 'ee-emotional__img', alt: '' }}
      {%- else -%}
        <div class="ee-scene ee-scene--dark" aria-hidden="true">
          <div class="ee-bokeh ee-bokeh--1"></div>
          <div class="ee-bokeh ee-bokeh--3"></div>
          <div class="ee-rays"></div>
        </div>
      {%- endif -%}
      <div class="ee-hero__overlay"></div>
    </div>
    <div class="ee-particles" aria-hidden="true">
      {%- for i in (1..14) -%}<span class="ee-particle" style="--i:{{ i }};"></span>{%- endfor -%}
    </div>
    <div class="ee-emotional__content">
      <span class="ee-hero__heart" data-ee-reveal aria-hidden="true">❤</span>
      <h2 class="ee-emotional__title" data-ee-reveal>{{ section.settings.emotional_heading | default: 'اختار هدية غادي تبقى ذكرى' }}</h2>
      {%- if section.settings.emotional_text != blank -%}
        <p class="ee-emotional__text" data-ee-reveal>{{ section.settings.emotional_text }}</p>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ============================= OFFER ============================= {%- endcomment -%}
  <section class="ee-offer">
    <div class="ee-scene ee-scene--dark" aria-hidden="true">
      <div class="ee-bokeh ee-bokeh--2"></div>
      <div class="ee-bokeh ee-bokeh--4"></div>
      <div class="ee-rays"></div>
    </div>
    <div class="ee-particles" aria-hidden="true">
      {%- for i in (1..16) -%}<span class="ee-particle" style="--i:{{ i }};"></span>{%- endfor -%}
    </div>

    <div class="ee-offer__card" data-ee-reveal>
      <span class="ee-offer__fire">🔥</span>
      <p class="ee-offer__label">عرض لفترة محدودة</p>
      <div class="ee-offer__price">
        <span class="ee-offer__amount">{{ section.settings.offer_price | default: '299' }}</span>
        <span class="ee-offer__currency">{{ section.settings.offer_currency | default: 'DH' }}</span>
      </div>
      <div class="ee-offer__badges">
        {%- for block in section.blocks -%}
          {%- if block.type == 'offer_badge' -%}
            <span class="ee-offer__badge" {{ block.shopify_attributes }}>{{ block.settings.icon }} {{ block.settings.text }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <a href="#ee-showroom-{{ pid }}" class="ee-cta ee-cta--gold ee-offer__cta">
        <span class="ee-cta__label">{{ section.settings.offer_cta_text | default: 'اطلب دابا' }}</span>
      </a>
    </div>
  </section>

  {%- comment -%} ============================= REVIEWS ============================= {%- endcomment -%}
  <section class="ee-reviews">
    <div class="ee-section-head">
      <p class="ee-eyebrow" data-ee-reveal>آراء عملائنا</p>
      <h2 class="ee-title" data-ee-reveal>ماذا قال عملاؤنا</h2>
      <div class="ee-line"></div>
    </div>

    <div class="ee-showroom__wrap">
      <button type="button" class="ee-hscroll-arrow ee-hscroll-arrow--prev" aria-label="السابق" onclick="window.eeHScroll && eeHScroll('ee-reviews-track-{{ pid }}', -1)">‹</button>
      <div class="ee-reviews__track" id="ee-reviews-track-{{ pid }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="ee-review-card" data-ee-reveal {{ block.shopify_attributes }}>
              <div class="ee-review-card__top">
                <div class="ee-review-card__avatar">
                  {%- if block.settings.avatar != blank -%}
                    {{ block.settings.avatar | image_url: width: 100 | image_tag: loading: 'lazy', alt: block.settings.name | escape }}
                  {%- else -%}
                    <span>{{ block.settings.name | slice: 0 }}</span>
                  {%- endif -%}
                </div>
                <div>
                  <p class="ee-review-card__name">
                    {{ block.settings.name }}
                    {%- if block.settings.verified -%}<span class="ee-review-card__verified" title="مشتري موثّق">✓</span>{%- endif -%}
                  </p>
                  {%- if block.settings.location != blank -%}<p class="ee-review-card__loc">{{ block.settings.location }}</p>{%- endif -%}
                </div>
              </div>
              <div class="ee-review-card__stars">
                {%- assign stars = block.settings.rating | default: 5 -%}
                {%- for i in (1..stars) -%}★{%- endfor -%}
              </div>
              <p class="ee-review-card__text">"{{ block.settings.text }}"</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button type="button" class="ee-hscroll-arrow ee-hscroll-arrow--next" aria-label="التالي" onclick="window.eeHScroll && eeHScroll('ee-reviews-track-{{ pid }}', 1)">›</button>
    </div>
  </section>

  {%- comment -%} ============================= WHATSAPP ============================= {%- endcomment -%}
  {%- if section.settings.whatsapp_number != blank -%}
    <a class="ee-whatsapp" href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener" aria-label="تواصل معنا عبر واتساب">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12.02 2C6.5 2 2 6.48 2 12c0 1.85.5 3.58 1.35 5.07L2 22l5.06-1.32A9.94 9.94 0 0 0 12.02 22C17.54 22 22 17.52 22 12S17.54 2 12.02 2Zm5.86 14.14c-.25.7-1.23 1.28-2.02 1.45-.55.11-1.26.2-3.67-.79-3.08-1.27-5.07-4.4-5.22-4.6-.15-.2-1.25-1.66-1.25-3.17s.78-2.25 1.06-2.56c.28-.31.6-.38.8-.38h.58c.19 0 .44-.07.68.53.25.6.85 2.08.92 2.23.07.15.12.33.02.53-.1.2-.15.33-.3.5-.15.18-.32.4-.45.53-.15.15-.31.32-.14.62.18.31.79 1.32 1.71 2.15 1.18 1.06 2.16 1.4 2.47 1.55.31.15.49.13.67-.08.19-.2.79-.9 1-1.2.2-.31.4-.26.68-.16.28.1 1.76.85 2.06 1 .3.15.5.23.57.35.08.13.08.75-.17 1.45Z"/></svg>
    </a>
  {%- endif -%}

  {%- comment -%} ============================= QUICK VIEW MODAL ============================= {%- endcomment -%}
  <div class="ee-qv" id="ee-qv-{{ pid }}" hidden>
    <div class="ee-qv__backdrop" onclick="window.essalemQuickViewClose && essalemQuickViewClose('{{ pid }}')"></div>
    <div class="ee-qv__panel" role="dialog" aria-modal="true">
      <button type="button" class="ee-qv__close" aria-label="إغلاق" onclick="window.essalemQuickViewClose && essalemQuickViewClose('{{ pid }}')">✕</button>
      <div class="ee-qv__img-wrap"><img class="ee-qv__img" id="ee-qv-img-{{ pid }}" alt="" /></div>
      <div class="ee-qv__body">
        <h3 class="ee-qv__title" id="ee-qv-title-{{ pid }}"></h3>
        <div class="ee-qv__price">
          <span class="ee-qv__price-now" id="ee-qv-price-{{ pid }}"></span>
          <span class="ee-qv__price-compare" id="ee-qv-compare-{{ pid }}"></span>
        </div>
        <a class="ee-cta ee-cta--gold ee-qv__cta" id="ee-qv-cta-{{ pid }}" href="#">اطلب الآن</a>
      </div>
    </div>
  </div>

</div>

<style>
  #essalem-collection-lux {
    --ee-white: #FFFFFF;
    --ee-black: #0D0D0D;
    --ee-ink: #111111;
    --ee-gold: #D4AF37;
    --ee-gold-soft: #E8C86B;
    --ee-champagne: #F3E5C3;
    --ee-beige: #F8F5F0;
    --ee-beige-dark: #EFE8DB;
    --ee-font-display: 'Tajawal', Arial, sans-serif;
    --ee-font-accent: 'Cormorant Garamond', Georgia, serif;
    direction: rtl;
    text-align: right;
    background: var(--ee-white);
    font-family: var(--ee-font-display);
    overflow-x: hidden;
    scroll-behavior: smooth;
  }
  #essalem-collection-lux *{ box-sizing: border-box; }
  #essalem-collection-lux a { text-decoration: none; color: inherit; }
  #essalem-collection-lux img { max-width: 100%; display: block; }

  /* ===== shared atmosphere ===== */
  #essalem-collection-lux .ee-scene { position: absolute; inset: 0; overflow: hidden; }
  #essalem-collection-lux .ee-scene--dark { background: radial-gradient(ellipse at 65% 25%, #1c1712 0%, #0d0d0d 55%, #050505 100%); }
  #essalem-collection-lux .ee-bokeh { position: absolute; border-radius: 50%; filter: blur(38px); opacity: .55; animation: ee-bokeh-drift 12s ease-in-out infinite alternate; }
  #essalem-collection-lux .ee-bokeh--1 { width: 260px; height: 260px; top: 8%; right: 10%; background: radial-gradient(circle, rgba(232,200,107,.55), transparent 70%); animation-duration: 13s; }
  #essalem-collection-lux .ee-bokeh--2 { width: 180px; height: 180px; top: 55%; right: 30%; background: radial-gradient(circle, rgba(255,255,255,.28), transparent 70%); animation-duration: 16s; animation-delay: -4s; }
  #essalem-collection-lux .ee-bokeh--3 { width: 320px; height: 320px; bottom: -6%; left: 6%; background: radial-gradient(circle, rgba(212,175,55,.4), transparent 70%); animation-duration: 18s; animation-delay: -8s; }
  #essalem-collection-lux .ee-bokeh--4 { width: 200px; height: 200px; top: 20%; left: 18%; background: radial-gradient(circle, rgba(243,229,195,.35), transparent 70%); animation-duration: 14s; animation-delay: -2s; }
  @keyframes ee-bokeh-drift { from { transform: translate(0,0) scale(1); } to { transform: translate(24px,-18px) scale(1.12); } }
  #essalem-collection-lux .ee-rays { position: absolute; top: 50%; left: 50%; width: 200vmax; height: 200vmax; margin: -100vmax 0 0 -100vmax; background: conic-gradient(from 0deg, transparent 0deg, rgba(232,200,107,.06) 10deg, transparent 24deg, transparent 160deg, rgba(212,175,55,.05) 172deg, transparent 190deg, transparent 340deg, rgba(232,200,107,.04) 352deg, transparent 360deg); animation: ee-spin 100s linear infinite; mix-blend-mode: screen; }
  @keyframes ee-spin { to { transform: rotate(360deg); } }

  #essalem-collection-lux .ee-particles { position: absolute; inset: 0; z-index: 2; pointer-events: none; transition: transform .5s ease-out; }
  #essalem-collection-lux .ee-particle { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: var(--ee-gold-soft); opacity: .8; box-shadow: 0 0 7px rgba(232,200,107,.8); left: calc((var(--i) * 4.6%) + 1%); top: 100%; animation: ee-rise calc(9s + (var(--i) * .45s)) linear infinite; animation-delay: calc(var(--i) * -0.55s); }
  @keyframes ee-rise { 0% { transform: translateY(0) scale(.5); opacity: 0; } 12% { opacity: .95; } 88% { opacity: .25; } 100% { transform: translateY(-105vh) scale(1); opacity: 0; } }

  /* ===== buttons ===== */
  #essalem-collection-lux .ee-cta { position: relative; display: inline-flex; align-items: center; justify-content: center; padding: 18px 46px; border-radius: 60px; font-weight: 800; font-size: 1.02rem; letter-spacing: .01em; cursor: pointer; border: none; overflow: hidden; transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease; }
  #essalem-collection-lux .ee-cta:hover { transform: translateY(-3px) scale(1.015); }
  #essalem-collection-lux .ee-cta--gold { background: linear-gradient(120deg, var(--ee-gold-soft), var(--ee-gold)); color: #16130a; box-shadow: 0 18px 40px -14px rgba(212,175,55,.6); }
  #essalem-collection-lux .ee-cta--gold::after { content: ''; position: absolute; top: 0; bottom: 0; left: -60%; width: 40%; background: linear-gradient(120deg, transparent, rgba(255,255,255,.55), transparent); transform: skewX(-20deg); animation: ee-btn-shine 3.2s ease-in-out infinite; }
  @keyframes ee-btn-shine { 0% { left: -60%; } 45%, 100% { left: 130%; } }
  #essalem-collection-lux .ee-cta--glass { background: rgba(255,255,255,.08); color: var(--ee-white); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,.35); box-shadow: 0 8px 32px rgba(0,0,0,.25); }
  #essalem-collection-lux .ee-cta--glass:hover { background: rgba(255,255,255,.16); border-color: var(--ee-gold-soft); }
  #essalem-collection-lux .ee-cta__glow { position: absolute; inset: -40%; background: radial-gradient(circle, rgba(212,175,55,.5), transparent 65%); filter: blur(18px); z-index: -1; opacity: .8; animation: ee-glow-pulse 2.6s ease-in-out infinite; }
  @keyframes ee-glow-pulse { 0%, 100% { opacity: .55; transform: scale(1); } 50% { opacity: .95; transform: scale(1.12); } }
  #essalem-collection-lux .ee-cta__label { position: relative; z-index: 1; }

  /* ===== reveal ===== */
  #essalem-collection-lux [data-ee-reveal] { opacity: 0; transform: translateY(22px); transition: opacity .9s cubic-bezier(.2,.7,.2,1), transform .9s cubic-bezier(.2,.7,.2,1); }
  #essalem-collection-lux [data-ee-reveal].is-visible { opacity: 1; transform: translateY(0); }

  #essalem-collection-lux .ee-section-head { text-align: center; max-width: 640px; margin: 0 auto 46px; padding: 0 20px; }
  #essalem-collection-lux .ee-eyebrow { font-size: .78rem; font-weight: 800; letter-spacing: .32em; color: var(--ee-gold); text-transform: uppercase; margin: 0 0 14px; }
  #essalem-collection-lux .ee-title { font-family: var(--ee-font-display); font-weight: 900; font-size: clamp(2rem, 5vw, 3.2rem); color: var(--ee-ink); margin: 0 0 14px; letter-spacing: -.01em; }
  #essalem-collection-lux .ee-section-desc { font-size: .92rem; color: #6b6b6b; line-height: 1.8; margin: 0 0 18px; }
  #essalem-collection-lux .ee-line { width: 64px; height: 2px; background: linear-gradient(90deg, transparent, var(--ee-gold), transparent); margin: 0 auto; }

  /* ===== HERO ===== */
  #essalem-collection-lux .ee-hero { position: relative; min-height: 100svh; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #0d0d0d; }
  #essalem-collection-lux .ee-hero__bg { position: absolute; inset: -24px; z-index: 0; transition: transform .5s cubic-bezier(.2,.7,.2,1); transform: translate3d(var(--px,0),var(--py,0),0); }
  #essalem-collection-lux .ee-hero__img { width: 100%; height: 100%; object-fit: cover; animation: ee-kenburns 26s ease-in-out infinite alternate; }
  @keyframes ee-kenburns { from { transform: scale(1); } to { transform: scale(1.09); } }
  #essalem-collection-lux .ee-hero__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(5,5,5,.35) 0%, rgba(5,5,5,.35) 40%, rgba(5,5,5,.85) 100%), linear-gradient(90deg, rgba(5,5,5,.45), transparent 55%, rgba(5,5,5,.45)); z-index: 1; }
  #essalem-collection-lux .ee-hero__vignette { position: absolute; inset: 0; z-index: 1; box-shadow: inset 0 0 180px 60px rgba(0,0,0,.55); }
  #essalem-collection-lux .ee-hero__particles { z-index: 2; }

  #essalem-collection-lux .ee-hero__content { position: relative; z-index: 3; max-width: 680px; margin: 0 auto; padding: 110px 24px 40px; text-align: center; }
