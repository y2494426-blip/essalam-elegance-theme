  #essalem-collection-lux .ee-pagination__num:hover, #essalem-collection-lux .ee-pagination__arrow:hover { background: var(--ee-black); color: var(--ee-white); border-color: var(--ee-black); }
  #essalem-collection-lux .ee-pagination__num--active { background: var(--ee-gold); border-color: var(--ee-gold); color: var(--ee-black); }
  #essalem-collection-lux .ee-pagination__dots { padding: 0 4px; color: #999; }

