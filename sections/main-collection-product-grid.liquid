    #essalem-collection-lux [data-ee-reveal] { opacity: 1; transform: none; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('essalem-collection-lux');
  if (!root) return;

  var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  /* reveal on scroll */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    root.querySelectorAll('[data-ee-reveal]').forEach(function (el) { io.observe(el); });
  } else {
    root.querySelectorAll('[data-ee-reveal]').forEach(function (el) { el.classList.add('is-visible'); });
  }

  /* hero mouse parallax */
  if (canHover && !prefersReducedMotion) {
    var hero = root.querySelector('.ee-hero');
    var heroBg = hero ? hero.querySelector('.ee-hero__bg') : null;
    var heroParticles = hero ? hero.querySelector('.ee-hero__particles') : null;
    if (hero && heroBg) {
      hero.addEventListener('pointermove', function (e) {
        var r = hero.getBoundingClientRect();
        var nx = ((e.clientX - r.left) / r.width) * 2 - 1;
        var ny = ((e.clientY - r.top) / r.height) * 2 - 1;
        heroBg.style.setProperty('--px', (nx * -14) + 'px');
        heroBg.style.setProperty('--py', (ny * -10) + 'px');
        if (heroParticles) heroParticles.style.transform = 'translate3d(' + (nx * 18) + 'px,' + (ny * 12) + 'px,0)';
      });
      hero.addEventListener('pointerleave', function () {
        heroBg.style.setProperty('--px', '0px');
        heroBg.style.setProperty('--py', '0px');
        if (heroParticles) heroParticles.style.transform = 'translate3d(0,0,0)';
      });
    }
  }

  /* count-up stats */
  var counters = root.querySelectorAll('.ee-stat__num[data-count]');
  if (counters.length && 'IntersectionObserver' in window) {
    var cio = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        var target = parseInt(el.getAttribute('data-count'), 10) || 0;
        cio.unobserve(el);
        if (prefersReducedMotion) { el.textContent = target; return; }
        var start = null;
        var duration = 1500;
        function step(ts) {
          if (!start) start = ts;
          var progress = Math.min(1, (ts - start) / duration);
          var eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target);
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = target;
        }
        requestAnimationFrame(step);
      });
    }, { threshold: 0.4 });
    counters.forEach(function (el) { cio.observe(el); });
  }

  /* generic horizontal scroller (showroom + reviews) */
  window.eeHScroll = function (trackId, dir) {
    var t = document.getElementById(trackId);
    if (!t) return;
    t.scrollBy({ left: dir * t.clientWidth * 0.82, behavior: 'smooth' });
  };

  /* quick view modal (shared across all cards on the page) */
  var modal = root.querySelector('.ee-qv');
  window.essalemQuickView = function (btn) {
    if (!modal || !btn) { if (btn) window.location.href = btn.dataset.qvUrl; return; }
    var sid = modal.id.replace('ee-qv-', '');
    var img = document.getElementById('ee-qv-img-' + sid);
    var title = document.getElementById('ee-qv-title-' + sid);
    var price = document.getElementById('ee-qv-price-' + sid);
    var compare = document.getElementById('ee-qv-compare-' + sid);
    var cta = document.getElementById('ee-qv-cta-' + sid);

    if (img) { img.src = btn.dataset.qvImage; img.alt = btn.dataset.qvTitle || ''; }
    if (title) title.textContent = btn.dataset.qvTitle || '';
    if (price) price.textContent = btn.dataset.qvPrice || '';
    if (compare) compare.textContent = btn.dataset.qvCompare || '';
    if (cta) {
      cta.href = btn.dataset.qvUrl || '#';
      cta.textContent = (btn.dataset.qvAvailable === 'true') ? 'اطلب الآن' : 'نفذت الكمية';
    }
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  };
  window.essalemQuickViewClose = function () {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = '';
  };
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal && !modal.hidden) window.essalemQuickViewClose();
  });
})();
</script>

