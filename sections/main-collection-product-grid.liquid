{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign total_products = collection.products_count
-%}

<div class="collection-grid page-width" id="shopify-section-{{ section.id }}">

  <!-- Collection header -->
  <div class="collection-grid__header">
    <h1 class="collection-grid__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-grid__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  <!-- Toolbar: count + sort -->
  <div class="collection-grid__toolbar">
    <p class="collection-grid__count">
      {{ total_products }} produit{% if total_products != 1 %}s{% endif %}
    </p>
    {%- if section.settings.enable_sorting -%}
      <div class="collection-grid__sort">
        <label for="SortBy" class="collection-grid__sort-label">Trier par</label>
        <div class="select">
          <select name="sort_by" id="SortBy" class="select__select collection-grid__sort-select">
            {%- assign sort_options = 'Pertinence,manual|Nouveautés,created-descending|Prix croissant,price-ascending|Prix décroissant,price-descending|Meilleures ventes,best-selling' | split: '|' -%}
            {%- for option in sort_options -%}
              {%- assign parts = option | split: ',' -%}
              <option value="{{ parts[1] }}"{% if sort_by == parts[1] %} selected{% endif %}>{{ parts[0] }}</option>
            {%- endfor -%}
          </select>
        </div>
      </div>
    {%- endif -%}
  </div>

  <!-- Product grid -->
  {%- if collection.products.size == 0 -%}
    <div class="collection-grid__empty">
      <p>Aucun produit dans cette collection.</p>
      <a href="{{ routes.root_url }}" class="button button--secondary">Continuer mes achats</a>
    </div>
  {%- else -%}
    <div class="collection-grid__products grid grid--{{ section.settings.columns_desktop }}-col" id="product-grid">
      {%- for product in collection.products -%}
        <div class="grid__item">
          {%- render 'card-product', card_product: product -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
      <div class="collection-grid__pagination">
        {{ paginate | default_pagination: next: 'Suivant →', previous: '← Précédent' }}
      </div>
    {%- endif -%}
  {%- endif -%}

</div>

<style>
  .collection-grid { padding: 4rem 0 6rem; }
  .collection-grid__header { text-align: center; margin-bottom: 3rem; }
  .collection-grid__title {
    font-family: var(--font-heading-family);
    font-size: calc(var(--font-heading-scale) * 3rem);
    font-weight: 400;
    margin: 0 0 1rem;
  }
  .collection-grid__description { color: rgba(var(--color-foreground), 0.65); max-width: 60rem; margin: 0 auto; }
  .collection-grid__toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
    margin-bottom: 3rem;
  }
  .collection-grid__count { font-size: 1.3rem; color: rgba(var(--color-foreground), 0.6); margin: 0; }
  .collection-grid__sort { display: flex; align-items: center; gap: 1rem; }
  .collection-grid__sort-label { font-size: 1.3rem; margin: 0; }
  .collection-grid__sort-select { width: auto; min-width: 18rem; font-size: 1.3rem; }
  .collection-grid__empty { text-align: center; padding: 6rem 0; }
  .collection-grid__pagination { display: flex; justify-content: center; margin-top: 4rem; gap: 0.8rem; }
  .collection-grid__pagination a, .collection-grid__pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4rem;
    height: 4rem;
    padding: 0 1.2rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    font-size: 1.3rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .collection-grid__pagination a:hover { background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); border-color: rgb(var(--color-foreground)); }
  .collection-grid__pagination .current { background: var(--color-gold); color: #fff; border-color: var(--color-gold); }
</style>

<script>
  document.getElementById('SortBy')?.addEventListener('change', function () {
    const url = new URL(window.location.href);
    url.searchParams.set('sort_by', this.value);
    window.location.href = url.toString();
  });
</script>

{% schema %}
{
  "name": "Grille de collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Produits par page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Colonnes (bureau)"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Activer le tri"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": false,
      "label": "Activer les filtres"
    }
  ],
  "presets": [
    {
      "name": "Grille de collection"
    }
  ]
}
{% endschema %}
