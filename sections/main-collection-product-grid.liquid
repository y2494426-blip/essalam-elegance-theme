  #essalem-collection-lux .ee-lifestyle__bg { position: absolute; inset: 0; }
  #essalem-collection-lux .ee-lifestyle__img { width: 100%; height: 100%; object-fit: cover; opacity: .55; }
  #essalem-collection-lux .ee-lifestyle__overlay { position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(17,17,17,.4), rgba(17,17,17,.88)); }
  #essalem-collection-lux .ee-lifestyle__content { position: relative; z-index: 1; text-align: center; max-width: 640px; padding: 90px 24px; }
  #essalem-collection-lux .ee-lifestyle__heart { display: inline-block; font-size: 2.2rem; color: var(--ee-gold); margin-bottom: 18px; animation: ee-heartbeat 1.6s ease-in-out infinite; }
  @keyframes ee-heartbeat { 0%, 100% { transform: scale(1); } 25% { transform: scale(1.18); } 40% { transform: scale(1); } 60% { transform: scale(1.12); } }
  #essalem-collection-lux .ee-lifestyle__title { font-family: var(--ee-font-body); font-weight: 800; font-size: clamp(1.6rem, 4vw, 2.5rem); color: var(--ee-white); margin: 0 0 14px; }
  #essalem-collection-lux .ee-lifestyle__text { color: rgba(255,255,255,.75); font-size: 1rem; line-height: 1.8; margin: 0; }

  /* ===== REVIEWS ===== */
  #essalem-collection-lux .ee-reviews { padding: 70px 20px; background: var(--ee-white); }
  #essalem-collection-lux .ee-reviews__wrap { position: relative; max-width: 1100px; margin: 0 auto; display: flex; align-items: center; gap: 12px; }
  #essalem-collection-lux .ee-reviews__track { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; padding: 6px 4px 14px; flex: 1; }
  #essalem-collection-lux .ee-reviews__track::-webkit-scrollbar { height: 5px; }
  #essalem-collection-lux .ee-reviews__track::-webkit-scrollbar-thumb { background: var(--ee-gold); border-radius: 10px; }
  #essalem-collection-lux .ee-review-card { scroll-snap-align: start; flex: 0 0 300px; background: var(--ee-beige); border-radius: 16px; padding: 26px 22px; box-shadow: 0 4px 16px rgba(17,17,17,.06); }
  #essalem-collection-lux .ee-review-card__stars { color: var(--ee-gold); letter-spacing: 3px; margin-bottom: 10px; }
  #essalem-collection-lux .ee-review-card__text { font-family: var(--ee-font-heading); font-style: italic; font-size: 1.05rem; color: var(--ee-black); line-height: 1.7; margin: 0 0 14px; }
  #essalem-collection-lux .ee-review-card__author { margin: 0; font-size: .82rem; font-weight: 700; color: #6b6b6b; }
  #essalem-collection-lux .ee-reviews__arrow { flex-shrink: 0; width: 42px; height: 42px; border-radius: 50%; border: 1px solid rgba(17,17,17,.15); background: var(--ee-white); font-size: 1.3rem; cursor: pointer; transition: all .25s ease; }
  #essalem-collection-lux .ee-reviews__arrow:hover { background: var(--ee-black); color: var(--ee-white); border-color: var(--ee-black); }

