<!-- ══════════════ BENEFITS TABS ══════════════ -->
<section class="pb-section pb-anim">
  <div class="pb-container">
    <p class="pb-sec-label">الفوائد</p>
    <h2 class="pb-sec-title">مناسب للجميع</h2>
    <div class="pb-divider"></div>
    <div class="pb-tabs">
      <button class="pb-tab-btn active" onclick="pbTab(this,'kids')">👶 للأطفال</button>
      <button class="pb-tab-btn" onclick="pbTab(this,'women')">👩 للنساء</button>
      <button class="pb-tab-btn" onclick="pbTab(this,'men')">💪 للرجال</button>
    </div>

    <!-- KIDS -->
    <div class="pb-tab-panel active" id="pb-panel-kids">
      {% if product.media.size > 1 %}
        <img src="{{ product.media[1] | image_url: width: 600 }}" alt="طفل يتدرب" class="pb-tab-img" loading="lazy">
      {% else %}
        <div style="width:100%;max-width:500px;height:260px;background:linear-gradient(135deg,#f5f5f5,#e0e0e0);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:4rem;margin:0 auto 30px">👶🥊</div>
      {% endif %}
      <div class="pb-benefit-grid">
        <div class="pb-bcard"><div class="pb-bcard-icon">🛡️</div><div class="pb-bcard-text"><h4>تعلّم الدفاع عن النفس</h4><p>يساعد الطفل على تعلم أساسيات الدفاع عن النفس بطريقة ممتعة وآمنة.</p></div></div>
        <div class="pb-bcard"><div class="pb-bcard-icon">⚡</div><div class="pb-bcard-text"><h4>سرعة رد الفعل</h4><p>يطور سرعة رد الفعل والتنسيق الحركي لدى الطفل بشكل طبيعي.</p></div></div>
        <div class="pb-bcard"><div class="pb-bcard-icon">🎯</div><div class="pb-bcard-text"><h4>تركيز وثقة بالنفس</h4><p>يزيد مستوى التركيز والثقة بالنفس من خلال التمرين المنتظم.</p></div></div>
        <div class="pb-bcard"><div class="pb-bcard-icon">📵</div><div class="pb-bcard-text"><h4>أبعد عن الشاشات</h4><p>يبعد الأطفال عن كثرة استخدام الأجهزة الإلكترونية بطريقة ممتعة.</p></div></div>
      </div>
    </div>

    <!-- WOMEN -->
    <div class="pb-tab-panel" id="pb-panel-women">
      {% if product.media.size > 2 %}
        <img src="{{ product.media[2] | image_url: width: 600 }}" alt="امرأة تتدرب" class="pb-tab-img" loading="lazy">
      {% else %}
        <div style="width:100%;max-width:500px;height:260px;background:linear-gradient(135deg,#fce4ec,#f8bbd0);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:4rem;margin:0 auto 30px">👩🥊</div>
      {% endif %}
      <div class="pb-benefit-grid">
        <div class="pb-bcard"><div class="pb-bcard-icon">🔥</div><div class="pb-bcard-text"><h4>حرق السعرات في المنزل</h4><p>تمرين كارديو ممتع يساعد على حرق السعرات الحرارية دون الحاجة للخروج.</p></div></div>
        <div class="pb-bcard"><div class="pb-bcard-icon">😌</div><div class="pb-bcard-text"><h4>تخفيف التوتر</h4><p>وسيلة رائعة لتخفيف التوتر والإجهاد بعد يوم طويل ومرهق.</p></div></div>
        <div class="pb-bcard"><div class="pb-bcard-icon">💃</div><div class="pb-bcard-text"><h4>كارديو بطريقة ممتعة</h4><p>تمرين كارديو ممتع ومحفز دون الحاجة إلى الذهاب للنادي الرياضي.</p></div></div>
        <div class="pb-bcard"><div class="pb-bcard-icon">🌟</div><div class="pb-bcard-text"><h4>لجميع مستويات اللياقة</h4><p>مناسب للمبتدئات والمتمرنات على حد سواء بأي مستوى لياقة.</p></div></div>
      </div>
    </div>

    <!-- MEN -->
    <div class="pb-tab-panel" id="pb-panel-men">
      {% if product.media.size > 3 %}
        <img src="{{ product.media[3] | image_url: width: 600 }}" alt="رجل يتدرب" class="pb-tab-img" loading="lazy">
      {% else %}
        <div style="width:100%;max-width:500px;height:260px;background:linear-gradient(135deg,#e8e8e8,#cfcfcf);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:4rem;margin:0 auto 30px">💪🥊</div>
      {% endif %}
      <div class="pb-benefit-grid">
        <div class="pb-bcard"><div class="pb-bcard-icon">🏋️</div><div class="pb-bcard-text"><h4>تحسين اللياقة البدنية</h4><p>تمرين شامل يحسّن اللياقة البدنية العامة ويقوي الجسم بشكل متكامل.</p></div></div>
        <div class="pb-bcard"><div class="pb-bcard-icon">🥋</div><div class="pb-bcard-text"><h4>ملاكمة وكيك بوكسينغ</h4><p>مثالي للتدرب على تقنيات الملاكمة والكيك بوكسينغ في المنزل.</p></div></div>
        <div class="pb-bcard"><div class="pb-bcard-icon">⚡</div><div class="pb-bcard-text"><h4>سرعة اللكم وردة الفعل</h4><p>تقوية سرعة اللكم وتطوير ردود الفعل السريعة مع الممارسة المنتظمة.</p></div></div>
        <div class="pb-bcard"><div class="pb-bcard-icon">😤</div><div class="pb-bcard-text"><h4>تفريغ الطاقة</h4><p>طريقة ممتعة وصحية لتفريغ الطاقة والحصول على راحة نفسية حقيقية.</p></div></div>
      </div>
    </div>
  </div>
</section>

