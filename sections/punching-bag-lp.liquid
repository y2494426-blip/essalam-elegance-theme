<script>
(function(){
  // LOADER
  window.addEventListener('load',function(){
    setTimeout(function(){document.getElementById('pb-loader').classList.add('hide');},1400);
  });

  // PROGRESS
  window.addEventListener('scroll',function(){
    var s=window.scrollY,h=document.body.scrollHeight-window.innerHeight;
    document.getElementById('pb-progress').style.width=(s/h*100)+'%';
  },{passive:true});

  // COUNTDOWN — 12 hour reset
  function pbCountdown(){
    var key='pb_cd_end',now=Date.now(),end=parseInt(localStorage.getItem(key)||'0');
    if(!end||end<now){end=now+12*3600*1000;localStorage.setItem(key,end);}
    function tick(){
      var left=Math.max(0,end-Date.now()),h=Math.floor(left/3600000),m=Math.floor(left%3600000/60000),s=Math.floor(left%60000/1000);
      document.getElementById('pb-ctd').textContent=(h<10?'0':'')+h+':'+(m<10?'0':'')+m+':'+(s<10?'0':'')+s;
      if(left>0)setTimeout(tick,1000);
    }
    tick();
  }
  pbCountdown();

  // VIEWERS COUNTER
  var vc=Math.floor(Math.random()*20)+38;
  document.getElementById('pb-vcount').textContent=vc;
  setInterval(function(){
    vc+=Math.random()>.5?1:-1;vc=Math.max(30,Math.min(80,vc));
    document.getElementById('pb-vcount').textContent=vc;
  },4000);

  // TOAST
  var toasts=[
    {n:'خالد',c:'الرياض',m:'طلب للتو قطعتين 🥊🥊'},
    {n:'نورة',c:'جدة',m:'طلبت للتو قطعة واحدة 🥊'},
    {n:'محمد',c:'الدمام',m:'أضاف للسلة قطعتين 🔥'},
    {n:'سارة',c:'مكة',m:'طلبت للتو — عرض الاثنتين 🥊'},
    {n:'عبدالله',c:'المدينة',m:'طلب قطعتين بعد مشاهدة التقييمات'},
    {n:'ريم',c:'الطائف',m:'أكملت الطلب للتو ✅'},
    {n:'فيصل',c:'القصيم',m:'طلب قطعتين هدية 🎁'},
    {n:'هند',c:'أبها',m:'طلبت قطعة واحدة 🥊'},
  ];
  var ti=0;
  function showToast(){
    var t=toasts[ti%toasts.length];ti++;
    var el=document.getElementById('pb-toast');
    el.querySelector('.pb-t-name').textContent=t.n+' — '+t.c;
    el.querySelector('.pb-t-msg').textContent=t.m;
    el.classList.add('show');
    setTimeout(function(){el.classList.remove('show');setTimeout(showToast,Math.random()*5000+4000);},3500);
  }
  setTimeout(showToast,3000);

  // LIGHTBOX
  window.pbOpenLb=function(src){
    document.getElementById('pb-lb-img').src=src;
    document.getElementById('pb-lb').classList.add('open');
  };
  document.getElementById('pb-lb').addEventListener('click',function(e){
    if(e.target===this)this.classList.remove('open');
  });

  // TABS
  window.pbTab=function(btn,panel){
    document.querySelectorAll('.pb-tab-btn').forEach(function(b){b.classList.remove('active');});
    document.querySelectorAll('.pb-tab-panel').forEach(function(p){p.classList.remove('active');});
    btn.classList.add('active');
    document.getElementById('pb-panel-'+panel).classList.add('active');
  };

  // FAQ
  document.querySelectorAll('.pb-faq-q').forEach(function(q){
    q.addEventListener('click',function(){
      var item=this.parentElement;
      item.classList.toggle('open');
    });
  });

  // OFFER CARDS
  window.pbOffer=function(card){
    document.querySelectorAll('.pb-ocard').forEach(function(c){c.classList.remove('active');});
    card.classList.add('active');
    var vid=card.dataset.vid,price=card.dataset.price;
    var inp=document.getElementById('pb-vid');
    if(inp)inp.value=vid;
    document.getElementById('pb-sticky-price').textContent=price;
  };

  // RIPPLE
  window.pbRipple=function(btn,e){
    var r=document.createElement('span');r.className='pb-ripple';
    var rect=btn.getBoundingClientRect(),size=Math.max(rect.width,rect.height);
    r.style.cssText='width:'+size+'px;height:'+size+'px;top:'+(e.clientY-rect.top-size/2)+'px;right:'+(rect.right-e.clientX-size/2)+'px';
    btn.appendChild(r);setTimeout(function(){r.remove();},600);
  };

  // SCROLL ANIMATIONS
  var obs=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting)e.target.classList.add('visible');});
  },{threshold:.12});
  document.querySelectorAll('.pb-anim').forEach(function(el){obs.observe(el);});

  // STICKY CTA — hide when order form is in view
  var orderSec=document.getElementById('pb-order');
  var stObs=new IntersectionObserver(function(entries){
    document.getElementById('pb-sticky').style.display=entries[0].isIntersecting?'none':'';
  },{threshold:.1});
  if(orderSec)stObs.observe(orderSec);
})();
</script>

