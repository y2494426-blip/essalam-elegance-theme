{% comment %} Punching Bag Landing Page — Saudi Arabic RTL — prefix: pb- {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --pb-black:#111111;
  --pb-dark:#1a1a1a;
  --pb-red:#E53935;
  --pb-red2:#c62828;
  --pb-white:#ffffff;
  --pb-gray:#f4f4f4;
  --pb-gray2:#e8e8e8;
  --pb-text:#222222;
  --pb-muted:#666666;
  --pb-radius:16px;
  --pb-shadow:0 4px 24px rgba(0,0,0,0.10);
  --pb-shadow-lg:0 8px 40px rgba(0,0,0,0.16);
}
body{font-family:'Tajawal',sans-serif;direction:rtl;background:#fff;color:var(--pb-text);overflow-x:hidden}

/* ── LOADER ── */
#pb-loader{position:fixed;inset:0;background:var(--pb-black);z-index:9999;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:20px;transition:opacity .5s}
#pb-loader.hide{opacity:0;pointer-events:none}
.pb-loader-logo{font-size:2.4rem;font-weight:900;color:#fff;letter-spacing:1px}
.pb-loader-logo span{color:var(--pb-red)}
.pb-loader-bar{width:200px;height:4px;background:rgba(255,255,255,.15);border-radius:4px;overflow:hidden}
.pb-loader-fill{height:100%;width:0;background:var(--pb-red);border-radius:4px;animation:pb-load 1.4s ease forwards}
@keyframes pb-load{to{width:100%}}

/* ── PROGRESS BAR ── */
#pb-progress{position:fixed;top:0;left:0;right:0;height:3px;background:var(--pb-red);z-index:9998;width:0%;transition:width .2s}

/* ── TOAST ── */
#pb-toast{position:fixed;bottom:24px;right:24px;background:var(--pb-black);color:#fff;padding:12px 18px;border-radius:12px;font-size:.85rem;z-index:9000;opacity:0;transform:translateY(16px);transition:all .4s;max-width:260px;box-shadow:0 4px 20px rgba(0,0,0,.35)}
#pb-toast.show{opacity:1;transform:translateY(0)}
#pb-toast .pb-t-name{font-weight:700;color:var(--pb-red)}

/* ── LIGHTBOX ── */
#pb-lb{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:9500;display:none;align-items:center;justify-content:center}
#pb-lb.open{display:flex}
#pb-lb img{max-width:92vw;max-height:88vh;border-radius:12px;object-fit:contain}
.pb-lb-close{position:absolute;top:20px;right:20px;color:#fff;font-size:2rem;cursor:pointer;line-height:1;background:rgba(255,255,255,.15);border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center}

/* ── TOP BAR ── */
.pb-topbar{background:var(--pb-black);color:#fff;text-align:center;padding:10px 16px;font-size:.9rem;font-weight:700;position:sticky;top:0;z-index:800}
.pb-topbar .pb-countdown{color:var(--pb-red);font-weight:900}

/* ── NAV ── */
.pb-nav{background:#fff;border-bottom:2px solid var(--pb-gray2);padding:14px 20px;display:flex;align-items:center;justify-content:center;position:sticky;top:44px;z-index:700;box-shadow:0 2px 12px rgba(0,0,0,.06)}
.pb-nav-logo{font-size:1.4rem;font-weight:900;color:var(--pb-black)}
.pb-nav-logo span{color:var(--pb-red)}

/* ── HERO ── */
.pb-hero{background:linear-gradient(135deg,#111 0%,#1e1e1e 50%,#2a2a2a 100%);min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px 20px 40px;position:relative;overflow:hidden}
.pb-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 30% 50%,rgba(229,57,53,.12) 0%,transparent 60%);pointer-events:none}
.pb-hero-badge{background:var(--pb-red);color:#fff;padding:6px 18px;border-radius:50px;font-size:.85rem;font-weight:700;margin-bottom:20px;display:inline-block;animation:pb-pulse 2s infinite}
@keyframes pb-pulse{0%,100%{box-shadow:0 0 0 0 rgba(229,57,53,.4)}50%{box-shadow:0 0 0 10px rgba(229,57,53,0)}}
.pb-hero-title{font-size:clamp(1.8rem,5vw,3rem);font-weight:900;color:#fff;text-align:center;line-height:1.25;margin-bottom:16px;max-width:700px}
.pb-hero-title span{color:var(--pb-red)}
.pb-hero-sub{font-size:1.1rem;color:rgba(255,255,255,.75);text-align:center;margin-bottom:30px;max-width:500px}
.pb-hero-img-wrap{position:relative;margin:0 auto 30px;max-width:380px;width:100%}
.pb-hero-img-wrap img{width:100%;border-radius:20px;display:block;animation:pb-float 3.5s ease-in-out infinite;filter:drop-shadow(0 20px 40px rgba(229,57,53,.3))}
@keyframes pb-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
.pb-hero-stars{display:flex;align-items:center;justify-content:center;gap:6px;margin-bottom:20px;color:rgba(255,255,255,.7);font-size:.9rem}
.pb-hero-stars .stars{color:#FFD700;font-size:1.1rem}
.pb-hero-trust{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:20px}
.pb-trust-pill{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:#fff;padding:8px 16px;border-radius:50px;font-size:.85rem;display:flex;align-items:center;gap:6px;backdrop-filter:blur(6px)}
.pb-trust-pill .pi{color:var(--pb-red)}

/* ── VIEWERS ── */
.pb-viewers{background:rgba(229,57,53,.08);border:1px solid rgba(229,57,53,.2);border-radius:12px;padding:10px 18px;font-size:.9rem;color:rgba(255,255,255,.85);display:inline-flex;align-items:center;gap:8px;margin-bottom:16px}
.pb-viewers .pb-dot{width:8px;height:8px;background:var(--pb-red);border-radius:50%;animation:pb-blink 1.2s infinite}
@keyframes pb-blink{0%,100%{opacity:1}50%{opacity:.3}}

/* ── CTA BUTTON ── */
.pb-cta-btn{background:linear-gradient(135deg,var(--pb-red),var(--pb-red2));color:#fff;font-family:'Tajawal',sans-serif;font-size:1.2rem;font-weight:800;padding:18px 48px;border:none;border-radius:50px;cursor:pointer;display:inline-flex;align-items:center;gap:10px;box-shadow:0 8px 30px rgba(229,57,53,.45);transition:transform .2s,box-shadow .2s;position:relative;overflow:hidden;text-decoration:none}
.pb-cta-btn:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(229,57,53,.55)}
.pb-cta-btn .pb-ripple{position:absolute;border-radius:50%;transform:scale(0);animation:pb-rip .6s linear;background:rgba(255,255,255,.3);pointer-events:none}
@keyframes pb-rip{to{transform:scale(4);opacity:0}}

/* ── SOCIAL PROOF BAR ── */
.pb-proof-bar{background:var(--pb-gray);padding:16px 0;overflow:hidden;border-bottom:2px solid var(--pb-gray2)}
.pb-proof-track{display:flex;gap:40px;animation:pb-scroll-r 28s linear infinite;width:max-content;white-space:nowrap}
.pb-proof-item{display:flex;align-items:center;gap:8px;font-size:.9rem;color:var(--pb-text);font-weight:600}
.pb-proof-item .pi{color:var(--pb-red)}
@keyframes pb-scroll-r{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ── SECTION TITLES ── */
.pb-section{padding:70px 20px}
.pb-container{max-width:1100px;margin:0 auto}
.pb-sec-label{font-size:.8rem;font-weight:700;color:var(--pb-red);letter-spacing:2px;text-transform:uppercase;text-align:center;margin-bottom:10px}
.pb-sec-title{font-size:clamp(1.6rem,4vw,2.4rem);font-weight:900;text-align:center;color:var(--pb-black);margin-bottom:14px;line-height:1.25}
.pb-sec-sub{font-size:1rem;color:var(--pb-muted);text-align:center;max-width:560px;margin:0 auto 50px}

/* ── BENEFITS TABS ── */
.pb-tabs{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-bottom:36px}
.pb-tab-btn{padding:10px 24px;border-radius:50px;border:2px solid var(--pb-gray2);background:#fff;font-family:'Tajawal',sans-serif;font-size:1rem;font-weight:700;cursor:pointer;transition:all .2s;color:var(--pb-muted)}
.pb-tab-btn.active{background:var(--pb-red);color:#fff;border-color:var(--pb-red)}
.pb-tab-panel{display:none;animation:pb-fade .4s}
.pb-tab-panel.active{display:block}
@keyframes pb-fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.pb-benefit-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.pb-bcard{background:#fff;border-radius:var(--pb-radius);padding:24px 20px;box-shadow:var(--pb-shadow);display:flex;gap:14px;align-items:flex-start;transition:transform .2s,box-shadow .2s}
.pb-bcard:hover{transform:translateY(-4px);box-shadow:var(--pb-shadow-lg)}
.pb-bcard-icon{width:48px;height:48px;background:linear-gradient(135deg,var(--pb-red),var(--pb-red2));border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0;color:#fff}
.pb-bcard-text h4{font-size:1rem;font-weight:700;margin-bottom:6px;color:var(--pb-black)}
.pb-bcard-text p{font-size:.9rem;color:var(--pb-muted);line-height:1.6}
.pb-tab-img{width:100%;max-width:500px;border-radius:20px;margin:0 auto 30px;display:block;object-fit:cover;box-shadow:var(--pb-shadow-lg)}

/* ── WHY CHOOSE ── */
.pb-why-bg{background:linear-gradient(135deg,#0f0f0f 0%,#1a1a1a 100%)}
.pb-why-bg .pb-sec-title,.pb-why-bg .pb-sec-label,.pb-why-bg .pb-sec-sub{color:#fff}
.pb-why-bg .pb-sec-sub{color:rgba(255,255,255,.6)}
.pb-why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.pb-why-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:var(--pb-radius);padding:28px 20px;text-align:center;transition:all .3s;backdrop-filter:blur(8px)}
.pb-why-card:hover{background:rgba(229,57,53,.12);border-color:rgba(229,57,53,.4);transform:translateY(-6px)}
.pb-why-icon{font-size:2.4rem;margin-bottom:14px}
.pb-why-card h4{font-size:1rem;font-weight:700;color:#fff;margin-bottom:8px}
.pb-why-card p{font-size:.875rem;color:rgba(255,255,255,.55);line-height:1.6}

/* ── LIFESTYLE ── */
.pb-lifestyle-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.pb-lf-item{border-radius:var(--pb-radius);overflow:hidden;position:relative;cursor:pointer}
.pb-lf-item img{width:100%;height:260px;object-fit:cover;display:block;transition:transform .4s}
.pb-lf-item:hover img{transform:scale(1.05)}
.pb-lf-label{position:absolute;bottom:14px;right:14px;background:rgba(0,0,0,.65);color:#fff;padding:6px 14px;border-radius:50px;font-size:.85rem;font-weight:700;backdrop-filter:blur(6px)}
.pb-lf-item.large{grid-column:span 2}
.pb-lf-item.large img{height:360px}

/* ── CALORIES ── */
.pb-cal-bg{background:var(--pb-gray)}
.pb-cal-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}
.pb-cal-card{background:#fff;border-radius:var(--pb-radius);padding:32px 20px;text-align:center;box-shadow:var(--pb-shadow);position:relative;overflow:hidden}
.pb-cal-card.highlight{background:linear-gradient(135deg,var(--pb-black),#2a2a2a);color:#fff}
.pb-cal-card.highlight .pb-cal-label,.pb-cal-card.highlight .pb-cal-val{color:#fff}
.pb-cal-card.highlight .pb-cal-sub{color:rgba(255,255,255,.6)}
.pb-cal-card::before{content:'';position:absolute;top:0;right:0;width:60px;height:60px;background:var(--pb-red);opacity:.1;border-radius:0 0 0 100%}
.pb-cal-icon{font-size:2.8rem;margin-bottom:12px}
.pb-cal-label{font-size:.85rem;font-weight:700;color:var(--pb-muted);margin-bottom:8px}
.pb-cal-val{font-size:2rem;font-weight:900;color:var(--pb-black);margin-bottom:4px}
.pb-cal-sub{font-size:.85rem;color:var(--pb-muted)}
.pb-cal-badge{position:absolute;top:14px;left:14px;background:var(--pb-red);color:#fff;font-size:.75rem;font-weight:700;padding:4px 10px;border-radius:50px}

/* ── FEATURES GRID ── */
.pb-feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.pb-feat-card{background:#fff;border-radius:var(--pb-radius);padding:28px 20px;text-align:center;box-shadow:var(--pb-shadow);border:2px solid transparent;transition:all .25s}
.pb-feat-card:hover{border-color:var(--pb-red);transform:translateY(-4px)}
.pb-feat-icon{font-size:2.2rem;margin-bottom:12px}
.pb-feat-card h4{font-size:.95rem;font-weight:700;color:var(--pb-black)}

/* ── WHAT'S INCLUDED ── */
.pb-inc-bg{background:var(--pb-black)}
.pb-inc-bg .pb-sec-title,.pb-inc-bg .pb-sec-label{color:#fff}
.pb-inc-bg .pb-sec-sub{color:rgba(255,255,255,.55)}
.pb-inc-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.pb-inc-card{background:rgba(255,255,255,.05);border:1.5px solid rgba(255,255,255,.12);border-radius:20px;padding:32px 28px;position:relative;transition:all .3s}
.pb-inc-card.best{border-color:var(--pb-red);background:rgba(229,57,53,.08)}
.pb-inc-card.best::before{content:'🔥 الأكثر توفيراً';position:absolute;top:-14px;right:24px;background:var(--pb-red);color:#fff;font-size:.8rem;font-weight:700;padding:4px 14px;border-radius:50px}
.pb-inc-price{font-size:2rem;font-weight:900;color:#fff;margin-bottom:8px}
.pb-inc-price span{font-size:1rem;font-weight:400;color:rgba(255,255,255,.5)}
.pb-inc-old{font-size:.9rem;color:rgba(255,255,255,.4);text-decoration:line-through;margin-bottom:16px}
.pb-inc-items li{list-style:none;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.08);font-size:.95rem;color:rgba(255,255,255,.8);display:flex;align-items:center;gap:8px}
.pb-inc-items li::before{content:'✓';color:var(--pb-red);font-weight:900}
.pb-inc-save{font-size:.85rem;color:var(--pb-red);font-weight:700;margin-top:12px}

/* ── OFFER / ORDER ── */
.pb-offer-bg{background:linear-gradient(135deg,#111,#1e1e1e)}
.pb-offer-bg .pb-sec-title,.pb-offer-bg .pb-sec-label{color:#fff}
.pb-offer-bg .pb-sec-sub{color:rgba(255,255,255,.6)}
.pb-offer-cards{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:32px}
.pb-ocard{background:rgba(255,255,255,.06);border:2px solid rgba(255,255,255,.12);border-radius:var(--pb-radius);padding:24px 20px;cursor:pointer;transition:all .25s;text-align:center;position:relative}
.pb-ocard.active{background:rgba(229,57,53,.12);border-color:var(--pb-red)}
.pb-ocard-badge{position:absolute;top:-12px;right:50%;transform:translateX(50%);background:var(--pb-red);color:#fff;font-size:.75rem;font-weight:700;padding:4px 14px;border-radius:50px;white-space:nowrap}
.pb-ocard-title{font-size:1.1rem;font-weight:700;color:#fff;margin-bottom:4px}
.pb-ocard-price{font-size:1.8rem;font-weight:900;color:var(--pb-red);margin-bottom:4px}
.pb-ocard-old{font-size:.85rem;color:rgba(255,255,255,.4);text-decoration:line-through}
.pb-ocard-save{font-size:.8rem;color:#4CAF50;font-weight:700;margin-top:4px}
.pb-order-info{display:flex;justify-content:center;gap:20px;flex-wrap:wrap;margin-top:20px}
.pb-oi-pill{display:flex;align-items:center;gap:6px;color:rgba(255,255,255,.7);font-size:.85rem}
.pb-oi-pill .pi{color:var(--pb-red)}

/* ── REVIEWS ── */
.pb-rev-bg{background:var(--pb-gray)}
.pb-rev-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.pb-rev-card{background:#fff;border-radius:var(--pb-radius);padding:24px 20px;box-shadow:var(--pb-shadow);border-top:4px solid var(--pb-red)}
.pb-rev-header{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.pb-rev-avatar{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--pb-red),var(--pb-red2));display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:900;color:#fff;flex-shrink:0}
.pb-rev-info h5{font-size:.95rem;font-weight:700;color:var(--pb-black)}
.pb-rev-info span{font-size:.8rem;color:var(--pb-muted)}
.pb-rev-stars{color:#FFD700;font-size:.95rem;margin-bottom:8px}
.pb-rev-text{font-size:.9rem;color:var(--pb-muted);line-height:1.65}
.pb-rev-badge{font-size:.75rem;color:var(--pb-red);font-weight:700;margin-top:8px;display:flex;align-items:center;gap:4px}

/* ── FAQ ── */
.pb-faq-list{max-width:760px;margin:0 auto}
.pb-faq-item{background:#fff;border-radius:14px;margin-bottom:12px;box-shadow:var(--pb-shadow);overflow:hidden;border:2px solid transparent;transition:border .2s}
.pb-faq-item.open{border-color:var(--pb-red)}
.pb-faq-q{padding:20px 22px;font-size:1rem;font-weight:700;cursor:pointer;display:flex;justify-content:space-between;align-items:center;color:var(--pb-black);gap:12px}
.pb-faq-arrow{font-size:1.2rem;transition:transform .3s;flex-shrink:0}
.pb-faq-item.open .pb-faq-arrow{transform:rotate(180deg)}
.pb-faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease,padding .3s}
.pb-faq-item.open .pb-faq-a{max-height:200px;padding:0 22px 18px}
.pb-faq-a p{font-size:.9rem;color:var(--pb-muted);line-height:1.7}

/* ── TRUST BADGES ── */
.pb-trust-section{background:var(--pb-black)}
.pb-trust-section .pb-sec-title{color:#fff}
.pb-trust-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px}
.pb-trust-card{text-align:center;padding:24px 12px}
.pb-trust-card .pb-ti{font-size:2.2rem;margin-bottom:10px}
.pb-trust-card h4{font-size:.9rem;font-weight:700;color:#fff}

/* ── FINAL CTA ── */
.pb-final-bg{background:linear-gradient(135deg,var(--pb-red),var(--pb-red2));padding:70px 20px;text-align:center}
.pb-final-title{font-size:clamp(1.6rem,4vw,2.6rem);font-weight:900;color:#fff;margin-bottom:12px;text-shadow:0 2px 8px rgba(0,0,0,.3)}
.pb-final-sub{color:rgba(255,255,255,.85);font-size:1.05rem;margin-bottom:32px}
.pb-final-btn{background:#fff;color:var(--pb-red);font-family:'Tajawal',sans-serif;font-size:1.2rem;font-weight:900;padding:18px 52px;border:none;border-radius:50px;cursor:pointer;box-shadow:0 8px 30px rgba(0,0,0,.25);transition:transform .2s,box-shadow .2s}
.pb-final-btn:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(0,0,0,.35)}

/* ── FOOTER ── */
.pb-footer{background:var(--pb-black);color:rgba(255,255,255,.45);text-align:center;padding:28px 16px;font-size:.85rem}
.pb-footer strong{color:var(--pb-red)}

/* ── STICKY MOBILE CTA ── */
#pb-sticky{display:none;position:fixed;bottom:0;left:0;right:0;z-index:600;background:#fff;border-top:3px solid var(--pb-red);padding:12px 16px;gap:10px;align-items:center;justify-content:space-between;box-shadow:0 -4px 20px rgba(0,0,0,.15)}
#pb-sticky .pb-st-price{font-size:1.2rem;font-weight:900;color:var(--pb-black)}
#pb-sticky .pb-st-price small{font-size:.8rem;color:var(--pb-muted);display:block;font-weight:400}
#pb-sticky .pb-cta-btn{font-size:1rem;padding:12px 28px}

/* ── ANIM ── */
.pb-anim{opacity:0;transform:translateY(28px);transition:opacity .6s,transform .6s}
.pb-anim.visible{opacity:1;transform:translateY(0)}

/* ── EASYSELL FORM ── */
.pb-form-wrap{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:var(--pb-radius);padding:28px 20px}

/* ── RESPONSIVE ── */
@media(max-width:768px){
  #pb-sticky{display:flex}
  .pb-benefit-grid{grid-template-columns:1fr}
  .pb-why-grid{grid-template-columns:1fr 1fr}
  .pb-cal-cards{grid-template-columns:1fr}
  .pb-feat-grid{grid-template-columns:repeat(2,1fr)}
  .pb-inc-grid{grid-template-columns:1fr}
  .pb-offer-cards{grid-template-columns:1fr}
  .pb-rev-grid{grid-template-columns:1fr}
  .pb-trust-grid{grid-template-columns:repeat(3,1fr)}
  .pb-lifestyle-grid{grid-template-columns:1fr}
  .pb-lf-item.large{grid-column:span 1}
  .pb-lf-item img,.pb-lf-item.large img{height:200px}
}
@media(max-width:480px){
  .pb-why-grid{grid-template-columns:1fr}
  .pb-feat-grid{grid-template-columns:1fr 1fr}
  .pb-trust-grid{grid-template-columns:repeat(2,1fr)}
}

/* ── DIVIDER ── */
.pb-divider{width:60px;height:4px;background:var(--pb-red);border-radius:4px;margin:0 auto 50px}
</style>

<!-- LOADER -->
<div id="pb-loader">
  <div class="pb-loader-logo">BOXING<span>PRO</span></div>
  <div class="pb-loader-bar"><div class="pb-loader-fill"></div></div>
</div>

<!-- PROGRESS BAR -->
<div id="pb-progress"></div>

<!-- TOAST -->
<div id="pb-toast">
  <div class="pb-t-name"></div>
  <div class="pb-t-msg"></div>
</div>

<!-- LIGHTBOX -->
<div id="pb-lb">
  <div class="pb-lb-close" onclick="document.getElementById('pb-lb').classList.remove('open')">✕</div>
  <img id="pb-lb-img" src="" alt="">
</div>

<!-- STICKY MOBILE CTA -->
<div id="pb-sticky">
  <div class="pb-st-price">
    <small>السعر</small>
    <span id="pb-sticky-price">175 ريال</span>
  </div>
  <button class="pb-cta-btn" onclick="document.getElementById('pb-order').scrollIntoView({behavior:'smooth'})">🥊 اطلب الآن</button>
</div>

<!-- TOP BAR -->
<div class="pb-topbar">
  ⚡ عرض محدود — ينتهي خلال: <span class="pb-countdown" id="pb-ctd">00:00:00</span> — الشحن مجاني لجميع مناطق المملكة
</div>

<!-- NAV -->
<div class="pb-nav">
  <div class="pb-nav-logo">BOXING<span>PRO</span></div>
</div>

<!-- ══════════════ HERO ══════════════ -->
<section class="pb-hero">
  <div class="pb-hero-badge">🥊 المنتج الأكثر مبيعاً في 2025</div>
  <div class="pb-viewers" id="pb-viewers-hero">
    <span class="pb-dot"></span>
    <span id="pb-vcount">47</span> شخص يشاهد هذا المنتج الآن
  </div>
  <div class="pb-hero-img-wrap">
    {% if product.media.size > 0 %}
      <img src="{{ product.media[0] | image_url: width: 700 }}" alt="{{ product.title }}" loading="eager" onclick="pbOpenLb(this.src)">
    {% else %}
      <div style="width:100%;height:420px;background:linear-gradient(135deg,#2a2a2a,#1a1a1a);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:5rem">🥊</div>
    {% endif %}
  </div>
  <h1 class="pb-hero-title">حوّل منزلك إلى <span>مساحة تدريب</span> متكاملة</h1>
  <p class="pb-hero-sub">تدرب في أي وقت دون الحاجة للذهاب إلى النادي. مناسب للأطفال والنساء والرجال.</p>
  <div class="pb-hero-stars">
    <span class="stars">★★★★★</span>
    <span>4.9/5 — +1,200 عميل راضٍ في السعودية</span>
  </div>
  <button class="pb-cta-btn" onclick="document.getElementById('pb-order').scrollIntoView({behavior:'smooth'});pbRipple(this,event)">
    🥊 اطلب الآن
  </button>
  <div class="pb-hero-trust">
    <span class="pb-trust-pill"><span class="pi">✅</span> شحن مجاني</span>
    <span class="pb-trust-pill"><span class="pi">✅</span> الدفع عند الاستلام</span>
    <span class="pb-trust-pill"><span class="pi">✅</span> توصيل سريع داخل السعودية</span>
  </div>
</section>

