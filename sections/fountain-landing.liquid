<section class="ft-section ft-form-section" id="ft-main-form">
  <div class="ft-wrap">
    <div class="ft-center ft-fade">
      <span class="ft-eyebrow">اطلب الآن</span>
      <h2 class="ft-h2">الدفع عند الاستلام — مريح وآمن</h2>
    </div>
    <div class="ft-form-wrap ft-fade">
      <p class="ft-form-title ft-center">🛒 أكمل طلبك الآن</p>
      <p class="ft-form-sub ft-center">أدخل بياناتك وسيتصل بك فريقنا خلال ساعات لتأكيد الشحن</p>

      {%- form 'product', product, id: 'ft-main-product-form', novalidate: true -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="ft-main-variant-id">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="ft-var-sec">
              <span class="ft-var-lbl">{{ option.name }}</span>
              <div class="ft-var-pills">
                {%- for value in option.values -%}
                  <label class="ft-var-pill">
                    <input type="radio" name="{{ option.name }}" value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}>
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="ft-qty-row">
          <span class="ft-qty-lbl">الكمية:</span>
          <div class="ft-qty-box">
            <button type="button" class="ft-qty-btn" onclick="var q=document.getElementById('ft-main-qty');if(q.value>1)q.value=+q.value-1;">−</button>
            <input type="number" id="ft-main-qty" name="quantity" value="1" min="1" class="ft-qty-inp" readonly>
            <button type="button" class="ft-qty-btn" onclick="var q=document.getElementById('ft-main-qty');q.value=+q.value+1;">+</button>
          </div>
        </div>

        {% content_for 'blocks' %}

        <button type="submit" name="add" class="ft-submit">
          🛒 اطلب الآن والدفع عند الاستلام
        </button>
      {%- endform -%}

      <p class="ft-secure" style="margin-top:14px;">🔒 طلبك آمن 100% — لا بطاقة بنكية مطلوبة</p>
