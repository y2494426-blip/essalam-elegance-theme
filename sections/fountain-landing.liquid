    {% endif %}
    <div>
      <div class="ft-sticky-title">{{ product.title | default: 'نافورة مكتبية فاخرة' }}</div>
      <div class="ft-sticky-price">{% if product.price %}{{ product.price | money }}{% else %}249 ر.س{% endif %}</div>
    </div>
  </div>
  <button type="button" class="ft-sticky-btn" onclick="document.getElementById('ft-order-form').scrollIntoView({behavior:'smooth'});">
    اطلب الآن 🛒
  </button>
</div>

</div>

<script>
(function(){
  var doc = document;

  /* ---- Header scroll effect ---- */
  var header = doc.getElementById('ftHeader');
  window.addEventListener('scroll', function(){
    if(window.scrollY > 60){ header.classList.add('scrolled'); }
    else { header.classList.remove('scrolled'); }
  }, { passive:true });

  /* ---- Fade on scroll ---- */
  var fadeEls = doc.querySelectorAll('.ft-fade, .ft-fade-l, .ft-fade-r, .ft-scale');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('ft-in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.10 });
  fadeEls.forEach(function(el){ io.observe(el); });

  /* ---- Animated counters ---- */
  function animateCounter(el, target, suffix){
    var start = 0;
    var dur = 1800;
    var step = target / (dur / 16);
    var timer = setInterval(function(){
      start = Math.min(start + step, target);
      el.textContent = Math.floor(start).toLocaleString('ar-SA') + (suffix || '');
      if(start >= target) clearInterval(timer);
    }, 16);
  }
  var counterEls = doc.querySelectorAll('[data-count]');
  var counterIo = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        var el = e.target;
        var target = parseInt(el.dataset.count);
        var suffix = el.dataset.suffix || '';
        animateCounter(el, target, suffix);
        counterIo.unobserve(el);
      }
    });
  }, { threshold:.5 });
  counterEls.forEach(function(el){ counterIo.observe(el); });

  /* ---- Sticky bar ---- */
  var stickyBar = doc.getElementById('ftStickyBar');
  var heroForm = doc.getElementById('ft-order-form');
  if(stickyBar && heroForm){
    var sio = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ stickyBar.classList.remove('ft-show'); }
        else{ stickyBar.classList.add('ft-show'); }
      });
    }, { threshold:.15 });
    sio.observe(heroForm);
  }

  /* ---- FAQ ---- */
  doc.querySelectorAll('[data-ft-faq]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.closest('.ft-faq-item');
      var wasOpen = item.classList.contains('ft-open');
      doc.querySelectorAll('.ft-faq-item.ft-open').forEach(function(el){ el.classList.remove('ft-open'); });
      if(!wasOpen) item.classList.add('ft-open');
    });
  });

  /* ---- Gallery lightbox ---- */
  var lb = doc.getElementById('ftLightbox');
  var lbImg = doc.getElementById('ftLightboxImg');
  var lbClose = doc.getElementById('ftLightboxClose');
  doc.querySelectorAll('[data-ft-lightbox]').forEach(function(item){
    item.addEventListener('click', function(){
      var src = item.dataset.ftLightbox;
      if(!lb || !src) return;
      lbImg.src = src;
      lb.classList.add('ft-open');
      doc.body.style.overflow = 'hidden';
    });
  });
  if(lbClose){ lbClose.addEventListener('click', function(){ lb.classList.remove('ft-open'); doc.body.style.overflow = ''; }); }
  if(lb){ lb.addEventListener('click', function(e){ if(e.target === lb){ lb.classList.remove('ft-open'); doc.body.style.overflow = ''; } }); }

  /* ---- Button ripple effect ---- */
  doc.querySelectorAll('.ft-submit').forEach(function(btn){
    btn.addEventListener('click', function(e){
      var rect = btn.getBoundingClientRect();
      var ripple = doc.createElement('span');
      ripple.className = 'ft-submit-ripple';
      var size = Math.max(btn.offsetWidth, btn.offsetHeight);
      ripple.style.cssText = 'width:'+size+'px;height:'+size+'px;top:'+(e.clientY-rect.top-size/2)+'px;left:'+(e.clientX-rect.left-size/2)+'px;';
      btn.appendChild(ripple);
      setTimeout(function(){ ripple.remove(); }, 700);
    });
  });

  /* ---- Countdown ---- */
  function startCountdown(hEl, mEl, sEl, total){
    var end = Date.now() + total * 1000;
    function tick(){
      var rem = Math.max(0, Math.floor((end - Date.now()) / 1000));
      var h = Math.floor(rem/3600);
      var m = Math.floor((rem%3600)/60);
      var s = rem%60;
      var pad = function(n){ return n<10?'0'+n:''+n; };
      if(hEl) hEl.textContent = pad(h);
      if(mEl) mEl.textContent = pad(m);
      if(sEl) sEl.textContent = pad(s);
      if(rem>0) setTimeout(tick, 1000);
    }
    tick();
  }
  startCountdown(
    doc.getElementById('ftH'),
    doc.getElementById('ftM'),
    doc.getElementById('ftS'),
    3*3600 + 59*60 + 59
  );

  /* ---- Variant sync ---- */
  var variantsEl = doc.getElementById('ft-variants-json');
  if(variantsEl){
    var variantData = JSON.parse(variantsEl.textContent);
    function syncVariants(formId, varInputId){
      var form = doc.getElementById(formId);
      if(!form) return;
      form.querySelectorAll('.ft-var-pill input').forEach(function(r){
        r.addEventListener('change', function(){
          var opts = {};
          form.querySelectorAll('.ft-var-pill input:checked').forEach(function(c){
            opts[c.name] = c.value;
          });
          var match = variantData.find(function(v){
            return Object.keys(opts).every(function(k,i){ return v['option'+(i+1)] === opts[k]; });
          });
          if(match){ var el = doc.getElementById(varInputId); if(el) el.value = match.id; }
        });
      });
    }
    syncVariants('ft-product-form','ft-variant-id');
    syncVariants('ft-main-product-form','ft-main-variant-id');
  }

})();
</script>

