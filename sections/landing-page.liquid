{%- comment -%} Essalem Elegance — single-file premium Arabic RTL landing page section (EasySell COD, no native Shopify buy form). {%- endcomment -%}
<section id="essalem-lp-root" dir="rtl" lang="ar">

<script src="https://cdn.tailwindcss.com"></script>
<script>
  window.tailwind = window.tailwind || {};
  tailwind.config = {
    corePlugins: { preflight: false },
    theme: {
      extend: {
        fontFamily: { tajawal: ['Tajawal', 'Arial', 'sans-serif'] },
        colors: {
          lpsky: '#dff4ff',
          lpgray: '#f5f5f5',
          lpsilver: '#e8e8e8',
          lpblue: '#0a84ff',
          lpblue2: '#0059c9',
          lpink: '#0d1420'
        },
        keyframes: {
          lpfloat: { '0%,100%': { transform: 'translateY(0)' }, '50%': { transform: 'translateY(-18px)' } },
          lpfloatslow: { '0%,100%': { transform: 'translate(0,0) scale(1)' }, '50%': { transform: 'translate(20px,-20px) scale(1.06)' } }
        },
        animation: {
          lpfloat: 'lpfloat 5s ease-in-out infinite',
          lpfloatslow: 'lpfloatslow 10s ease-in-out infinite'
        }
      }
    }
  };
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">

<style>
  #essalem-lp-root { font-family: 'Tajawal', Arial, sans-serif; background:#fff; color:#0d1420; overflow-x:hidden; direction: rtl; -webkit-font-smoothing:antialiased; }
  #essalem-lp-root *{ box-sizing:border-box; }
  #essalem-lp-root img{ max-width:100%; display:block; }
  #essalem-lp-root [data-lp-reveal]{ opacity:0; transform:translateY(28px); transition:opacity .7s ease, transform .7s ease; }
  #essalem-lp-root [data-lp-reveal].is-visible{ opacity:1; transform:translateY(0); }
  #essalem-lp-root .lp-scrollbar-none::-webkit-scrollbar{ display:none; }
  #essalem-lp-root .lp-scrollbar-none{ -ms-overflow-style:none; scrollbar-width:none; }
  #essalem-lp-root details summary{ cursor:pointer; list-style:none; }
  #essalem-lp-root details summary::-webkit-details-marker{ display:none; }
  #essalem-lp-root details summary .lp-plus{ transition:transform .25s ease; }
  #essalem-lp-root details[open] summary .lp-plus{ transform:rotate(45deg); }
  #essalem-lp-root .lp-blob{ position:absolute; border-radius:9999px; filter:blur(60px); opacity:.55; pointer-events:none; }
  #essalem-lp-root .lp-glass{ background:rgba(255,255,255,.6); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); border:1px solid rgba(13,20,32,.08); }
  @media (prefers-reduced-motion: reduce){
    #essalem-lp-root [data-lp-reveal]{ opacity:1; transform:none; transition:none; }
    #essalem-lp-root .animate-lpfloat, #essalem-lp-root .animate-lpfloatslow{ animation:none; }
  }
</style>

{%- if product -%}
  {%- assign lp_variant = product.selected_or_first_available_variant -%}
  {%- assign lp_media = lp_variant.featured_media | default: product.featured_media -%}
{%- endif -%}

<div class="max-w-[1240px] mx-auto px-6">

  <!-- ===== HERO ===== -->
  <section class="relative -mx-6 px-6 pt-24 pb-20 md:pt-28 md:pb-24 bg-gradient-to-b from-lpsky to-white overflow-hidden">
    <span class="lp-blob w-80 h-80 -top-20 -left-16 bg-lpblue animate-lpfloatslow"></span>
    <span class="lp-blob w-72 h-72 -bottom-16 -right-10 bg-lpsilver animate-lpfloatslow" style="animation-direction:reverse;"></span>

    <div class="relative z-10 grid md:grid-cols-2 gap-12 items-center">
      <div data-lp-reveal>
        <span class="inline-block text-sm font-bold tracking-wide text-lpblue2 bg-lpsky rounded-full px-4 py-2 mb-4">عروض حصرية</span>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-5 text-lpink">✨ اجعل مكتبك نظيفًا في ثوانٍ</h1>
        <p class="text-lg md:text-xl text-slate-600 leading-relaxed mb-8 max-w-xl">تخلص من الغبار، الفتات، وشعر الحيوانات الأليفة بسهولة مع المكنسة الكهربائية الصغيرة القابلة لإعادة الشحن عبر USB.</p>

        <div class="flex flex-wrap gap-4 mb-8 text-sm font-semibold text-slate-600">
          <span>✅ الدفع عند الاستلام</span>
          <span>🚚 شحن سريع</span>
          <span>⭐ جودة عالية</span>
          <span>🔒 ضمان رضا العملاء</span>
        </div>

        <div class="flex flex-wrap gap-4">
          <button type="button" data-lp-scroll="#essalem-lp-order" class="inline-flex items-center justify-center gap-2 font-bold text-white text-base px-9 py-4 rounded-full bg-gradient-to-l from-lpblue to-lpblue2 shadow-[0_16px_40px_-10px_rgba(10,132,255,0.5)] hover:-translate-y-1 transition">اطلب الآن</button>
          <button type="button" data-lp-scroll="#essalem-lp-features" class="inline-flex items-center justify-center gap-2 font-bold text-base px-9 py-4 rounded-full bg-white/70 backdrop-blur border border-black/10 hover:-translate-y-1 hover:bg-white transition">شاهد المميزات</button>
        </div>
      </div>

      <div class="flex items-center justify-center" data-lp-reveal>
        <div class="relative w-full max-w-[420px] aspect-square rounded-[28px] lp-glass shadow-[0_30px_80px_-24px_rgba(10,30,60,0.28)] flex items-center justify-center p-8 animate-lpfloat">
          {%- if lp_media -%}
            {{ lp_media | image_url: width: 800 | image_tag: loading: 'eager', alt: product.title, class: 'w-full h-full object-contain drop-shadow-2xl' }}
          {%- else -%}
            <svg viewBox="0 0 200 200" class="w-2/3 h-2/3 text-slate-300" fill="none"><circle cx="100" cy="90" r="70" stroke="currentColor" stroke-width="10"/><path d="M60 160 L140 160" stroke="currentColor" stroke-width="10" stroke-linecap="round"/></svg>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BENEFITS ===== -->
  <section class="py-20">
    <div class="text-center max-w-2xl mx-auto mb-12" data-lp-reveal>
      <span class="inline-block text-sm font-bold text-lpblue2 bg-lpsky rounded-full px-4 py-1.5 mb-3">لماذا تختارها</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-lpink">مميزات ستعشقها</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
      {%- assign lp_benefits = 'تنظيف سريع للمكتب|يزيل الغبار والفتات بسهولة|مثالي للمكتب والمنزل والسيارة|يعمل لمدة تصل إلى 120 دقيقة|شحن USB|صغير وسهل الحمل|تصميم أنيق|مناسب للطلاب والموظفين' | split: '|' -%}
      {%- for b in lp_benefits -%}
        <div class="bg-white border border-black/5 rounded-2xl p-6 shadow-[0_20px_60px_-20px_rgba(10,30,60,0.18)] hover:-translate-y-1 transition" data-lp-reveal>
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-lpsky text-2xl mb-3">✔</span>
          <p class="font-bold text-lpink leading-relaxed">{{ b }}</p>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ===== FEATURES ===== -->
  <section id="essalem-lp-features" class="py-20 bg-lpgray -mx-6 px-6">
    <div class="text-center max-w-2xl mx-auto mb-12" data-lp-reveal>
      <h2 class="text-3xl md:text-4xl font-extrabold text-lpink">مواصفات تستحق الثقة</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
      {%- assign lp_features_icons = '🔋|⏱️|🔌|⚡|💨|🧹|🎨|🪶' | split: '|' -%}
      {%- assign lp_features_text = 'بطارية 1200mAh|حتى 120 دقيقة استخدام|شحن USB|3 ساعات للشحن الكامل|قوة شفط ممتازة|فرشاة تنظيف مرفقة|تصميم صغير وأنيق|وزن خفيف' | split: '|' -%}
      {%- for icon in lp_features_icons -%}
        <div class="bg-white border border-black/5 rounded-2xl p-6 shadow-[0_20px_60px_-20px_rgba(10,30,60,0.18)] hover:-translate-y-1 transition" data-lp-reveal>
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-lpsky text-2xl mb-3">{{ icon }}</span>
          <p class="font-bold text-lpink leading-relaxed">{{ lp_features_text[forloop.index0] }}</p>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ===== GALLERY ===== -->
  <section class="py-20">
    <div class="text-center max-w-2xl mx-auto mb-10" data-lp-reveal>
      <h2 class="text-3xl md:text-4xl font-extrabold text-lpink">شاهدها عن قرب</h2>
    </div>
    <div class="relative">
      <div id="essalem-lp-gallery-track" class="flex gap-5 overflow-x-auto lp-scrollbar-none pb-4" style="scroll-snap-type:x mandatory;">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media limit: 8 -%}
            <div class="flex-none w-[78vw] max-w-[320px] aspect-[4/5] rounded-2xl overflow-hidden shadow-[0_20px_60px_-20px_rgba(10,30,60,0.18)]" style="scroll-snap-align:center;" data-lp-reveal>
              {{ media | image_url: width: 640 | image_tag: loading: 'lazy', alt: product.title, class: 'w-full h-full object-cover' }}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <div class="flex-none w-[78vw] max-w-[320px] aspect-[4/5] rounded-2xl overflow-hidden shadow-[0_20px_60px_-20px_rgba(10,30,60,0.18)] bg-lpgray flex items-center justify-center" style="scroll-snap-align:center;" data-lp-reveal>
              <svg viewBox="0 0 200 200" class="w-1/2 h-1/2 text-slate-300" fill="none"><rect x="30" y="30" width="140" height="140" rx="16" stroke="currentColor" stroke-width="8"/><circle cx="75" cy="80" r="14" stroke="currentColor" stroke-width="8"/><path d="M40 150 L90 110 L120 135 L160 95 L170 150 Z" stroke="currentColor" stroke-width="8" stroke-linejoin="round"/></svg>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="flex justify-center gap-4 mt-2">
        <button type="button" id="essalem-lp-gallery-prev" aria-label="السابق" class="w-11 h-11 rounded-full border border-black/10 bg-white shadow-[0_20px_60px_-20px_rgba(10,30,60,0.18)]">›</button>
        <button type="button" id="essalem-lp-gallery-next" aria-label="التالي" class="w-11 h-11 rounded-full border border-black/10 bg-white shadow-[0_20px_60px_-20px_rgba(10,30,60,0.18)]">‹</button>
      </div>
    </div>
  </section>

  <!-- ===== LIFESTYLE ===== -->
  <section class="py-20 bg-lpgray -mx-6 px-6">
    <div class="text-center max-w-2xl mx-auto mb-12" data-lp-reveal>
      <h2 class="text-3xl md:text-4xl font-extrabold text-lpink">تستخدم في كل مكان</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      {%- assign lp_lifestyle_icons = '💼|⌨️|🚗|📚|🏠' | split: '|' -%}
      {%- assign lp_lifestyle_labels = 'المكتب|لوحة المفاتيح|السيارة|غرفة الدراسة|المنزل' | split: '|' -%}
      {%- for icon in lp_lifestyle_icons -%}
        <div class="relative rounded-2xl overflow-hidden aspect-[3/4] bg-white shadow-[0_20px_60px_-20px_rgba(10,30,60,0.18)] flex items-center justify-center" data-lp-reveal>
          <span class="text-5xl">{{ icon }}</span>
          <span class="absolute bottom-0 inset-x-0 py-3 text-center font-bold text-white text-sm bg-gradient-to-t from-lpink/80 to-transparent">{{ lp_lifestyle_labels[forloop.index0] }}</span>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ===== TECHNICAL SPECIFICATIONS ===== -->
  <section class="py-20">
    <div class="text-center max-w-2xl mx-auto mb-12" data-lp-reveal>
      <h2 class="text-3xl md:text-4xl font-extrabold text-lpink">المواصفات الفنية</h2>
    </div>
    <div class="max-w-2xl mx-auto bg-lpgray rounded-3xl overflow-hidden" data-lp-reveal>
      {%- assign lp_spec_labels = 'البطارية|مدة التشغيل|الشحن|وقت الشحن|الوزن|الأبعاد|المادة' | split: '|' -%}
      {%- assign lp_spec_values = '1200mAh|120 دقيقة|USB|3 ساعات|135 جرام|88×88×70 مم|ABS' | split: '|' -%}
      {%- for label in lp_spec_labels -%}
        <div class="flex items-center justify-between gap-4 px-7 py-4 {% unless forloop.last %}border-b border-black/5{% endunless %}">
          <span class="font-bold text-slate-500">{{ label }}</span>
          <span class="font-bold text-lpink">{{ lp_spec_values[forloop.index0] }}</span>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ===== COMPARISON ===== -->
  <section class="py-20 bg-lpgray -mx-6 px-6">
    <div class="text-center max-w-2xl mx-auto mb-12" data-lp-reveal>
      <h2 class="text-3xl md:text-4xl font-extrabold text-lpink">لماذا نتفوق على الطرق التقليدية؟</h2>
    </div>
    <div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
      <div class="rounded-3xl p-8 bg-white border-2 border-lpblue shadow-[0_0_0_6px_rgba(10,132,255,0.08),0_30px_80px_-24px_rgba(10,30,60,0.28)]" data-lp-reveal>
        <h3 class="text-lg font-extrabold text-lpink mb-5">مكنستنا الذكية</h3>
        <ul class="flex flex-col gap-3">
          {%- assign lp_us = 'سريع|هادئ|قابل للشحن|صغير|تصميم فاخر' | split: '|' -%}
          {%- for p in lp_us -%}
            <li class="flex items-center gap-2 font-semibold text-lpink">✅ {{ p }}</li>
          {%- endfor -%}
        </ul>
      </div>
      <div class="rounded-3xl p-8 bg-lpsilver/40 border border-black/5" data-lp-reveal>
        <h3 class="text-lg font-extrabold text-lpink mb-5">التنظيف التقليدي</h3>
        <ul class="flex flex-col gap-3">
          {%- assign lp_them = 'متعب|بطيء|غير عملي' | split: '|' -%}
          {%- for p in lp_them -%}
            <li class="flex items-center gap-2 font-semibold text-lpink">❌ {{ p }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>

  <!-- ===== REVIEWS ===== -->
  <section class="py-20">
    <div class="text-center max-w-2xl mx-auto mb-10" data-lp-reveal>
      <h2 class="text-3xl md:text-4xl font-extrabold text-lpink mb-3">ماذا يقول عملاؤنا</h2>
      <p class="text-xl font-extrabold text-lpink">⭐⭐⭐⭐⭐ 4.9/5</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {%- assign lp_reviews = 'أفضل جهاز اشتريته لتنظيف المكتب.|صغير لكن قوة الشفط ممتازة.|مفيد جداً ويعمل لفترة طويلة.|أنصح به لكل شخص يعمل على مكتب.' | split: '|' -%}
      {%- for r in lp_reviews -%}
        <div class="bg-white rounded-2xl p-6 shadow-[0_20px_60px_-20px_rgba(10,30,60,0.18)]" data-lp-reveal>
          <div class="text-lpblue tracking-widest mb-3">★★★★★</div>
          <p class="text-lpink leading-relaxed">"{{ r }}"</p>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="py-20 bg-lpgray -mx-6 px-6">
    <div class="text-center max-w-2xl mx-auto mb-10" data-lp-reveal>
      <h2 class="text-3xl md:text-4xl font-extrabold text-lpink">أسئلة شائعة</h2>
    </div>
    <div class="max-w-2xl mx-auto flex flex-col gap-3" data-lp-reveal>
      {%- assign lp_faq_q = 'هل تعمل بدون سلك؟|كم تدوم البطارية؟|هل الشحن عبر USB؟|هل تصلح للسيارة؟' | split: '|' -%}
      {%- assign lp_faq_a = 'نعم، تعمل ببطارية قابلة للشحن.|حتى 120 دقيقة.|نعم.|نعم.' | split: '|' -%}
      {%- for q in lp_faq_q -%}
        <details class="bg-white rounded-2xl px-6">
          <summary class="flex items-center justify-between py-4 font-bold">
            <span>{{ q }}</span>
            <span class="lp-plus text-lpblue text-xl">+</span>
          </summary>
          <div class="pb-5 text-slate-600 leading-relaxed">{{ lp_faq_a[forloop.index0] }}</div>
        </details>
      {%- endfor -%}
    </div>
  </section>

  <!-- ===== اطلب الآن (EasySell COD Form) ===== -->
  <section id="essalem-lp-order" class="py-24 bg-gradient-to-b from-white to-lpsky -mx-6 px-6">
    <div class="text-center max-w-2xl mx-auto mb-10" data-lp-reveal>
      <span class="inline-block text-sm font-bold text-lpblue2 bg-white rounded-full px-4 py-1.5 mb-3">اطلبي الآن</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-lpink mb-3">اطلب الآن</h2>
      {%- if product -%}
        <p class="text-3xl font-extrabold text-lpblue2">{{ lp_variant.price | money }}</p>
      {%- endif -%}
      <div class="flex flex-wrap justify-center gap-x-5 gap-y-2 mt-4 text-sm font-semibold text-slate-600">
        <span>✅ الدفع عند الاستلام</span>
        <span>🚚 شحن سريع</span>
        <span>⭐ جودة عالية</span>
        <span>🔒 ضمان رضا العملاء</span>
      </div>
    </div>

    <div class="max-w-lg mx-auto lp-glass rounded-[28px] shadow-[0_30px_80px_-24px_rgba(10,30,60,0.28)] p-8 md:p-10" data-lp-reveal>
      {%- if product -%}
        {%- form 'product', product, id: 'essalem-lp-form', novalidate: true -%}
          <input type="hidden" name="id" value="{{ lp_variant.id }}">
          {% content_for 'blocks' %}
        {%- endform -%}
      {%- else -%}
        <p class="text-center text-sm font-semibold text-slate-500">أضيفي هذا القسم لصفحة منتج لتفعيل نموذج الطلب.</p>
      {%- endif -%}
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer class="py-14 border-t border-black/5">
    <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-8 text-center md:text-right">
      <div>
        <p class="font-extrabold text-lpink mb-2">🇲🇦 الدفع عند الاستلام</p>
        <p class="text-sm text-slate-500">ادفع نقداً عند استلام طلبك بكل أمان.</p>
      </div>
      <div>
        <p class="font-extrabold text-lpink mb-2">🚚 شحن سريع</p>
        <p class="text-sm text-slate-500">توصيل لجميع المدن خلال أيام قليلة.</p>
      </div>
      <div>
        <p class="font-extrabold text-lpink mb-2">↩ سياسة الاستبدال</p>
        <p class="text-sm text-slate-500">استبدال سهل خلال 7 أيام من الاستلام.</p>
      </div>
      <div>
        <p class="font-extrabold text-lpink mb-2">🔒 الخصوصية والشروط</p>
        <p class="text-sm text-slate-500">بياناتك محمية ومعاملتك آمنة معنا.</p>
      </div>
    </div>
    <p class="text-center text-xs text-slate-400 mt-10">© {{ 'now' | date: '%Y' }} جميع الحقوق محفوظة.</p>
  </footer>

</div>

<script>
  (function () {
    var root = document.getElementById('essalem-lp-root');
    if (!root) return;

    var reveals = root.querySelectorAll('[data-lp-reveal]');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
      reveals.forEach(function (el) { io.observe(el); });
    } else {
      reveals.forEach(function (el) { el.classList.add('is-visible'); });
    }

    root.querySelectorAll('[data-lp-scroll]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = root.querySelector(btn.getAttribute('data-lp-scroll'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    var track = root.querySelector('#essalem-lp-gallery-track');
    if (track) {
      var step = function () {
        var item = track.children[0];
        return item ? item.getBoundingClientRect().width + 20 : 300;
      };
      var prev = root.querySelector('#essalem-lp-gallery-prev');
      var next = root.querySelector('#essalem-lp-gallery-next');
      if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      if (next) next.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    }
  })();
</script>

</section>

{% schema %}
{
  "name": "Landing Page",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Landing Page" }]
}
{% endschema %}
