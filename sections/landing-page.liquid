<script>
  (function () {
    var root = document.getElementById('essalem-lp-root');
    if (!root) return;

    /* Scroll reveal */
    var reveals = root.querySelectorAll('[data-lp-reveal], [data-lp-reveal-scale]');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
      reveals.forEach(function (el) { io.observe(el); });
    } else {
      reveals.forEach(function (el) { el.classList.add('is-visible'); });
    }

    /* Smooth scroll buttons */
    document.querySelectorAll('[data-lp-scroll]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = document.querySelector(btn.getAttribute('data-lp-scroll'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    /* Gallery nav */
    var track = root.querySelector('#essalem-lp-gallery-track');
    if (track) {
      var step = function () {
        var item = track.children[0];
        return item ? item.getBoundingClientRect().width + 20 : 300;
      };
      var prev = root.querySelector('#essalem-lp-gallery-prev');
      var next = root.querySelector('#essalem-lp-gallery-next');
      if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      if (next) next.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    }

    /* Lightbox */
    var lightbox = document.getElementById('essalem-lp-lightbox');
    var lightboxImg = document.getElementById('essalem-lp-lightbox-img');
    root.querySelectorAll('[data-lp-lightbox-item] img').forEach(function (img) {
      img.addEventListener('click', function () {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.src = img.currentSrc || img.src;
        lightbox.classList.add('open');
      });
    });
    if (lightbox) {
      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) lightbox.classList.remove('open');
      });
    }

    /* Countdown (persists per browser for 6 hours) */
    var cdKey = 'essalemLpDeadline';
    var deadline = parseInt(localStorage.getItem(cdKey), 10);
    if (!deadline || deadline < Date.now()) {
      deadline = Date.now() + 6 * 60 * 60 * 1000;
      localStorage.setItem(cdKey, deadline);
    }
    var cdH = document.getElementById('essalem-lp-cd-h');
    var cdM = document.getElementById('essalem-lp-cd-m');
    var cdS = document.getElementById('essalem-lp-cd-s');
    function pad(n) { return String(n).padStart(2, '0'); }
    function tickCountdown() {
      var diff = Math.max(0, deadline - Date.now());
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      if (cdH) cdH.textContent = pad(h);
      if (cdM) cdM.textContent = pad(m);
      if (cdS) cdS.textContent = pad(s);
    }
    tickCountdown();
    setInterval(tickCountdown, 1000);

    /* Sticky bar visibility */
    var sticky = document.getElementById('essalem-lp-sticky');
    var order = document.getElementById('essalem-lp-order');
    if (sticky && order) {
      window.addEventListener('scroll', function () {
        var r = order.getBoundingClientRect();
        sticky.style.display = (r.top > window.innerHeight || r.bottom < 0) ? 'flex' : 'none';
      }, { passive: true });
    }

    /* Live visitors fluctuation */
    var visitorsEl = document.getElementById('essalem-lp-visitors-count');
    if (visitorsEl) {
      setInterval(function () {
        var c = parseInt(visitorsEl.textContent, 10) || 27;
        var next = Math.max(14, Math.min(52, c + (Math.random() > 0.5 ? 1 : -1)));
        visitorsEl.textContent = next;
      }, 4500);
    }

    /* Recent orders toast */
    var toastNames = ['أحمد من الرياض', 'سارة من جدة', 'خالد من الدمام', 'نورة من مكة المكرمة', 'فيصل من المدينة المنورة', 'ريم من أبها', 'عبدالله من الرياض', 'هند من جدة'];
    var toastEl = document.getElementById('essalem-lp-toast');
    var toastText = document.getElementById('essalem-lp-toast-text');
    var toastIndex = 0;
    function showToast() {
      if (!toastEl || !toastText) return;
      var mins = 1 + Math.floor(Math.random() * 14);
      toastText.innerHTML = '<strong>' + toastNames[toastIndex % toastNames.length] + '</strong><br>اشترى هذا المنتج منذ ' + mins + ' دقيقة';
      toastIndex++;
      toastEl.classList.add('show');
      setTimeout(function () { toastEl.classList.remove('show'); }, 4500);
      setTimeout(showToast, 11000 + Math.random() * 6000);
    }
    setTimeout(showToast, 4000);

    /* Exit intent popup */
    var exitOverlay = document.getElementById('essalem-lp-exit');
    var exitShown = false;
    function openExit() {
      if (exitShown || !exitOverlay) return;
      exitShown = true;
      exitOverlay.classList.add('open');
    }
    document.addEventListener('mouseleave', function (e) {
      if (e.clientY < 10) openExit();
    });
    var lastScroll = 0;
    window.addEventListener('scroll', function () {
      var cur = window.scrollY;
      if (cur < 40 && lastScroll > 400) openExit();
      lastScroll = cur;
    }, { passive: true });
    var exitClose = document.getElementById('essalem-lp-exit-close');
    if (exitClose) exitClose.addEventListener('click', function () { exitOverlay.classList.remove('open'); });
    var exitCta = document.getElementById('essalem-lp-exit-cta');
    if (exitCta) exitCta.addEventListener('click', function () {
      exitOverlay.classList.remove('open');
      var target = document.getElementById('essalem-lp-order');
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>

</section>

