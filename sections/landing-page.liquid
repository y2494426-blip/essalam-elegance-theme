{%- comment -%} مصباح إسقاط أمواج الماء LED — single-file premium Arabic RTL landing page section. EasySell COD app block, no native Shopify buy form. {%- endcomment -%}
<section id="essalem-lp-root" dir="rtl" lang="ar">

<script src="https://cdn.tailwindcss.com"></script>
<script>
  window.tailwind = window.tailwind || {};
  tailwind.config = {
    corePlugins: { preflight: false },
    theme: {
      extend: {
        fontFamily: { tajawal: ['Tajawal', 'Arial', 'sans-serif'] },
        colors: {
          lxblack: '#0e0d0b',
          lxblack2: '#171512',
          lxgold: '#c9a227',
          lxgoldlight: '#e8c766',
          lxwarm: '#fdf8ef',
          lxbeige: '#f3ecd9'
        },
        keyframes: {
          lpfloat: { '0%,100%': { transform: 'translateY(0)' }, '50%': { transform: 'translateY(-16px)' } },
          lpglow: { '0%,100%': { boxShadow: '0 0 0 rgba(201,162,39,0.0)' }, '50%': { boxShadow: '0 0 40px rgba(201,162,39,0.35)' } },
          lpmarquee: { '0%': { transform: 'translateX(0)' }, '100%': { transform: 'translateX(-50%)' } }
        },
        animation: {
          lpfloat: 'lpfloat 5s ease-in-out infinite',
          lpglow: 'lpglow 2.4s ease-in-out infinite',
          lpmarquee: 'lpmarquee 22s linear infinite'
        }
      }
    }
  };
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">

<style>
  #essalem-lp-root{ font-family:'Tajawal',Arial,sans-serif; background:#fdf8ef; color:#171512; overflow-x:hidden; direction:rtl; -webkit-font-smoothing:antialiased; }
  #essalem-lp-root *{ box-sizing:border-box; }
  #essalem-lp-root img{ max-width:100%; display:block; }
  #essalem-lp-root [data-lp-reveal]{ opacity:0; transform:translateY(26px); transition:opacity .7s ease, transform .7s ease; }
  #essalem-lp-root [data-lp-reveal].is-visible{ opacity:1; transform:translateY(0); }
  #essalem-lp-root [data-lp-reveal-scale]{ opacity:0; transform:scale(.92); transition:opacity .6s ease, transform .6s ease; }
  #essalem-lp-root [data-lp-reveal-scale].is-visible{ opacity:1; transform:scale(1); }
  #essalem-lp-root .lp-scrollbar-none::-webkit-scrollbar{ display:none; }
  #essalem-lp-root .lp-scrollbar-none{ -ms-overflow-style:none; scrollbar-width:none; }
  #essalem-lp-root details summary{ cursor:pointer; list-style:none; }
  #essalem-lp-root details summary::-webkit-details-marker{ display:none; }
  #essalem-lp-root details summary .lp-plus{ transition:transform .25s ease; }
  #essalem-lp-root details[open] summary .lp-plus{ transform:rotate(45deg); }
  #essalem-lp-root .lp-glass{ background:rgba(255,255,255,.06); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); border:1px solid rgba(201,162,39,.25); }
  #essalem-lp-root .lp-glass-light{ background:rgba(255,255,255,.7); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); border:1px solid rgba(14,13,11,.08); }
  #essalem-lp-root .lp-marquee-track{ display:flex; width:max-content; animation:lpmarquee 22s linear infinite; }
  #essalem-lp-root .lp-blob{ position:absolute; border-radius:9999px; filter:blur(70px); opacity:.35; pointer-events:none; }
  @media (max-width:767px){ #essalem-lp-root{ padding-bottom:82px; } }
  @media (min-width:768px){ #essalem-lp-sticky{ display:none; } }
  #essalem-lp-lightbox{ position:fixed; inset:0; background:rgba(10,9,7,.94); z-index:99998; display:flex; align-items:center; justify-content:center; padding:24px; opacity:0; pointer-events:none; transition:opacity .3s ease; }
  #essalem-lp-lightbox.open{ opacity:1; pointer-events:all; }
  #essalem-lp-lightbox img{ max-width:100%; max-height:88vh; border-radius:18px; transform:scale(.94); transition:transform .3s ease; }
  #essalem-lp-lightbox.open img{ transform:scale(1); }
  #essalem-lp-exit{ position:fixed; inset:0; background:rgba(10,9,7,.6); z-index:99990; opacity:0; pointer-events:none; transition:opacity .3s ease; display:flex; align-items:center; justify-content:center; padding:20px; }
  #essalem-lp-exit.open{ opacity:1; pointer-events:all; }
  #essalem-lp-exit .lp-exit-card{ transform:scale(.9) translateY(16px); transition:transform .3s ease; }
  #essalem-lp-exit.open .lp-exit-card{ transform:scale(1) translateY(0); }
  #essalem-lp-toast{ position:fixed; bottom:96px; right:16px; z-index:8500; transform:translateX(140%); transition:transform .45s cubic-bezier(.34,1.56,.64,1); max-width:280px; }
  #essalem-lp-toast.show{ transform:translateX(0); }
  @media (prefers-reduced-motion: reduce){
    #essalem-lp-root [data-lp-reveal], #essalem-lp-root [data-lp-reveal-scale]{ opacity:1; transform:none; transition:none; }
    #essalem-lp-root .animate-lpfloat, #essalem-lp-root .animate-lpglow, #essalem-lp-root .lp-marquee-track{ animation:none; }
  }
</style>

{%- if product -%}
  {%- assign lp_variant = product.selected_or_first_available_variant -%}
  {%- assign lp_media = lp_variant.featured_media | default: product.featured_media -%}
  {%- assign lp_price = lp_variant.price | money_without_currency -%}
  {%- assign lp_compare = lp_variant.compare_at_price | money_without_currency -%}
{%- endif -%}

{%- if product -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "image": [{{ lp_media | image_url: width: 1200 | prepend: "https:" | json }}],
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "sku": {{ lp_variant.sku | json }},
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ lp_variant.price | money_without_currency | json }},
    "availability": "{% if lp_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
  }
}
</script>
{%- endif -%}

<!-- ===== URGENCY MARQUEE BAR ===== -->
<div class="bg-lxblack text-lxgoldlight py-2 overflow-hidden whitespace-nowrap">
  <div class="lp-marquee-track text-sm font-bold">
    {%- for i in (1..2) -%}
      <span class="px-6">🚚 شحن مجاني لجميع مدن السعودية</span>
      <span class="px-6">💳 الدفع عند الاستلام</span>
      <span class="px-6">⚡ عرض خاص لفترة محدودة — خصم 33%</span>
      <span class="px-6">🎁 هدية مثالية لمن تحب</span>
    {%- endfor -%}
  </div>
</div>

<div class="max-w-[1240px] mx-auto px-5">

  <!-- ===== HERO ===== -->
  <section class="relative -mx-5 px-5 pt-10 pb-16 md:pt-14 md:pb-20 bg-lxblack overflow-hidden">
    <span class="lp-blob w-96 h-96 -top-24 -right-24 bg-lxgold"></span>
    <span class="lp-blob w-72 h-72 -bottom-16 -left-16 bg-lxgoldlight"></span>

    <div class="relative z-10 grid md:grid-cols-2 gap-10 items-center">
      <div data-lp-reveal>
        <span class="inline-block bg-lxgoldlight text-lxblack font-extrabold text-xs px-4 py-2 rounded-full mb-4">✨ جديد</span>
        <h1 class="text-3xl md:text-5xl font-extrabold leading-tight mb-4 text-lxwarm">✨ حوّل أي غرفة إلى عالم من الهدوء والجمال</h1>
        <p class="text-base md:text-lg text-lxwarm/70 leading-relaxed mb-6 max-w-xl">استمتع بإضاءة ساحرة بتأثير أمواج الماء تمنح منزلك أجواء رومانسية ومريحة في ثوانٍ.</p>

        <div class="lp-glass rounded-3xl p-5 inline-flex flex-wrap items-center gap-4 mb-6">
          <div>
            <span class="block text-lxwarm/50 line-through text-lg">299 ريال</span>
            <span class="block text-4xl font-extrabold text-lxgoldlight">199 <span class="text-lg font-semibold">ريال</span></span>
          </div>
          <span class="bg-red-600/90 text-white text-sm font-extrabold px-4 py-2 rounded-full">خصم 33%</span>
        </div>

        <div class="flex flex-wrap gap-4">
          <button type="button" data-lp-scroll="#essalem-lp-order" class="animate-lpglow inline-flex items-center justify-center gap-2 font-extrabold text-lxblack text-base px-9 py-4 rounded-full bg-gradient-to-l from-lxgoldlight to-lxgold hover:-translate-y-1 transition">اطلب الآن</button>
          <span class="inline-flex items-center gap-2 font-bold text-lxwarm text-sm px-6 py-4 rounded-full lp-glass">🚚 شحن مجاني</span>
        </div>

        <div class="flex flex-wrap gap-4 mt-6 text-xs font-semibold text-lxwarm/60">
          <span>💳 الدفع عند الاستلام</span>
          <span>⭐ آلاف العملاء السعداء</span>
        </div>
      </div>

      <div class="flex items-center justify-center" data-lp-reveal-scale>
        <div class="relative w-full max-w-[440px] aspect-square rounded-[32px] lp-glass shadow-[0_30px_90px_-20px_rgba(0,0,0,0.6)] flex items-center justify-center p-8 animate-lpfloat">
          {%- if lp_media -%}
            {{ lp_media | image_url: width: 900 | image_tag: loading: 'eager', alt: product.title, class: 'w-full h-full object-contain', id: 'essalem-lp-hero-img' }}
          {%- else -%}
            <svg viewBox="0 0 200 200" class="w-2/3 h-2/3 text-lxgold/40" fill="none"><path d="M100 20 C130 60 150 90 150 120 A50 50 0 1 1 50 120 C50 90 70 60 100 20 Z" stroke="currentColor" stroke-width="8"/></svg>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TRUST BADGES ===== -->
  <section class="py-8 -mx-5 px-5 bg-lxbeige">
    <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm font-bold text-lxblack/80">
      <span>✅ الدفع عند الاستلام</span>
      <span>🚚 شحن سريع لجميع مدن السعودية</span>
      <span>🛡 ضمان الجودة</span>
      <span>⭐ آلاف العملاء السعداء</span>
      <span>↩ ضمان الاسترجاع</span>
    </div>
  </section>

  <!-- ===== PROBLEM ===== -->
  <section class="py-16 md:py-20">
    <div class="text-center max-w-2xl mx-auto mb-10" data-lp-reveal>
      <h2 class="text-2xl md:text-4xl font-extrabold text-lxblack">هل تشعر أن غرفتك مملة؟</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {%- assign lp_problems = 'إضاءة عادية|أجواء بدون جمال|لا يوجد استرخاء|ديكور غير مميز' | split: '|' -%}
      {%- for p in lp_problems -%}
        <div class="bg-white border border-black/5 rounded-2xl p-5 text-center shadow-[0_16px_40px_-20px_rgba(14,13,11,0.25)]" data-lp-reveal>
          <span class="text-2xl text-red-500">❌</span>
          <p class="font-bold text-lxblack mt-2 text-sm">{{ p }}</p>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ===== SOLUTION ===== -->
  <section class="py-16 md:py-20 -mx-5 px-5 bg-lxblack">
    <div class="grid md:grid-cols-2 gap-10 items-center">
      <div class="order-2 md:order-1" data-lp-reveal>
        <span class="inline-block text-sm font-bold text-lxgoldlight bg-white/10 rounded-full px-4 py-1.5 mb-4">✨ الحل الأمثل</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-lxwarm mb-4 leading-relaxed">مصباح إسقاط أمواج الماء يحول أي غرفة إلى مكان فاخر ومريح بإضاءة LED مذهلة وتأثيرات أمواج واقعية.</h2>
        <p class="text-lxwarm/60 leading-relaxed">صمم خصيصاً ليمنحك تجربة استرخاء بصرية، بضغطة زر واحدة تتحول غرفتك لجو رومانسي هادئ يليق بأجمل اللحظات.</p>
      </div>
      <div class="order-1 md:order-2 flex justify-center" data-lp-reveal-scale>
        <div class="w-full max-w-[380px] aspect-[4/5] rounded-[28px] overflow-hidden lp-glass shadow-[0_30px_90px_-20px_rgba(0,0,0,0.6)]">
          {%- if product.media[1] -%}
            {{ product.media[1] | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title, class: 'w-full h-full object-cover' }}
          {%- elsif lp_media -%}
            {{ lp_media | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title, class: 'w-full h-full object-cover' }}
          {%- else -%}
            <div class="w-full h-full flex items-center justify-center text-lxgold/40">
              <svg viewBox="0 0 200 200" class="w-1/2 h-1/2" fill="none"><path d="M100 20 C130 60 150 90 150 120 A50 50 0 1 1 50 120 C50 90 70 60 100 20 Z" stroke="currentColor" stroke-width="8"/></svg>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FEATURES ===== -->
  <section id="essalem-lp-features" class="py-16 md:py-20">
    <div class="text-center max-w-2xl mx-auto mb-12" data-lp-reveal>
      <span class="inline-block text-sm font-bold text-lxgold bg-lxbeige rounded-full px-4 py-1.5 mb-3">المميزات</span>
      <h2 class="text-2xl md:text-4xl font-extrabold text-lxblack">تصميم مدروس لكل التفاصيل</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {%- assign lp_feat_icons = '🌊|🎨|📡|👆|⏱|💡|🛏|💼|🎁|🧱|🔍' | split: '|' -%}
      {%- assign lp_feat_text = 'إسقاط أمواج ماء واقعي|16 لون مختلف|جهاز تحكم عن بعد|تحكم باللمس|مؤقت تشغيل|إضاءة LED ناعمة|مناسب لغرفة النوم|مناسب للمكتب|هدية مثالية|خامة ABS عالية الجودة|غطاء أكريليك فاخر' | split: '|' -%}
      {%- for icon in lp_feat_icons -%}
        <div class="bg-white border border-black/5 rounded-2xl p-5 text-center shadow-[0_16px_40px_-20px_rgba(14,13,11,0.2)] hover:-translate-y-1 transition" data-lp-reveal>
          <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-lxbeige text-xl mb-2">{{ icon }}</span>
          <p class="font-bold text-lxblack text-sm leading-relaxed">{{ lp_feat_text[forloop.index0] }}</p>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ===== BENEFITS ===== -->
  <section class="py-16 md:py-20 -mx-5 px-5 bg-lxbeige">
    <div class="text-center max-w-2xl mx-auto mb-12" data-lp-reveal>
      <h2 class="text-2xl md:text-4xl font-extrabold text-lxblack">لماذا سيصبح المفضل لديك؟</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {%- assign lp_benefits = 'يساعد على الاسترخاء|ديكور فاخر|مثالي للتصوير|مناسب للأطفال والكبار|يخلق أجواء رومانسية|يوفر إضاءة هادئة' | split: '|' -%}
      {%- for b in lp_benefits -%}
        <div class="bg-white rounded-2xl p-5 shadow-[0_16px_40px_-20px_rgba(14,13,11,0.2)]" data-lp-reveal>
          <span class="text-lxgold text-xl">✔</span>
          <p class="font-bold text-lxblack text-sm mt-2">{{ b }}</p>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ===== GALLERY ===== -->
  <section class="py-16 md:py-20">
    <div class="text-center max-w-2xl mx-auto mb-10" data-lp-reveal>
      <h2 class="text-2xl md:text-4xl font-extrabold text-lxblack">شاهد جمال الإضاءة عن قرب</h2>
    </div>
    <div class="relative">
      <div id="essalem-lp-gallery-track" class="flex gap-5 overflow-x-auto lp-scrollbar-none pb-4" style="scroll-snap-type:x mandatory;">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media limit: 10 -%}
            <div class="flex-none w-[78vw] max-w-[320px] aspect-[4/5] rounded-2xl overflow-hidden shadow-[0_20px_60px_-20px_rgba(14,13,11,0.25)] cursor-zoom-in" style="scroll-snap-align:center;" data-lp-reveal data-lp-lightbox-item>
              {{ media | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title, class: 'w-full h-full object-cover hover:scale-105 transition duration-500' }}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="flex-none w-[78vw] max-w-[320px] aspect-[4/5] rounded-2xl overflow-hidden shadow-[0_20px_60px_-20px_rgba(14,13,11,0.25)] bg-lxbeige flex items-center justify-center" style="scroll-snap-align:center;" data-lp-reveal>
              <svg viewBox="0 0 200 200" class="w-1/2 h-1/2 text-lxgold/40" fill="none"><path d="M100 20 C130 60 150 90 150 120 A50 50 0 1 1 50 120 C50 90 70 60 100 20 Z" stroke="currentColor" stroke-width="8"/></svg>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="flex justify-center gap-4 mt-2">
        <button type="button" id="essalem-lp-gallery-prev" aria-label="السابق" class="w-11 h-11 rounded-full border border-black/10 bg-white shadow-[0_16px_40px_-20px_rgba(14,13,11,0.25)]">›</button>
        <button type="button" id="essalem-lp-gallery-next" aria-label="التالي" class="w-11 h-11 rounded-full border border-black/10 bg-white shadow-[0_16px_40px_-20px_rgba(14,13,11,0.25)]">‹</button>
      </div>
    </div>
  </section>

  <!-- ===== REMOTE CONTROL ===== -->
  <section class="py-16 md:py-20 -mx-5 px-5 bg-lxblack">
    <div class="grid md:grid-cols-2 gap-10 items-center">
      <div class="flex justify-center" data-lp-reveal-scale>
        <div class="lp-glass rounded-[28px] p-10 w-full max-w-[300px] aspect-[3/5] flex items-center justify-center">
          <svg viewBox="0 0 100 180" class="w-2/3 text-lxgoldlight" fill="none">
            <rect x="10" y="5" width="80" height="170" rx="20" stroke="currentColor" stroke-width="4"/>
            <circle cx="50" cy="35" r="14" stroke="currentColor" stroke-width="4"/>
            <circle cx="30" cy="70" r="7" stroke="currentColor" stroke-width="4"/>
            <circle cx="50" cy="70" r="7" stroke="currentColor" stroke-width="4"/>
            <circle cx="70" cy="70" r="7" stroke="currentColor" stroke-width="4"/>
            <circle cx="30" cy="95" r="7" stroke="currentColor" stroke-width="4"/>
            <circle cx="50" cy="95" r="7" stroke="currentColor" stroke-width="4"/>
            <circle cx="70" cy="95" r="7" stroke="currentColor" stroke-width="4"/>
            <rect x="25" y="120" width="50" height="14" rx="7" stroke="currentColor" stroke-width="4"/>
            <rect x="25" y="145" width="50" height="14" rx="7" stroke="currentColor" stroke-width="4"/>
          </svg>
        </div>
      </div>
      <div data-lp-reveal>
        <span class="inline-block text-sm font-bold text-lxgoldlight bg-white/10 rounded-full px-4 py-1.5 mb-4">جهاز تحكم عن بعد</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-lxwarm mb-6">تحكم كامل بضغطة زر</h2>
        <div class="grid grid-cols-2 gap-4">
          {%- assign lp_remote = '16 لون|عدة أوضاع|التحكم في السطوع|مؤقت|سهولة الاستخدام' | split: '|' -%}
          {%- for r in lp_remote -%}
            <div class="flex items-center gap-2 text-lxwarm/80 font-semibold text-sm">
              <span class="text-lxgoldlight">●</span> {{ r }}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHY US ===== -->
  <section class="py-16 md:py-20">
    <div class="text-center max-w-2xl mx-auto mb-12" data-lp-reveal>
      <h2 class="text-2xl md:text-4xl font-extrabold text-lxblack">لماذا تختارنا؟</h2>
    </div>
    <div class="max-w-2xl mx-auto bg-white rounded-3xl overflow-hidden shadow-[0_20px_60px_-24px_rgba(14,13,11,0.25)]" data-lp-reveal>
      <div class="grid grid-cols-3 bg-lxblack text-lxwarm font-bold text-center py-4 text-xs md:text-base">
        <div></div>
        <div>متاجر أخرى ❌</div>
        <div class="text-lxgoldlight">متجرنا ✅</div>
      </div>
      {%- assign lp_compare_rows = 'منتج أصلي|شحن سريع|ضمان|دعم فني|جودة عالية' | split: '|' -%}
      {%- for row in lp_compare_rows -%}
        <div class="grid grid-cols-3 items-center text-center py-4 px-4 {% unless forloop.last %}border-b border-black/5{% endunless %}">
          <div class="text-xs md:text-sm font-bold text-lxblack text-right">{{ row }}</div>
          <div class="text-red-500 text-xl">❌</div>
          <div class="text-lxgold text-xl">✅</div>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ===== REVIEWS ===== -->
  <section class="py-16 md:py-20 -mx-5 px-5 bg-lxbeige">
    <div class="text-center max-w-2xl mx-auto mb-12" data-lp-reveal>
      <h2 class="text-2xl md:text-4xl font-extrabold text-lxblack mb-2">آراء عملائنا</h2>
